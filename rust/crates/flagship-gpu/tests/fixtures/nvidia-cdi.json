{
  "cdiVersion": "0.5.0",
  "kind": "nvidia.com/gpu",
  "devices": [
    {
      "name": "0",
      "containerEdits": {
        "deviceNodes": [{"path": "/dev/nvidia0"}, {"path": "/dev/dri/renderD128"}],
        "hooks": [
          {"hookName": "createContainer", "path": "/usr/bin/nvidia-cdi-hook",
           "args": ["nvidia-cdi-hook", "create-symlinks", "--link", "../renderD128::/dev/dri/by-path/pci-0000:01:00.0-render"]}
        ]
      }
    },
    {
      "name": "1",
      "containerEdits": {
        "deviceNodes": [{"path": "/dev/nvidia1"}, {"path": "/dev/dri/renderD129"}]
      }
    }
  ],
  "containerEdits": {
    "env": ["NVIDIA_VISIBLE_DEVICES=void"],
    "deviceNodes": [{"path": "/dev/nvidiactl"}, {"path": "/dev/nvidia-uvm"}],
    "hooks": [
      {"hookName": "createContainer", "path": "/usr/bin/nvidia-cdi-hook",
       "args": ["nvidia-cdi-hook", "update-ldcache", "--folder", "/usr/lib/x86_64-linux-gnu"]}
    ],
    "mounts": [
      {"hostPath": "/usr/lib/x86_64-linux-gnu/libcuda.so.580.95.05",
       "containerPath": "/usr/lib/x86_64-linux-gnu/libcuda.so.580.95.05",
       "options": ["ro", "nosuid", "nodev", "bind"]},
      {"hostPath": "/usr/bin/nvidia-smi", "containerPath": "/usr/bin/nvidia-smi",
       "options": ["ro", "nosuid", "nodev", "bind"]}
    ]
  }
}
