{
  "name": "flagship",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Flagship — personal-cloud ecosystem (phone app + flagshipserver.com + bootable server image)",
  "license": "BUSL-1.1",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/web/e2e",
    "apps/com",
    "apps/boot",
    "apps/dns-broker",
    "tools/gym"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "daemon": "npm --workspace=@flagship/server-daemon run start",
    "build-image": "npm --workspace=@flagship/bootkey-builder run start --",
    "web": "npm --workspace=@flagship/web run dev",
    "predeploy:check": "bash scripts/predeploy-com.sh",
    "gym": "npm --workspace=@flagship/gym run gym --",
    "gym:every-merge": "npm --workspace=@flagship/gym run gym -- every-merge",
    "gym:total": "npm --workspace=@flagship/gym run gym -- total",
    "gym:live": "npm --workspace=@flagship/gym run gym -- live",
    "live-e2e": "tsx tools/live-e2e/run.ts",
    "live-e2e:web": "playwright test --config apps/web/e2e/live/playwright.live.config.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/tar-stream": "^3.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
