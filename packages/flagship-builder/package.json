{
  "name": "@flagship/builder",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "flagship-build": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/flagship-build.mjs --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "bundle:engine": "esbuild src/preseedEngine.ts --bundle --platform=neutral --format=iife --target=es2017 --outfile=dist/preseed-engine.raw.js --legal-comments=none && babel dist/preseed-engine.raw.js --config-file ./engine.babel.json -o engine/preseed-engine.js",
    "test": "vitest run --dir tests"
  },
  "dependencies": {
    "@flagship/protocol": "*",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.0",
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.0"
  },
  "license": "BUSL-1.1"
}
