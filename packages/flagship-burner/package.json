{
  "name": "@flagship/burner",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "flagship-burn": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/flagship-burn.mjs --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "bundle:engine": "esbuild src/preseedEngine.ts --bundle --platform=neutral --format=iife --target=es2017 --outfile=engine/preseed-engine.js --legal-comments=none",
    "test": "vitest run --dir tests"
  },
  "dependencies": {
    "@flagship/protocol": "*",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.0"
  },
  "license": "BUSL-1.1"
}
