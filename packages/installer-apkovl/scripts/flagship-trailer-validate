#!/usr/bin/env node
// Read the trailer from <device>, validate the Ed25519 signature against
// the embedded user pubkey, and print the install-blob JSON to stdout.
// Exits 0 on valid; 1 on missing/malformed/invalid-signature.
//
// Self-contained on purpose: it runs before anything is fetched from the
// network, so it uses only Node built-ins (node:crypto has Ed25519) and
// re-implements the InstallBlob v2 canonical bytes. The canonical MUST
// byte-match canonicalInstallBlob in packages/protocol/src/installBlob.ts,
// optional appends included; tests/trailerValidateScript.test.ts runs this
// script against blobs signed by the protocol package. Built-ins are loaded
// with dynamic import() so the file runs both as installed on the box (no
// package.json, CommonJS) and from this package ("type": "module").

const TAG = "flagship/install-blob/v1";
const SIG_LEN = 64;
const HEX32 = /^[0-9a-fA-F]{64}$/;

function fail(msg) {
  console.error(msg);
  process.exit(1);
}

// Mirrors legacyFieldGuard: a '|' or control byte in a free-text field would
// make the joined canonical ambiguous.
function field(name, v) {
  if (typeof v !== "string") fail(`install-blob field ${name} is not a string`);
  if (/[|\u0000-\u001f]/.test(v)) fail(`install-blob field ${name} contains a separator`);
  return v;
}

function hexField(name, v) {
  if (typeof v !== "string" || !/^([0-9a-fA-F]{2})*$/.test(v)) {
    fail(`install-blob field ${name} is not hex`);
  }
  return v.toLowerCase();
}

function canonicalInstallBlob(blob) {
  if (!blob || typeof blob !== "object") fail("install-blob is not an object");
  if (blob.version !== 2) fail("unsupported InstallBlob version");
  const ac = blob.authCode;
  if (!ac || typeof ac !== "object") fail("install-blob has no authCode");
  if (ac.adminRootPubKey !== undefined && !HEX32.test(String(ac.adminRootPubKey))) {
    fail("authCode.adminRootPubKey is not 32-byte hex");
  }
  const parts = [
    TAG,
    blob.version,
    field("serverDomain", blob.serverDomain),
    field("username", blob.username),
    field("serverName", blob.serverName),
    hexField("phoneDelegatedPubKey", blob.phoneDelegatedPubKey),
    field("registrationUrl", blob.registrationUrl),
    field("authCode.serial", ac.serial),
    hexField("authCode.userPubKey", ac.userPubKey),
    hexField("authCodeUserSignature", blob.authCodeUserSignature),
    field("installerGitRef", blob.installerGitRef ?? ""),
    hexField("rckPubKey", blob.rckPubKey),
  ];
  if (blob.bootUnlockMode !== undefined) {
    if (blob.bootUnlockMode !== "auto" && blob.bootUnlockMode !== "approve") {
      fail("unsupported bootUnlockMode");
    }
    parts.push(blob.bootUnlockMode);
  }
  if (blob.diskEncryption !== undefined) {
    if (blob.diskEncryption !== "luks" && blob.diskEncryption !== "none") {
      fail("unsupported diskEncryption");
    }
    parts.push(`de=${blob.diskEncryption}`);
  }
  return Buffer.from(parts.join("|"), "utf8");
}

async function main() {
  const { open } = await import("node:fs/promises");
  const { createPublicKey, verify } = await import("node:crypto");
  const HEADER_MAGIC = Buffer.from("FLAGSHIP-BOOT\0\0\0", "binary");
  const FOOTER_MAGIC = Buffer.concat([
    Buffer.from([0, 0, 0]),
    Buffer.from("FLAGSHIP-END", "utf8"),
    Buffer.from([0]),
  ]);
  const SPKI_ED25519_PREFIX = Buffer.from("302a300506032b6570032100", "hex");

  const path = process.argv[2];
  if (!path) {
    console.error("usage: flagship-trailer-validate <device>");
    process.exit(2);
  }
  const fh = await open(path, "r");
  try {
    const stat = await fh.stat();
    let size = stat.size;
    if (!size) {
      const { execFileSync } = await import("node:child_process");
      size = parseInt(execFileSync("blockdev", ["--getsize64", path]).toString().trim(), 10);
    }
    const totalBuf = Buffer.alloc(4);
    await fh.read(totalBuf, 0, 4, size - 4);
    const total = totalBuf.readUInt32LE(0);
    if (total < 100 || total > 65536 || total > size) fail("trailer footer length out of range");
    const buf = Buffer.alloc(total);
    await fh.read(buf, 0, total, size - total);

    if (Buffer.compare(buf.subarray(0, HEADER_MAGIC.length), HEADER_MAGIC) !== 0) {
      fail("magic header missing");
    }
    let off = HEADER_MAGIC.length;
    if (buf[off] !== 0x01) fail("unsupported trailer version");
    off += 1;
    const jsonLen = buf.readUInt32LE(off);
    off += 4;
    if (jsonLen > total - (HEADER_MAGIC.length + 1 + 4 + SIG_LEN + FOOTER_MAGIC.length + 4)) {
      fail("trailer JSON length out of range");
    }
    const jsonBytes = buf.subarray(off, off + jsonLen);
    off += jsonLen;
    const sig = buf.subarray(off, off + SIG_LEN);
    off += SIG_LEN;
    if (Buffer.compare(buf.subarray(off, off + FOOTER_MAGIC.length), FOOTER_MAGIC) !== 0) {
      fail("magic footer missing");
    }

    let blob;
    try {
      blob = JSON.parse(jsonBytes.toString("utf8"));
    } catch {
      fail("invalid JSON payload");
    }

    const canonical = canonicalInstallBlob(blob);
    const userPubHex = hexField("authCode.userPubKey", blob.authCode.userPubKey);
    if (userPubHex.length !== 64) fail("authCode.userPubKey is not 32 bytes");
    const key = createPublicKey({
      key: Buffer.concat([SPKI_ED25519_PREFIX, Buffer.from(userPubHex, "hex")]),
      format: "der",
      type: "spki",
    });
    if (!verify(null, canonical, key, sig)) {
      fail("install-blob signature does not verify under embedded userPubKey");
    }

    // Print the JSON exactly as parsed: install-helper forwards authCode
    // (adminRootPubKey included) to .com registration from this file.
    process.stdout.write(JSON.stringify(blob));
    process.exit(0);
  } finally {
    await fh.close();
  }
}

main().catch((e) => {
  console.error("fatal:", e?.message ?? String(e));
  process.exit(1);
});
