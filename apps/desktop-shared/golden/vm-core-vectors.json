{
  "version": 1,
  "notes": "Cross-language contract for the desktop VM core (apps/builder-mac FlagshipBuilderCore/VM <-> apps/builder-windows src/VM <-> apps/builder-linux vm). Both test suites MUST consume this file so the cores cannot drift — the same role engine/golden/preseed-vectors.json plays for the preseed engine. States: created | installing | installed | awaitingPhoneUnlock | running | stopped | failed:install | failed:run. Events: startInstall | installSucceeded | installFailed | powerOn | guestUnlocked | powerOff | runtimeFailed. Effects: attachInstallerISO | detachInstallerISO | startVirtualMachine | stopVirtualMachine. 'sealed' mirrors VMConfig.awaitsPhoneUnlockAtBoot; transitions listing no 'sealed' key must hold for BOTH values.",
  "lifecycle": {
    "transitions": [
      { "start": "created", "event": "startInstall", "next": "installing", "effects": ["attachInstallerISO", "startVirtualMachine"] },
      { "start": "failed:install", "event": "startInstall", "next": "installing", "effects": ["attachInstallerISO", "startVirtualMachine"] },
      { "start": "installing", "event": "installSucceeded", "next": "installed", "effects": ["detachInstallerISO"] },
      { "start": "installing", "event": "installFailed", "reason": "guest error", "next": "failed:install", "effects": ["stopVirtualMachine", "detachInstallerISO"] },
      { "start": "installed", "event": "powerOn", "sealed": true, "next": "awaitingPhoneUnlock", "effects": ["startVirtualMachine"] },
      { "start": "installed", "event": "powerOn", "sealed": false, "next": "running", "effects": ["startVirtualMachine"] },
      { "start": "stopped", "event": "powerOn", "sealed": true, "next": "awaitingPhoneUnlock", "effects": ["startVirtualMachine"] },
      { "start": "stopped", "event": "powerOn", "sealed": false, "next": "running", "effects": ["startVirtualMachine"] },
      { "start": "failed:run", "event": "powerOn", "sealed": true, "next": "awaitingPhoneUnlock", "effects": ["startVirtualMachine"] },
      { "start": "failed:run", "event": "powerOn", "sealed": false, "next": "running", "effects": ["startVirtualMachine"] },
      { "start": "awaitingPhoneUnlock", "event": "guestUnlocked", "next": "running", "effects": [] },
      { "start": "awaitingPhoneUnlock", "event": "powerOff", "next": "stopped", "effects": ["stopVirtualMachine"] },
      { "start": "running", "event": "powerOff", "next": "stopped", "effects": ["stopVirtualMachine"] },
      { "start": "awaitingPhoneUnlock", "event": "runtimeFailed", "reason": "died", "next": "failed:run", "effects": [] },
      { "start": "running", "event": "runtimeFailed", "reason": "crashed", "next": "failed:run", "effects": [] }
    ],
    "invalid": [
      { "start": "created", "event": "powerOn" },
      { "start": "created", "event": "installSucceeded" },
      { "start": "created", "event": "powerOff" },
      { "start": "created", "event": "guestUnlocked" },
      { "start": "installing", "event": "powerOn" },
      { "start": "installing", "event": "guestUnlocked" },
      { "start": "installing", "event": "startInstall" },
      { "start": "installed", "event": "startInstall" },
      { "start": "installed", "event": "guestUnlocked" },
      { "start": "installed", "event": "powerOff" },
      { "start": "running", "event": "powerOn" },
      { "start": "running", "event": "guestUnlocked" },
      { "start": "running", "event": "startInstall" },
      { "start": "stopped", "event": "guestUnlocked" },
      { "start": "stopped", "event": "startInstall" },
      { "start": "stopped", "event": "powerOff" },
      { "start": "awaitingPhoneUnlock", "event": "powerOn" },
      { "start": "awaitingPhoneUnlock", "event": "startInstall" },
      { "start": "failed:install", "event": "powerOn" },
      { "start": "failed:install", "event": "guestUnlocked" },
      { "start": "failed:run", "event": "startInstall" }
    ]
  },
  "installVerdict": {
    "notes": "A hypervisor-level clean guest-stop during install is ambiguous (success poweroff / completed-install reboot / never-booted all look identical), so the verdict is duration-gated: elapsed >= minPlausibleInstallSeconds => installSucceeded, else installFailed with an actionable reason. Edge: exactly the minimum counts as success. Verdict tokens pin the EVENT chosen, not the failure prose (messages are per-platform).",
    "minPlausibleInstallSeconds": 90,
    "cases": [
      { "elapsedSeconds": 0, "verdict": "installFailed" },
      { "elapsedSeconds": 5, "verdict": "installFailed" },
      { "elapsedSeconds": 45, "verdict": "installFailed" },
      { "elapsedSeconds": 89, "verdict": "installFailed" },
      { "elapsedSeconds": 89.5, "verdict": "installFailed" },
      { "elapsedSeconds": 90, "verdict": "installSucceeded" },
      { "elapsedSeconds": 91, "verdict": "installSucceeded" },
      { "elapsedSeconds": 600, "verdict": "installSucceeded" },
      { "elapsedSeconds": 5400, "verdict": "installSucceeded" }
    ]
  },
  "resourcePlan": {
    "notes": "gib = 2^30. Constants: default 6 GiB (4 GiB on hosts with at most 16 GiB RAM), floor 4 GiB, host reserve 4 GiB, absolute max 8 VMs, default main disk 64 GiB.",
    "cases": [
      { "hostCpus": 1, "hostRamGiB": 8, "vmCpus": 1, "vmMemGiB": 4, "maxVMs": 1 },
      { "hostCpus": 2, "hostRamGiB": 2, "vmCpus": 2, "vmMemGiB": 4, "maxVMs": 0 },
      { "hostCpus": 2, "hostRamGiB": 4, "vmCpus": 2, "vmMemGiB": 4, "maxVMs": 0 },
      { "hostCpus": 2, "hostRamGiB": 7, "vmCpus": 2, "vmMemGiB": 4, "maxVMs": 0 },
      { "hostCpus": 2, "hostRamGiB": 8, "vmCpus": 2, "vmMemGiB": 4, "maxVMs": 1 },
      { "hostCpus": 4, "hostRamGiB": 8, "vmCpus": 2, "vmMemGiB": 4, "maxVMs": 1 },
      { "hostCpus": 4, "hostRamGiB": 9, "vmCpus": 2, "vmMemGiB": 4, "maxVMs": 1 },
      { "hostCpus": 4, "hostRamGiB": 16, "vmCpus": 2, "vmMemGiB": 4, "maxVMs": 2 },
      { "hostCpus": 5, "hostRamGiB": 16, "vmCpus": 3, "vmMemGiB": 4, "maxVMs": 2 },
      { "hostCpus": 8, "hostRamGiB": 12, "vmCpus": 4, "vmMemGiB": 4, "maxVMs": 1 },
      { "hostCpus": 8, "hostRamGiB": 16, "vmCpus": 4, "vmMemGiB": 4, "maxVMs": 2 },
      { "hostCpus": 10, "hostRamGiB": 32, "vmCpus": 4, "vmMemGiB": 6, "maxVMs": 4 },
      { "hostCpus": 12, "hostRamGiB": 32, "vmCpus": 4, "vmMemGiB": 6, "maxVMs": 4 },
      { "hostCpus": 16, "hostRamGiB": 16, "vmCpus": 4, "vmMemGiB": 4, "maxVMs": 2 },
      { "hostCpus": 32, "hostRamGiB": 128, "vmCpus": 4, "vmMemGiB": 6, "maxVMs": 8 }
    ]
  },
  "diskDurability": {
    "notes": "How every hosted server's writable main disk is attached. Two VMs were left with zeroed system files by guest writes the host never flushed. Virtualization.framework (Mac): host-cached, every guest flush reaches the disk. QEMU (Windows, Linux): writeback cache with guest flushes honoured (never cache=unsafe or cache.no-flush), thread-pool I/O (works on every filesystem and on Windows, unlike O_DIRECT), and guest TRIM freeing space in the host image. Each QEMU port asserts every key=value below on the main -drive.",
    "virtualizationFramework": { "cachingMode": "cached", "synchronizationMode": "full" },
    "qemuMainDrive": { "cache": "writeback", "aio": "threads", "discard": "unmap" }
  },
  "serverHealth": {
    "notes": "A hosted server's own health report, read from .com by the order serial that created it (GET /api/order/<serial>/health, control-plane serverHealth.ts). 'response' is the raw body; each port reads it for serverDomain and renders the verdict at nowMs. null = nothing to show (another server, no report yet, malformed). Copy matches the phone apps (BoxHealth.verdict on iOS).",
    "serverDomain": "home.u-x.flagship.services",
    "nowMs": 1800000000000,
    "urlCases": [
      {
        "serial": "AB12_cd-34",
        "url": "https://flagshipserver.com/api/order/AB12_cd-34/health"
      },
      {
        "serial": "../x/../y",
        "url": null
      },
      {
        "serial": "short",
        "url": null
      },
      {
        "serial": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "url": null
      }
    ],
    "cases": [
      {
        "name": "healthy",
        "response": "{\"serverDomain\":\"Home.u-x.flagship.services\",\"health\":{\"v\":1,\"domain\":\"home.u-x.flagship.services\",\"at\":1,\"uptimeS\":93600,\"memTotalMB\":3900,\"memAvailMB\":800,\"swapUsedMB\":0,\"oomKills\":0,\"daemon\":{\"state\":\"active\",\"restarts\":1,\"lastExit\":0},\"tunnel\":true,\"diskUsedPct\":31,\"receivedAt\":1799999980000}}",
        "verdict": {
          "ok": true,
          "lines": [
            "Healthy · 800 MB free of 3900 MB · disk 31% · up 1d 2h"
          ]
        }
      },
      {
        "name": "hours of uptime",
        "response": "{\"serverDomain\":\"Home.u-x.flagship.services\",\"health\":{\"v\":1,\"domain\":\"home.u-x.flagship.services\",\"at\":1,\"uptimeS\":11100,\"memTotalMB\":3900,\"memAvailMB\":800,\"swapUsedMB\":0,\"oomKills\":0,\"daemon\":{\"state\":\"active\",\"restarts\":1,\"lastExit\":0},\"tunnel\":true,\"diskUsedPct\":31,\"receivedAt\":1800000000000}}",
        "verdict": {
          "ok": true,
          "lines": [
            "Healthy · 800 MB free of 3900 MB · disk 31% · up 3h 5m"
          ]
        }
      },
      {
        "name": "minutes of uptime",
        "response": "{\"serverDomain\":\"Home.u-x.flagship.services\",\"health\":{\"v\":1,\"domain\":\"home.u-x.flagship.services\",\"at\":1,\"uptimeS\":2700,\"memTotalMB\":3900,\"memAvailMB\":800,\"swapUsedMB\":0,\"oomKills\":0,\"daemon\":{\"state\":\"active\",\"restarts\":1,\"lastExit\":0},\"tunnel\":true,\"diskUsedPct\":31,\"receivedAt\":1800000000000}}",
        "verdict": {
          "ok": true,
          "lines": [
            "Healthy · 800 MB free of 3900 MB · disk 31% · up 45m"
          ]
        }
      },
      {
        "name": "issues",
        "response": "{\"serverDomain\":\"Home.u-x.flagship.services\",\"health\":{\"v\":1,\"domain\":\"home.u-x.flagship.services\",\"at\":1,\"uptimeS\":93600,\"memTotalMB\":3900,\"memAvailMB\":800,\"swapUsedMB\":0,\"oomKills\":2,\"daemon\":{\"state\":\"failed\",\"restarts\":1,\"lastExit\":0},\"tunnel\":false,\"diskUsedPct\":31,\"receivedAt\":1800000000000}}",
