<Window x:Class="Flagship.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Flagship.Builder"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Flagship Studio"
        Width="940" Height="660"
        MinWidth="860" MinHeight="580"
        MaxWidth="1400"
        Background="{StaticResource FB.Bg}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FB.Font.Body}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Inline converters live here in stable callable form rather than
             requiring a separate file. -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:NullToVisibilityConverter x:Key="NullToCollapsed"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisible"/>
        <local:StreamToBrushConverter x:Key="StreamToBrush"/>
        <local:ModeToggleLabelConverter x:Key="ModeToggleLabel"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <local:StateKindToBrushConverter x:Key="StateKindToBrush"/>
        <local:StateKindToGlyphConverter x:Key="StateKindToGlyph"/>
        <local:QrTerminalToImageConverter x:Key="QrTerminalToImage"/>
    </Window.Resources>

    <DockPanel>
    <!-- Native top menu — the counterpart of the macOS menu bar and the Linux
         hamburger. (Appearance/dark-mode is not here yet: this WPF app ships a
         single light palette; adding Auto/Light/Dark needs a dark resource set.) -->
    <Menu DockPanel.Dock="Top" Background="{StaticResource FB.Surface}" Padding="4,2">
        <MenuItem Header="_File">
            <MenuItem Header="New Server" Click="MenuNewServer_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="MenuExit_Click"/>
        </MenuItem>
        <MenuItem Header="_Help">
            <MenuItem Header="Documentation" Click="MenuDocumentation_Click"/>
            <MenuItem Header="Report an Issue" Click="MenuReportIssue_Click"/>
            <Separator/>
            <MenuItem Header="About Flagship Studio" Click="MenuAbout_Click"/>
        </MenuItem>
    </Menu>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- content -->
            <RowDefinition Height="Auto"/>   <!-- log drawer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="22,18,22,8">
            <Button HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{StaticResource LinkButton}"
                    Content="⌂  Home"
                    ToolTip="Return to pairing home"
                    Click="AddServer_Click"
                    Visibility="{Binding ShowServerDetail,
                        Converter={StaticResource BoolToVisibility}}"/>
            <!-- Mode switch: names the mode a click switches TO (Simple⇄Advanced). -->
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource LinkButton}"
                    Content="{Binding Mode, Converter={StaticResource ModeToggleLabel}}"
                    Click="ModeToggle_Click"
                    Visibility="{Binding AdvancedAllowed, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Content: main area + hosted-servers sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ============ MAIN AREA ============ -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0">
                <Grid>

                    <!-- ===== Phone pairing: separate QR, SAS, and authorization stages ===== -->
                    <Grid Margin="22,10,22,12" Visibility="{Binding ShowPairingCover, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel x:Name="PairingHome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470" AllowDrop="True" DragOver="PairingHome_DragOver" Drop="PairingHome_Drop" Visibility="{Binding ShowPairingQr, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Pair your phone to begin" FontFamily="{StaticResource FB.Font.Title}" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock Text="Open the Flagship app and scan this code — or type it in. You’ll confirm a security code, then build your server here." Style="{StaticResource RowHint}" TextWrapping="Wrap" TextAlignment="Center" Margin="18,8,18,16"/>
                            <Border Background="White" BorderBrush="{StaticResource FB.Border}" BorderThickness="1" CornerRadius="10" Padding="16" MinWidth="210" MinHeight="210">
                                <Grid>
                                    <ProgressBar Width="120" Height="4" IsIndeterminate="True" Visibility="{Binding PairQr, Converter={StaticResource NullToCollapsed}}"/>
                                    <Image Source="{Binding PairQr, Converter={StaticResource QrTerminalToImage}}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Or enter this code" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,12,0,2"/>
                            <TextBlock Text="{Binding PairCode}" FontFamily="{StaticResource FB.Font.Mono}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding PairStatus}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Or drop a recipe anywhere here" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource LinkButton}" Content="Browse recipe…" Margin="6,0" Click="BrowseRecipe_Click"/>
                                <Button Style="{StaticResource LinkButton}" Content="Paste recipe" Margin="6,0" Click="PasteRecipe_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="{Binding ShowPairingConfirm, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="▣" FontSize="40" Foreground="{StaticResource FB.PrimaryDeep}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Confirm the security code" FontFamily="{StaticResource FB.Font.Title}" FontSize="20" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="Check that this code matches the Flagship app, then confirm on your phone." Style="{StaticResource RowHint}" TextWrapping="Wrap" TextAlignment="Center" Margin="16,8,16,16"/>
                            <Border Background="{StaticResource FB.SurfaceElevated}" CornerRadius="10" Padding="24,14"><TextBlock Text="{Binding PairSas}" FontFamily="{StaticResource FB.Font.Mono}" FontSize="38" FontWeight="Bold"/></Border>
                            <TextBlock Text="Waiting for you to confirm on your phone…" Style="{StaticResource Caption}" Margin="0,14,0,0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="{Binding ShowAwaitingAuthorization, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="▯" FontSize="42" Foreground="{StaticResource FB.PrimaryDeep}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Awaiting authorization" FontFamily="{StaticResource FB.Font.Title}" FontSize="20" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="Finish authorizing this server in the Flagship app. This screen continues automatically when your phone sends the approved recipe." Style="{StaticResource RowHint}" TextWrapping="Wrap" TextAlignment="Center" Margin="16,8,16,12"/>
                            <ProgressBar Width="180" Height="5" IsIndeterminate="True"/>
                            <Button Style="{StaticResource LinkButton}" Foreground="{StaticResource FB.Danger}" Content="Cancel pairing" HorizontalAlignment="Center" Margin="0,16,0,0" Click="CancelPairing_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Pane 1: the burn wizard (rows + bake) ===== -->
                    <StackPanel Margin="22,4,22,12"
                                Visibility="{Binding ShowWizardPanes,
                                    Converter={StaticResource BoolToVisibility}}">

                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Content="‹ Pair a phone instead" Margin="0,0,0,8" Click="ReturnToPairing_Click" Visibility="{Binding ManualRecipeMode, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="{Binding AdvancedAllowed, Converter={StaticResource BoolToVisibility}}">
                            <RadioButton Content="Simple" GroupName="BurnMode" Margin="8,0" IsChecked="{Binding IsSimpleMode}" Click="SimpleMode_Click"/>
                            <RadioButton Content="Advanced" GroupName="BurnMode" Margin="8,0" IsChecked="{Binding IsAdvancedMode}" Click="AdvancedMode_Click"/>
                        </StackPanel>
                        <!-- Back to the destination chooser (USB branch only). -->
                        <Button Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left"
                                Content="‹ Choose destination"
                                Margin="0,0,0,4"
                                Click="BackToChooser_Click"
                                Visibility="{Binding ShowDestinationBackLink,
                                    Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Row 1: Recipe -->
                        <Border x:Name="RecipeRow"
                                Style="{StaticResource DropRowBorder}"
                                Tag="{Binding RecipeRowTag}"
                                DragEnter="RecipeRow_DragEnter"
                                DragOver="RecipeRow_DragOver"
                                DragLeave="RecipeRow_DragLeave"
                                Drop="RecipeRow_Drop"
                                MouseLeftButtonUp="RecipeRow_Click"
                                Cursor="Hand"
                                Margin="0,4,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource IconCircle}"
                                        Background="{Binding RecipeIconBg}">
                                    <TextBlock Text="&#x1F4C4;" FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Recipe"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="{Binding RecipeHint}"
                                               Visibility="{Binding HasRecipePrimary,
                                                   Converter={StaticResource BoolToVisibility},
                                                   ConverterParameter=invert}"/>
                                    <TextBlock Style="{StaticResource RowValue}"
                                               Text="{Binding RecipePrimary}"
                                               Visibility="{Binding HasRecipePrimary,
                                                   Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="{Binding RecipeSecondary}"
                                               Visibility="{Binding RecipeSecondary,
                                                   Converter={StaticResource NotNullToVisible}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RecipeStatusGlyph}"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding RecipeStatusBrush}"/>
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Content="Paste recipe from clipboard" Margin="4,-2,0,8" Click="PasteRecipe_Click" Visibility="{Binding ManualRecipeMode, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Row 2: ISO — Advanced mode only. -->
                        <Border x:Name="IsoRow"
                                Style="{StaticResource DropRowBorder}"
                                Tag="{Binding IsoRowTag}"
                                DragEnter="IsoRow_DragEnter"
                                DragOver="IsoRow_DragOver"
                                DragLeave="IsoRow_DragLeave"
                                Drop="IsoRow_Drop"
                                MouseLeftButtonUp="IsoRow_Click"
                                Cursor="Hand"
                                IsEnabled="{Binding IsoPickerEnabled}"
                                Margin="0,4,0,8"
                                Visibility="{Binding ShowIsoRow,
                                    Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource IconCircle}"
                                        Background="{Binding IsoIconBg}">
                                    <TextBlock Text="&#x1F4BF;" FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}"
                                               Text="Debian / Ubuntu ISO"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="Drop a stock installer ISO to remaster"
                                               Visibility="{Binding HasIso,
                                                   Converter={StaticResource BoolToVisibility},
                                                   ConverterParameter=invert}"/>
                                    <TextBlock Style="{StaticResource RowValue}"
                                               Text="{Binding IsoFileName}"
                                               Visibility="{Binding HasIso,
                                                   Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding IsoStatusGlyph}"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding IsoStatusBrush}"/>
                            </Grid>
                        </Border>

                        <CheckBox Content="Use system-provided ISO" IsChecked="{Binding UseSystemIso, Mode=TwoWay}" Margin="4,-2,0,10" FontSize="12" Visibility="{Binding ShowIsoRow, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Row 3: USB Drive -->
                        <Border x:Name="DiskRow"
                                Style="{StaticResource DropRowBorder}"
                                Tag="{Binding DiskRowTag}"
                                AllowDrop="False"
                                Margin="0,4,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource IconCircle}"
                                        Background="{Binding DiskIconBg}">
                                    <TextBlock Text="&#x1F4BE;" FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="USB Drive"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  x:Name="DiskCombo"
                                                  ItemsSource="{Binding Disks}"
                                                  SelectedItem="{Binding SelectedDisk, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  IsEnabled="{Binding HasDisks}"
                                                  Margin="0,2,0,0"/>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource LinkButton}"
                                                Content="Refresh"
                                                Margin="8,0,0,0"
                                                Click="RefreshDisks_Click"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="No removable drives detected. Plug one in and click Refresh."
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasDisks,
                                                   Converter={StaticResource BoolToVisibility},
                                                   ConverterParameter=invert}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DiskStatusGlyph}"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding DiskStatusBrush}"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="4,8,4,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding WifiSsid, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Wi-Fi network name (optional)"/>
                                <PasswordBox Grid.Column="1" PasswordChanged="WifiPassword_Changed" ToolTip="Wi-Fi password (optional)"/>
                            </Grid>
                            <TextBlock Text="Optional Wi-Fi for a server without Ethernet. Baked into this single-use installer." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- Bake button -->
                        <StackPanel Margin="0,18,0,12" HorizontalAlignment="Center">
                            <Button x:Name="BakeButton"
                                    Style="{StaticResource BakeButton}"
                                    Content="{Binding BakeButtonLabel}"
                                    IsEnabled="{Binding CanBake}"
                                    Click="Bake_Click"
                                    Visibility="{Binding ShowProgress,
                                        Converter={StaticResource BoolToVisibility},
                                        ConverterParameter=invert}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       Text="{Binding ReadinessSummary}"
                                       TextWrapping="Wrap"
                                       MaxWidth="380"
                                       TextAlignment="Center"
                                       Visibility="{Binding ShowReadiness,
                                           Converter={StaticResource BoolToVisibility}}"/>

                            <!-- Progress block -->
                            <StackPanel HorizontalAlignment="Center"
                                        Visibility="{Binding ShowProgress,
                                            Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar x:Name="PhaseProgress"
                                             Width="260" Height="6"
                                             Minimum="0" Maximum="1"
                                             Value="{Binding ProgressValue, Mode=OneWay}"
                                             IsIndeterminate="{Binding ProgressIndeterminate}"
                                             Foreground="{Binding ProgressTint}"
                                             Background="{StaticResource FB.SurfaceElevated}"
                                             BorderThickness="0"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"
                                           Text="{Binding ProgressCaption}"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"
                                           MaxWidth="380"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontFamily="{StaticResource FB.Font.Mono}"
                                           Text="{Binding DownloadUrlCaption}"
                                           Visibility="{Binding ShowDownloadRow,
                                               Converter={StaticResource BoolToVisibility}}"/>
                                <Button Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0"
                                        Content="Cancel"
                                        Click="Bake_Click"/>
                            </StackPanel>

                            <!-- Done card -->
                            <Border BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,12,0,0"
                                    BorderBrush="{StaticResource FB.Success}"
                                    Background="{StaticResource FB.SuccessFaded}"
                                    Visibility="{Binding IsFinished,
                                        Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2713;"
                                                   FontSize="15"
                                                   Foreground="{StaticResource FB.Success}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Ready to boot"
                                                   Style="{StaticResource RowTitle}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DoneServerDomain}"
                                               FontFamily="{StaticResource FB.Font.Mono}"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding DoneServerDomain,
                                                   Converter={StaticResource NotNullToVisible}}"/>
                                    <TextBlock Text="{Binding DoneOutputPath}"
                                               FontFamily="{StaticResource FB.Font.Mono}"
                                               Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding DoneOutputPath,
                                                   Converter={StaticResource NotNullToVisible}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== Pane 2: destination chooser (Burn to USB / Host here) ===== -->
                    <StackPanel Margin="22,10,22,12"
                                Visibility="{Binding ShowDestinationChooser,
                                    Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{StaticResource FB.PrimaryFaded}"
                                BorderBrush="{StaticResource FB.Primary}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="14" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2713;" FontSize="16"
                                           Foreground="{StaticResource FB.PrimaryDeep}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding DoneServerDomain}"
                                               Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Recipe verified — choose where this server should live."
                                               Style="{StaticResource RowHint}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource DestinationCard}"
                                Margin="0,0,0,10"
                                Click="ChooseUsb_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource IconCircle}">
                                    <TextBlock Text="&#x1F4BE;" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <Grid>
                                        <TextBlock Text="Burn to USB" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{Binding HardwareBadgeLabel}"
                                                   Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="Build a dedicated hardware appliance — the gold standard. Boot any spare box from the USB stick."/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource DestinationCard}"
                                IsEnabled="{Binding HostHereEnabled}"
                                Click="ChooseHostHere_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource IconCircle}">
                                    <TextBlock Text="&#x1F5A5;" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <Grid>
                                        <TextBlock Text="Host on this PC" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{Binding HostedVmBadgeLabel}"
                                                   Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="Run the same encrypted, phone-gated appliance as a managed VM inside this app. Same recipe, same unlock — your phone still holds the keys."
                                               Visibility="{Binding HostHereDisabledReason,
                                                   Converter={StaticResource NullToCollapsed}}"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Foreground="{StaticResource FB.Warning}"
                                               Text="{Binding HostHereDisabledReason}"
                                               Visibility="{Binding HostHereDisabledReason,
                                                   Converter={StaticResource NotNullToVisible}}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- ===== Pane 3: Host here (create the VM) ===== -->
                    <StackPanel Margin="22,10,22,12"
                                Visibility="{Binding ShowHostHerePane,
                                    Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left"
                                Content="‹ Choose destination"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                                Click="BackToChooser_Click"/>

                        <Border Background="{StaticResource FB.Surface}"
                                BorderBrush="{StaticResource FB.Border}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="14" Margin="0,10,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding DoneServerDomain}"
                                           Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding HostHereSpecSummary}"
                                           Style="{StaticResource RowHint}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Text="The VM installs unattended from the same image a USB burn uses, then boots encrypted and waits for your phone to unlock it. This app never sees the disk key."/>

                        <StackPanel Margin="0,22,0,0" HorizontalAlignment="Center">
                            <Button Style="{StaticResource BakeButton}"
                                    Content="Create server on this PC"
                                    Click="CreateHostHere_Click"
                                    Visibility="{Binding ShowProgress,
                                        Converter={StaticResource BoolToVisibility},
                                        ConverterParameter=invert}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       Text="Encrypted disk · unlocked by your phone"
                                       Visibility="{Binding ShowProgress,
                                           Converter={StaticResource BoolToVisibility},
                                           ConverterParameter=invert}"/>

                            <StackPanel HorizontalAlignment="Center"
                                        Visibility="{Binding ShowProgress,
                                            Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Width="260" Height="6"
                                             Minimum="0" Maximum="1"
                                             Value="{Binding ProgressValue, Mode=OneWay}"
                                             IsIndeterminate="{Binding ProgressIndeterminate}"
                                             Foreground="{Binding ProgressTint}"
                                             Background="{StaticResource FB.SurfaceElevated}"
                                             BorderThickness="0"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"
                                           Text="{Binding ProgressCaption}"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"
                                           MaxWidth="380"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontFamily="{StaticResource FB.Font.Mono}"
                                           Text="{Binding DownloadUrlCaption}"
                                           Visibility="{Binding ShowDownloadRow,
                                               Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== Pane 4: hosted-server detail ===== -->
                    <StackPanel Margin="22,10,22,12"
                                DataContext="{Binding SelectedServer}"
                                Visibility="{Binding DataContext.ShowServerDetail,
                                    RelativeSource={RelativeSource AncestorType=Window},
                                    Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontFamily="{StaticResource FB.Font.Title}"
                                   FontSize="18"
                                   Foreground="{StaticResource FB.Text}"/>
                        <TextBlock Text="{Binding Fqdn}"
                                   FontFamily="{StaticResource FB.Font.Mono}"
                                   Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding BadgeLabel}"
                                   Style="{StaticResource Caption}"
                                   Foreground="{StaticResource FB.PrimaryDeep}"
                                   Margin="0,2,0,0"/>

                        <!-- Status card -->
                        <Border Background="{StaticResource FB.Surface}"
                                BorderBrush="{StaticResource FB.Border}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="14" Margin="0,12,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StateKind, Converter={StaticResource StateKindToGlyph}}"
                                           FontSize="18"
                                           Foreground="{Binding StateKind, Converter={StaticResource StateKindToBrush}}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,10,0"/>
                                <StackPanel MaxWidth="420">
                                    <TextBlock Text="{Binding StateLabel}"
                                               Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="{Binding StatusSubtitle}"
                                               Style="{StaticResource RowHint}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding SpecSummary}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,0,0,12"/>

                        <!-- Controls -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BakeButton}"
                                    MinWidth="110"
                                    Content="Start"
                                    Click="StartServer_Click"
                                    Visibility="{Binding CanStart,
                                        Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Stop"
                                    Click="StopServer_Click"
                                    Visibility="{Binding CanStop,
                                        Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource BakeButton}"
                                    MinWidth="130"
                                    Content="Retry install"
                                    Click="RetryInstall_Click"
                                    Visibility="{Binding CanRetryInstall,
                                        Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Stop installation"
                                    Click="CancelInstall_Click"
                                    Visibility="{Binding CanCancelInstall,
                                        Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <!-- Debug console — exists IFF the recipe carried the
                             owner-signed debug grant. A production VM shows no
                             console affordance at all (the phone-signed grant
                             is the gate; there is no host-side override). -->
                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding ConsoleEnabled,
                                        Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ConsoleToggle"
                                          Background="Transparent" BorderThickness="0"
                                          Cursor="Hand" Padding="0"
                                          HorizontalAlignment="Left"
                                          Checked="ConsoleToggle_Checked"
                                          Unchecked="ConsoleToggle_Unchecked">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <TextBlock Text="&#x276F;_" Margin="0,0,6,0"
                                                       FontFamily="{StaticResource FB.Font.Mono}"
                                                       Foreground="{StaticResource FB.PrimaryDeep}"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="Open CLI/console"
                                           Foreground="{StaticResource FB.PrimaryDeep}"
                                           FontSize="12.5"/>
                            </ToggleButton>
                            <Button x:Name="SshButton"
                                    Style="{StaticResource LinkButton}"
                                    Margin="16,0,0,0"
                                    Foreground="{StaticResource FB.PrimaryDeep}"
                                    FontSize="12.5"
                                    Content="Open in SSH"
                                    Click="OpenSsh_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ConsoleHint"
                                       Style="{StaticResource Caption}"
                                       Text="Console + SSH available while the server is running."
                                       Visibility="Collapsed"/>
                            <Border x:Name="ConsolePanel"
                                    Visibility="Collapsed"
                                    Background="{StaticResource FB.SurfaceElevated}"
                                    BorderBrush="{StaticResource FB.Border}"
                                    BorderThickness="1" CornerRadius="6"
                                    Margin="0,8,0,0" Padding="0">
                                <StackPanel>
                                    <ScrollViewer x:Name="ConsoleScroller"
                                                  Height="200"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="ConsoleOutput"
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontFamily="{StaticResource FB.Font.Mono}"
                                                 FontSize="11.5"
                                                 TextWrapping="Wrap"
                                                 Padding="8"/>
                                    </ScrollViewer>
                                    <TextBox x:Name="ConsoleInput"
                                             FontFamily="{StaticResource FB.Font.Mono}"
                                             FontSize="12"
                                             Margin="8"
                                             KeyDown="ConsoleInput_KeyDown"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Danger row -->
                        <Button Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right"
                                Margin="0,24,0,0"
                                Foreground="{StaticResource FB.Danger}"
                                Content="Delete this server"
                                Click="DeleteServer_Click"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ============ SIDEBAR: servers hosted in this app ============ -->
            <Border Grid.Column="1"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{StaticResource FB.Border}"
                    Background="{StaticResource FB.Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- The section title only makes sense once there is a list
                         to title; an empty machine shows just the "None yet"
                         message below, no header. -->
                    <TextBlock Grid.Row="0"
                               Text="Servers on this PC"
                               Style="{StaticResource RowTitle}"
                               Margin="12,12,12,8"
                               Visibility="{Binding HasHostedServers,
                                   Converter={StaticResource BoolToVisibility}}"/>
                    <ListBox Grid.Row="1"
                             x:Name="ServerList"
                             ItemsSource="{Binding Vm.Servers}"
                             SelectedValuePath="Name"
                             SelectedValue="{Binding SelectedServerName, Mode=TwoWay}"
                             SelectionChanged="ServerList_SelectionChanged"
                             MouseDoubleClick="ServerList_MouseDoubleClick"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="8,0,8,0"
                             ItemContainerStyle="{StaticResource ServerRowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Transparent background so the whole row is
                                     hit-testable for double-click (a shortcut to
                                     SSH-into a running debug VM). The ⋯ button
                                     and right-click both open the same actions
                                     menu — SSH/console appear only for a
                                     debug-enabled VM (ConsoleEnabled). -->
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                         RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Open in SSH"
                                                      Click="ServerRow_OpenSsh_Click"
                                                      Visibility="{Binding ConsoleEnabled,
                                                          Converter={StaticResource BoolToVisibility}}"/>
                                            <MenuItem Header="Open console"
                                                      Click="ServerRow_OpenConsole_Click"
                                                      Visibility="{Binding ConsoleEnabled,
                                                          Converter={StaticResource BoolToVisibility}}"/>
                                            <Separator Visibility="{Binding ConsoleEnabled,
                                                          Converter={StaticResource BoolToVisibility}}"/>
                                            <MenuItem Header="Start"
                                                      Click="ServerRow_Start_Click"
                                                      Visibility="{Binding CanStart,
                                                          Converter={StaticResource BoolToVisibility}}"/>
                                            <MenuItem Header="Stop"
                                                      Click="ServerRow_Stop_Click"
                                                      Visibility="{Binding CanStop,
                                                          Converter={StaticResource BoolToVisibility}}"/>
                                            <MenuItem Header="Stop installation"
                                                      Click="ServerRow_CancelInstall_Click"
                                                      Visibility="{Binding CanCancelInstall,
                                                          Converter={StaticResource BoolToVisibility}}"/>
                                            <Separator/>
                                            <MenuItem Header="Delete…"
                                                      Click="ServerRow_Delete_Click"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Fqdn}"
                                                   Style="{StaticResource RowTitle}"
                                                   FontFamily="{StaticResource FB.Font.Mono}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Ellipse Width="7" Height="7"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding StateKind,
                                                         Converter={StaticResource StateKindToBrush}}"/>
                                            <TextBlock Text="{Binding SidebarStatus}"
                                                       Style="{StaticResource Caption}"
                                                       Margin="5,0,0,0"/>
                                            <TextBlock Text="{Binding BadgeLabel}"
                                                       Style="{StaticResource Caption}"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SpecSummary}"
                                                   Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource LinkButton}"
                                            Content="⋯"
                                            FontSize="16"
                                            Padding="6,0,2,0"
                                            VerticalAlignment="Top"
                                            ToolTip="Actions"
                                            Click="ServerRowMenu_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasHostedServers, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="▥" FontSize="24" Foreground="{StaticResource FB.TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="No servers hosted yet" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Row="2"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{StaticResource FB.Border}">
                        <Button Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left"
                                Margin="8,6,8,8"
                                Content="⊕  Pair a new server"
                                Click="AddServer_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Log drawer -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource FB.Border}"
                Background="{StaticResource FB.Bg}">
            <StackPanel>
                <Grid Margin="22,8,22,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0"
                                  x:Name="LogToggle"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  Padding="0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                    <TextBlock x:Name="Arrow" Text="&#x25B7;"
                                               Foreground="{StaticResource FB.TextMuted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Arrow" Property="Text" Value="&#x25BD;"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <TextBlock>
                            <Run Text="Log"
                                 Foreground="{DynamicResource FB.TextMuted}"
                                 FontSize="11.5"/>
                            <Run Text="{Binding LogCountLabel, Mode=OneWay}"
                                 Foreground="{DynamicResource FB.TextMuted}"
                                 FontFamily="{DynamicResource FB.Font.Mono}"
                                 FontSize="11.5"/>
                        </TextBlock>
                    </ToggleButton>
                    <Button Grid.Column="2"
                            Style="{StaticResource LinkButton}"
                            Content="Clear"
                            Click="ClearLog_Click"
                            Visibility="{Binding HasLogLines,
                                Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <Border Margin="22,0,22,12"
                        BorderThickness="1"
                        BorderBrush="{StaticResource FB.Border}"
                        CornerRadius="6"
                        Background="{StaticResource FB.SurfaceElevated}"
                        Visibility="{Binding ElementName=LogToggle,
                                             Path=IsChecked,
                                             Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer x:Name="LogScroller"
                                  Height="180"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               FontFamily="{StaticResource FB.Font.Mono}"
                                               FontSize="11.5"
                                               Foreground="{Binding Stream,
                                                   Converter={StaticResource StreamToBrush}}"
                                               TextWrapping="Wrap"
                                               Margin="10,1,10,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>
