<Application x:Class="Flagship.Builder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Flagship.Builder">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Flagship design tokens, mirrored from apps/builder-mac
                 Theme.swift (light scheme, post teal-brand-migration): warm
                 off-white canvas, warm-neutral inks + rules, teal #14B8A6
                 accent. No AI-template gradients. -->
            <SolidColorBrush x:Key="FB.Bg"               Color="#F7F6F2"/>
            <SolidColorBrush x:Key="FB.Surface"          Color="#FFFFFF"/>
            <SolidColorBrush x:Key="FB.SurfaceElevated"  Color="#EFEDE7"/>
            <SolidColorBrush x:Key="FB.Border"           Color="#E5E3DC"/>
            <SolidColorBrush x:Key="FB.BorderStrong"     Color="#C8C5BB"/>
            <SolidColorBrush x:Key="FB.Text"             Color="#1F1E1A"/>
            <SolidColorBrush x:Key="FB.Ink"              Color="#000000"/>
            <SolidColorBrush x:Key="FB.TextMuted"        Color="#555149"/>
            <SolidColorBrush x:Key="FB.Primary"          Color="#14B8A6"/>
            <SolidColorBrush x:Key="FB.PrimaryDeep"      Color="#0F8B7E"/>
            <SolidColorBrush x:Key="FB.PrimaryFaded"     Color="#E7F8F6"/>
            <SolidColorBrush x:Key="FB.Success"          Color="#16A34A"/>
            <SolidColorBrush x:Key="FB.SuccessFaded"     Color="#E8F6EE"/>
            <SolidColorBrush x:Key="FB.Warning"          Color="#CA8A04"/>
            <SolidColorBrush x:Key="FB.WarningFaded"     Color="#F9F1DC"/>
            <SolidColorBrush x:Key="FB.Danger"           Color="#DC2626"/>
            <SolidColorBrush x:Key="FB.DangerFaded"      Color="#FBE9E9"/>

            <!-- Native Segoe stack: Segoe UI Variable on 11, Semibold for the
                 title, Cascadia for monospaced log. -->
            <FontFamily x:Key="FB.Font.Body">Segoe UI Variable, Segoe UI, Arial</FontFamily>
            <FontFamily x:Key="FB.Font.Title">Segoe UI Semibold, Segoe UI, Arial</FontFamily>
            <FontFamily x:Key="FB.Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

            <!-- Drop-row card style — used for all three rows. The visual
                 state (idle/dragOver/ready/error) is toggled via attached
                 Tag because WPF Triggers on a string property are the
                 path of least resistance. -->
            <!-- Tag holds the bound state ("ready" / "error" / "").
                 The transient drag-over highlight rides on a separate
                 attached property (DragHelper.IsDragOver) so we don't
                 stomp on the binding when the cursor leaves. -->
            <Style x:Key="DropRowBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="Background" Value="{StaticResource FB.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FB.Border}"/>
                <Setter Property="AllowDrop" Value="True"/>
                <Setter Property="MinHeight" Value="60"/>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="ready">
                        <Setter Property="BorderBrush" Value="{StaticResource FB.Success}"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="error">
                        <Setter Property="BorderBrush" Value="{StaticResource FB.Danger}"/>
                    </Trigger>
                    <Trigger Property="local:DragHelper.IsDragOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource FB.Primary}"/>
                        <Setter Property="Background" Value="{StaticResource FB.PrimaryFaded}"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="IconCircle" TargetType="Border">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Background" Value="{StaticResource FB.SurfaceElevated}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="RowTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FB.Font.Title}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource FB.Text}"/>
            </Style>

            <Style x:Key="RowHint" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FB.Font.Body}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource FB.TextMuted}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="RowValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FB.Font.Body}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource FB.Text}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FB.Font.Body}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Foreground" Value="{StaticResource FB.TextMuted}"/>
            </Style>

            <!-- The big Bake button — primary + ample padding. -->
            <Style x:Key="BakeButton" TargetType="Button">
                <Setter Property="MinWidth" Value="200"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontFamily" Value="{StaticResource FB.Font.Title}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="{StaticResource FB.Primary}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="14,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.92"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource FB.TextMuted}"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="{StaticResource FB.Font.Body}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Implicit ProgressBar template. The stock Aero template ignores
                 Foreground, so we roll a minimal rounded two-layer bar that
                 honors it — this is how the orange→accent tint flip shows.
                 Determinate fill rides on the templated PART_Indicator; the
                 indeterminate state slides a short pip across. -->
            <Style TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource FB.Primary}"/>
                <Setter Property="Background" Value="{StaticResource FB.SurfaceElevated}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border CornerRadius="3"
                                    Background="{TemplateBinding Background}"
                                    ClipToBounds="True">
                                <Grid x:Name="PART_Track">
                                    <Rectangle x:Name="PART_Indicator"
                                               HorizontalAlignment="Left"
                                               RadiusX="3" RadiusY="3"
                                               Fill="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <!-- Show a wide pip and pulse its opacity so
                                         the user sees motion without a layout
                                         animation on the templated indicator. -->
                                    <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Name="IndetPulse">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.35" To="0.85" Duration="0:0:0.7"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="IndetPulse"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Destination-chooser card (Burn to USB / Host on this PC). -->
            <Style x:Key="DestinationCard" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Card"
                                    Background="{StaticResource FB.Surface}"
                                    BorderBrush="{StaticResource FB.Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource FB.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Card" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar server rows: selection ring + faded-teal fill, matching
                 the Mac HostedServersSidebar. -->
            <Style x:Key="ServerRowItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource FB.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource FB.PrimaryFaded}"/>
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource FB.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource FB.BorderStrong}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Bordered secondary action (Stop / Retry), sibling of BakeButton. -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="MinWidth" Value="90"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontFamily" Value="{StaticResource FB.Font.Title}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{StaticResource FB.Surface}"/>
                <Setter Property="Foreground" Value="{StaticResource FB.Text}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource FB.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource FB.SurfaceElevated}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
