<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Flagship.Builder</RootNamespace>
    <AssemblyName>FlagshipBuilder</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- DiskWrite.cs pins a managed buffer + offsets a byte* into WriteFile. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Version>0.0.1</Version>
    <Authors>Flagship</Authors>
    <Product>Flagship Studio</Product>
    <Description>Single-window USB builder for Flagship recipes</Description>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" Generator="MSBuild:Compile" />
    <Page Include="src\MainWindow.xaml" Generator="MSBuild:Compile" />
    <Compile Include="src\App.xaml.cs" />
    <Compile Include="src\MainWindow.xaml.cs" />
    <Compile Include="src\Wizard.cs" />
    <Compile Include="src\DiskEnumerator.cs" />
    <Compile Include="src\VerifyResult.cs" />
    <Compile Include="src\Recipe.cs" />
    <Compile Include="src\Ed25519Verify.cs" />
    <Compile Include="src\DiskWrite.cs" />
    <Compile Include="src\IsoManifestClient.cs" />
    <Compile Include="src\IsoBaseCache.cs" />
    <Compile Include="src\PairSession.cs" />
    <Compile Include="src\NativePairingCrypto.cs" />
    <Compile Include="src\NativeIsoRemaster.cs" />
    <Compile Include="src\NativePreseedEngine.cs" />
    <Compile Include="src\NativeBuildPipeline.cs" />
    <Compile Include="src\BuildLog.cs" />
    <Compile Include="src\VM\HostResources.cs" />
    <Compile Include="src\VM\VMResourcePlan.cs" />
    <Compile Include="src\VM\ServerTier.cs" />
    <Compile Include="src\VM\RecipeSiblings.cs" />
    <Compile Include="src\VM\VMConfig.cs" />
    <Compile Include="src\VM\VMLifecycle.cs" />
    <Compile Include="src\VM\VMInventoryStore.cs" />
    <Compile Include="src\VM\QemuLocator.cs" />
    <Compile Include="src\VM\QemuCommandLine.cs" />
    <Compile Include="src\VM\WhpxProbe.cs" />
    <Compile Include="src\VM\QmpClient.cs" />
    <Compile Include="src\VM\QemuHost.cs" />
    <Compile Include="src\VM\SshLaunch.cs" />
    <Compile Include="src\VM\VMManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.manifest" />
    <None Include="README.md" />
    <EmbeddedResource Include="..\..\packages\flagship-builder\engine\preseed-engine.js" LogicalName="Flagship.Builder.Resources.preseed-engine.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.4.2" />
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
