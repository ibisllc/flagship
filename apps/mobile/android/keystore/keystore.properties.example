# Release signing credentials for the Android AAB.
#
# Copy this file to `keystore.properties` (same directory) and fill in
# the real values. The real `keystore.properties` and any *.jks /
# *.keystore files are gitignored — never commit secrets.
#
# If `keystore.properties` is absent, the release build falls back to
# debug signing so a fresh checkout still builds (see app/build.gradle.kts).
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore flagship-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias flagship
# Keep the resulting .jks safe and OFF the repo (back it up securely —
# losing it means you can never update the Play listing).

# Path to the keystore, resolved relative to the android/ root project.
storeFile=keystore/flagship-release.jks

# Password protecting the keystore file itself.
storePassword=CHANGE_ME_STORE_PASSWORD

# Alias of the key inside the keystore (the `-alias` above).
keyAlias=flagship

# Password protecting that specific key (often same as storePassword).
keyPassword=CHANGE_ME_KEY_PASSWORD
