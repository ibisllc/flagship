<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- LAN-direct: re-probe the box's local address when the network changes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.strongbox_keystore" android:required="false" />
    <!-- On-device USB-OTG builder: write a bootable installer to a USB stick via
         the USB Host API (no root). The flow is launched in-app from the
         create-server delivery chooser and requests device permission at
         runtime, so no USB_DEVICE_ATTACHED launch intent-filter is declared
         (that would offer the app for every attached mass-storage device). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <application
        android:label="Flagship"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Flagship"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false">

        <!-- singleTop: an intent for the running app (launcher, `am start`,
             a link) reaches the open activity through onNewIntent instead of
             stacking a fresh one, so a half-finished flow survives it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Flagship">
            <!-- LAUNCHER lives on the two activity-aliases below (icon switcher),
                 not here, so exactly one branded icon appears in the drawer. -->
            <!-- Deep links from push notifications + cross-device
                 pairing (Phase 3b /join). autoVerify needs the
                 /.well-known/assetlinks.json on flagshipserver.com to
                 list this app's package + signing cert (operator
                 follow-up). Older builds' flagship:// links (the
                 filters below) still open. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="flagshipserver.com" android:pathPrefix="/app/" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/join" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/join/" />
                <!-- Transfer-a-box take-over offer. /transfer?o=<b64url> opens the
                     acquirer claim flow in-app; when the app isn't installed the
                     site shows its "get the app" page, which offers the webapp too. -->
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/transfer" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/transfer/" />
                <!-- Share this server: /share#s=<shareId>&k=<secret> opens the accept screen. -->
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/share" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/share/" />
                <!-- QR codes and shared links (the old flagship:// forms below still
                     open): the remote page's /remote?s=&k=, Studio's /builder?c=&k=,
                     the knock page's /access#server=&svc=&ref=&page= and a friend's
                     /invite-accept#server=&iid=&ref=&aid=&sig=&at= reply (filters match
                     the path only, so the fragment and older ?query forms both open). Without the
                     app, the site shows a "get the app" page at each path. -->
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/remote" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/remote/" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/builder" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/builder/" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/access" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/access/" />
                <!-- An app invite's "Open in the Flagship app":
                     /invite#server=<box>&k=<secret>&a=&i=&s= opens the redeem screen. -->
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/invite" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/invite/" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/invite-accept" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/invite-accept/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flagship" android:host="join" />
            </intent-filter>
            <!-- Older builds' flagship://transfer?o=<b64url>, the custom-scheme
                 twin of the /transfer take-over link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flagship" android:host="transfer" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flagship" android:host="share" />
            </intent-filter>
            <!-- #92 — older box /invite pages' "open in app" hand-off
                 (flagship://invite?server=<host>&k=<secret>); Android drops the
                 URL fragment from App-Links so the secret rides a query param. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flagship" android:host="invite" />
            </intent-filter>
            <!-- Web-experience gating — the visitor authorizes a browser's
                 QR-login for a restricted service's WEBSITE
                 (older knock pages: flagship://access?server=…&svc=…&ref=…&page=…). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flagship" android:host="access" />
            </intent-filter>
            <!-- The remote page's older QR (flagship://remote?s=<sid>&k=<pk>): a
                 browser at remote.flagshipserver.com asking this phone to let
                 it in as a keyless remote. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flagship" android:host="remote" />
            </intent-filter>
            <!-- Older Studio builds' pairing QR (flagship://builder?c=<code>&k=<pk>). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flagship" android:host="builder" />
            </intent-filter>
            <!-- Older apps' acceptance reply (flagship://invite-accept?…). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flagship" android:host="invite-accept" />
            </intent-filter>
        </activity>

        <!-- App-icon switcher (Settings → App icon). Two launcher aliases, one
             enabled at a time via PackageManager.setComponentEnabledSetting.
             Classic (teal + white circle, brand-consistent with iOS) is the
             default; Legacy (the original hexagon) is the opt-in alternate.
             Both target MainActivity, which owns the deep-link intent-filters. -->
        <activity-alias
            android:name=".ClassicLauncher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="Flagship"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LegacyLauncher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Flagship"
            android:icon="@mipmap/ic_launcher_legacy"
            android:roundIcon="@mipmap/ic_launcher_legacy_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- FCM messaging service -->
        <service
            android:name=".push.FlagshipFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Home-screen server status widget (Glance). -->
        <receiver
            android:name=".companion.PodStatusWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_pod_status_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pod_status_widget_info" />
        </receiver>

        <!-- The Wear OS app's requests (Approve) over the Wearable Data Layer. -->
        <service
            android:name=".companion.WatchRequestService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/flagship/" />
            </intent-filter>
        </service>

        <!-- Dead-man affirmation reminder (T-6h/T-1h/T-15m alarms) -->
        <receiver
            android:name=".push.DeadManReminderReceiver"
            android:exported="false" />

        <!-- Share a minted recipe file from the create-server delivery chooser
             (Save / share), a git import's flagship.app.json and a table's
             CSV export. Authority "<applicationId>.fileprovider"; paths in
             res/xml/file_paths.xml (cache/recipes, cache/adapters and
             cache/exports only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Google Fonts provider declaration -->
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>
</manifest>
