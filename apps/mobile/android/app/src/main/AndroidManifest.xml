<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.strongbox_keystore" android:required="false" />
    <!-- On-device USB-OTG burner: write a bootable installer to a USB stick via
         the USB Host API (no root). The flow is launched in-app from the
         create-server delivery chooser and requests device permission at
         runtime, so no USB_DEVICE_ATTACHED launch intent-filter is declared
         (that would offer the app for every attached mass-storage device). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <application
        android:label="Flagship"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Flagship"
        android:allowBackup="false"
        android:fullBackupContent="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Flagship">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links from push notifications + cross-device
                 pairing (Phase 3b /join). autoVerify needs the
                 /.well-known/assetlinks.json on flagshipserver.com to
                 list this app's package + signing cert (operator
                 follow-up). The flagship:// scheme is the in-app
                 fallback that needs no verification. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="flagshipserver.com" android:pathPrefix="/app/" />
                <data android:scheme="https" android:host="flagshipserver.com" android:path="/join" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flagship" android:host="join" />
            </intent-filter>
            <!-- #92 — service-access invite "open in app" hand-off
                 (flagship://invite?server=<host>&k=<secret>). The box's
                 /invite page offers this; Android drops the URL fragment from
                 App-Links so the secret rides a query param. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flagship" android:host="invite" />
            </intent-filter>
            <!-- Web-experience gating — the visitor authorizes a browser's
                 QR-login for a restricted service's WEBSITE
                 (flagship://access?server=…&svc=…&ref=…&page=…). The box's
                 knock page offers this as the same-device "Access site"
                 button (and a QR for cross-device). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flagship" android:host="access" />
            </intent-filter>
        </activity>

        <!-- FCM messaging service -->
        <service
            android:name=".push.FlagshipFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Dead-man affirmation reminder (T-6h/T-1h/T-15m alarms) -->
        <receiver
            android:name=".push.DeadManReminderReceiver"
            android:exported="false" />

        <!-- Google Fonts provider declaration -->
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>
</manifest>
