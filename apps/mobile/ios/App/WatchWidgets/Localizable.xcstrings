    "Shows a server's install while one is under way, else how your servers are doing.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la instalación de un servidor mientras hay una en curso; si no, cómo van tus servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l’installation d’un serveur lorsqu’une est en cours, sinon l’état de vos serveurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Installation eines Servers, solange eine läuft, sonst den Zustand deiner Server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a instalação de um servidor enquanto uma estiver em andamento; senão, como estão seus servidores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール中はサーバーのインストール状況を、それ以外はサーバーの状態を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有安装进行时显示服务器的安装进度，否则显示你的服务器状态。"
          }
        }
      }
    },
