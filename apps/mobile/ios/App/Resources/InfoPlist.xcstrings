{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship uses the camera to scan a pairing QR shown by your server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship usa la cámara para escanear un QR de vinculación que muestra tu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship utilise l’appareil photo pour scanner un QR d’association affiché par votre serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship verwendet die Kamera, um einen von deinem Server angezeigten Kopplungs-QR-Code zu scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flagship usa a câmera para escanear um QR de pareamento exibido pelo seu servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship は、サーバーに表示されるペアリング用 QR コードをスキャンするためにカメラを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship 使用相机扫描你的服务器显示的配对二维码。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship uses Bluetooth to find a Flagship box you bought and set it up. It looks only while you set up a box."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship usa Bluetooth para encontrar un equipo Flagship que has comprado y configurarlo. Solo busca mientras configuras un equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship utilise le Bluetooth pour trouver un boîtier Flagship que vous avez acheté et le configurer. Il ne cherche que pendant la configuration d'un boîtier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship nutzt Bluetooth, um eine gekaufte Flagship-Box zu finden und einzurichten. Es sucht nur, während du eine Box einrichtest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flagship usa o Bluetooth para encontrar uma caixa Flagship que você comprou e configurá-la. Ele só procura enquanto você configura uma caixa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship は Bluetooth を使って、購入した Flagship ボックスを見つけて設定します。ボックスを設定している間だけ探します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship 使用蓝牙查找你购买的 Flagship 主机并进行设置。仅在你设置主机时搜索。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship uses Face ID to confirm sensitive actions like approving unlock or revoking a server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship usa Face ID para confirmar acciones sensibles, como aprobar un desbloqueo o revocar un servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship utilise Face ID pour confirmer des actions sensibles, comme approuver un déverrouillage ou révoquer un serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship verwendet Face ID, um sensible Aktionen zu bestätigen, etwa eine Entsperrung zu genehmigen oder einen Server zu widerrufen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flagship usa o Face ID para confirmar ações sensíveis, como aprovar um desbloqueio ou revogar um servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship は、ロック解除の承認やサーバーの取り消しなど、重要な操作を確認するために Face ID を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship 使用 Face ID 来确认敏感操作，例如批准解锁或撤销服务器。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship talks to your server directly when it's on the same network, which is faster than going through the relay, and finds your server there when Flagship can't be reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship se comunica directamente con tu servidor cuando está en la misma red, lo que es más rápido que pasar por el relé, y lo encuentra ahí cuando no se puede contactar con Flagship."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship communique directement avec votre serveur lorsqu'il est sur le même réseau, ce qui est plus rapide que de passer par le relais, et l'y retrouve lorsque Flagship est injoignable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship spricht direkt mit deinem Server, wenn er im selben Netzwerk ist. Das ist schneller als über das Relay, und so findet Flagship deinen Server dort auch, wenn Flagship nicht erreichbar ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Flagship se comunica diretamente com seu servidor quando ele está na mesma rede, o que é mais rápido do que passar pelo relay, e o encontra lá quando o Flagship não pode ser acessado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが同じネットワーク上にある場合、Flagship はサーバーと直接通信します。リレーを経由するより高速で、Flagship に接続できないときもそのネットワーク上でサーバーを見つけられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当服务器与手机在同一网络时，Flagship 会直接与服务器通信，比经由中继更快；在无法连接 Flagship 时，也能在该网络上找到你的服务器。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
