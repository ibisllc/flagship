    "Switch the cloud this phone is using. Each profile has its own account key.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la nube que usa este teléfono. Cada perfil tiene su propia clave de cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez le cloud utilisé par ce téléphone. Chaque profil a sa propre clé de compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle die Cloud, die dieses Telefon nutzt. Jedes Profil hat seinen eigenen Kontoschlüssel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque a nuvem que este celular usa. Cada perfil tem a sua própria chave de conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンが使用するクラウドを切り替えます。各プロフィールに専用のアカウントキーがあります。"
          }
        },
        "zh-Hans": {
