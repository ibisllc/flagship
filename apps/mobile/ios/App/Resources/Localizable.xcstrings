    "%@ checks that their phone shows the same code before giving you access. If it doesn't match, they won't confirm.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ comprueba que su teléfono muestra el mismo código antes de darte acceso. Si no coincide, no confirmará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vérifie que son téléphone affiche le même code avant de vous donner l’accès. Si ce n’est pas le cas, il ne confirmera pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ prüft, ob sein Telefon denselben Code anzeigt, bevor du Zugriff erhältst. Wenn er nicht übereinstimmt, wird bestätigt nichts."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ confere se o celular dele mostra o mesmo código antes de dar acesso a você. Se não for igual, ele não confirmará."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は、アクセスを許可する前に、相手のスマートフォンに同じコードが表示されているか確認します。一致しない場合は確定されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会先核对其手机上是否显示相同的代码，然后才给你访问权限。如果不一致，TA 不会确认。"
          }
        }
      }
    },
