    },
    "Only confirm if it matches. A different code means someone else opened the link.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma solo si coincide. Un código distinto significa que otra persona abrió el enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne confirmez que s’il correspond. Un code différent signifie que quelqu’un d’autre a ouvert le lien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige nur, wenn er übereinstimmt. Ein anderer Code bedeutet, dass jemand anderes den Link geöffnet hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme somente se for igual. Um código diferente significa que outra pessoa abriu o link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致する場合にのみ確定してください。コードが違う場合は、別の誰かがリンクを開いています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有一致时才确认。代码不同则意味着是别人打开了该链接。"
          }
        }
      }
    },
