    "Tick a server to copy this app there: its code, data and files as they are now. Each copy then runs on its own. Untick a server to remove the app from it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca un servidor para copiar allí esta app: su código, datos y archivos tal como están ahora. Cada copia funciona después por su cuenta. Desmarca un servidor para quitarle la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez un serveur pour y copier cette app : son code, ses données et ses fichiers tels qu’ils sont maintenant. Chaque copie fonctionne ensuite de façon indépendante. Décochez un serveur pour lui retirer l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake einen Server an, um diese App dorthin zu kopieren: Code, Daten und Dateien, wie sie jetzt sind. Jede Kopie läuft danach für sich. Entferne den Haken, um die App von einem Server zu entfernen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque um servidor para copiar este app para lá: o código, os dados e os arquivos como estão agora. Cada cópia depois roda por conta própria. Desmarque um servidor para remover o app dele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーにチェックを入れると、このアプリのコード、データ、ファイルを現在の状態のままそこへコピーします。以降、各コピーは独立して動きます。チェックを外すと、そのサーバーからアプリを削除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选一台服务器，即可把此应用（代码、数据和文件，保持当前状态）复制到那里。此后每个副本各自独立运行。取消勾选则会从该服务器移除此应用。"
          }
        }
      }
    },
    "Only the account owner's phone can copy or remove apps.": {
      "extractionState": "manual",
