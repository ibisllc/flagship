    "Your app's live data. Reading is safe; anything that changes data asks for Face ID first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos en vivo de tu app. Leer es seguro; cualquier cambio de datos pide antes Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données en direct de votre app. La lecture est sans risque ; tout ce qui modifie des données demande d’abord Face ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Daten deiner App. Lesen ist sicher; alles, was Daten ändert, verlangt zuerst Face ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados ao vivo do seu app. Ler é seguro; qualquer coisa que altere dados pede Face ID antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのライブデータです。読み取りは安全で、データを変更する操作は先に Face ID を求められます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你应用的实时数据。读取是安全的；任何更改数据的操作都会先要求 Face ID。"
          }
        }
      }
    },
