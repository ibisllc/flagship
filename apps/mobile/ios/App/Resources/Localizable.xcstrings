    "Update Flagship on your iPhone first. Approving is paused until you do.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero actualiza Flagship en tu iPhone. La aprobación queda en pausa hasta que lo hagas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez d’abord Flagship à jour sur votre iPhone. L’approbation est suspendue jusqu’à ce que vous le fassiez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere zuerst Flagship auf deinem iPhone. Das Genehmigen ist pausiert, bis du es tust."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro atualize o Flagship no seu iPhone. A aprovação fica em pausa até você fazer isso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、iPhone の Flagship を更新してください。更新するまで承認は一時停止されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在 iPhone 上更新 Flagship。在你更新之前，批准功能处于暂停状态。"
          }
        }
