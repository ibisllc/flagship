    "Deleted %@. If it's online it will erase itself and power off.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eliminado. Si está en línea, se borrará a sí mismo y se apagará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ supprimé. S’il est en ligne, il s’effacera lui-même et s’éteindra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gelöscht. Wenn er online ist, löscht er sich selbst und schaltet sich aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ excluído. Se estiver online, ele se apagará sozinho e desligará."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しました。オンラインの場合は、自身を消去して電源を切ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除 %@。如果它在线，将自行擦除并关机。"
          }
        }
      }
    },
