    "The server didn't confirm the approval. Try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no confirmó la aprobación. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas confirmé l’approbation. Réessayez dans un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Genehmigung nicht bestätigt. Versuche es gleich noch einmal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não confirmou a aprovação. Tente de novo em instantes."
          }
        },
