    },
    "This was cancelled from another device on your account. If it's still you, start again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se canceló desde otro dispositivo de tu cuenta. Si sigues siendo tú, empieza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela a été annulé depuis un autre appareil de votre compte. Si c’est toujours vous, recommencez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wurde von einem anderen Gerät deines Kontos abgebrochen. Wenn du es noch bist, beginne von vorn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto foi cancelado a partir de outro dispositivo da sua conta. Se ainda for você, recomece."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの別のデバイスからキャンセルされました。ご本人であれば、最初からやり直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作已从你账户上的另一台设备取消。如果仍是你本人，请重新开始。"
          }
        }
      }
    },
    "This recovery expired before it was completed. Start again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta recuperación caducó antes de completarse. Empieza de nuevo."
          }
