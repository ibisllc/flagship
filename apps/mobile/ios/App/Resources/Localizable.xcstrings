        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存你分片的服务器"
          }
        }
      }
    },
    "None yet. Pieces are placed once your newest backup is ready and enough other servers can hold it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía ninguno. Los fragmentos se colocan cuando tu copia más reciente está lista y hay suficientes servidores que puedan guardarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun pour l’instant. Les fragments sont placés une fois votre sauvegarde la plus récente prête et lorsque assez d’autres serveurs peuvent la conserver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine. Teile werden verteilt, sobald dein neuestes Backup bereit ist und genügend andere Server es aufnehmen können."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum ainda. Os pedaços são distribuídos quando o seu backup mais recente estiver pronto e houver servidores suficientes para guardá-lo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだありません。最新のバックアップの準備ができ、保管できる他のサーバーが十分にあると、断片が配置されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无。当你最新的备份就绪，且有足够多的其他服务器可以保存它时，才会放置分片。"
          }
        }
      }
    },
