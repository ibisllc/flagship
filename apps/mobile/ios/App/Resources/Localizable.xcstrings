        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les membres et vous pouvez l’ouvrir. Toute autre personne est invitée à se connecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Mitglieder und du können sie öffnen. Alle anderen werden zur Anmeldung aufgefordert."
