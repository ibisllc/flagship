          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vos propres téléphones et tablettes. Pour donner l’accès à une autre personne, utilisez Partager ce serveur sur la page du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für deine eigenen Telefone und Tablets. Um einer anderen Person Zugriff zu geben, nutze „Diesen Server teilen“ auf der Seite des Servers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para os seus próprios celulares e tablets. Para dar acesso a outra pessoa, use Compartilhar este servidor na página do servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身のスマートフォンとタブレット用です。他の人にアクセスを許可するには、サーバーのページで「このサーバーを共有」を使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
