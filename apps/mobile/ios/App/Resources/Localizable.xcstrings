    "Check that this matches the code on your computer. Only confirm if they're the same.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que coincide con el código de tu ordenador. Confirma solo si son iguales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez qu’il correspond au code sur votre ordinateur. Ne confirmez que s’ils sont identiques."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob er mit dem Code auf deinem Computer übereinstimmt. Bestätige nur, wenn beide gleich sind."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira se corresponde ao código no seu computador. Confirme somente se forem iguais."
          }
        },
        "ja": {
