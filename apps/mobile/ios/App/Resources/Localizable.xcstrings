    "These six digits must match what the desktop shows. If they don't, someone is in the middle — cancel.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos seis dígitos deben coincidir con los que muestra el escritorio. Si no, alguien está en medio: cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces six chiffres doivent correspondre à ceux affichés sur l’ordinateur. Sinon, quelqu’un s’est interposé — annulez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese sechs Ziffern müssen mit denen auf dem Desktop übereinstimmen. Wenn nicht, schaltet sich jemand dazwischen – brich ab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes seis dígitos devem ser iguais aos exibidos no desktop. Se não forem, alguém está no meio do caminho — cancele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この 6 桁は、パソコンに表示されているものと一致する必要があります。違う場合は誰かが介在しています。キャンセルしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这六位数字必须与桌面端显示的一致。如果不一致，说明有人在中间拦截：请取消。"
          }
        }
      }
    },
    "Codes match — confirm": {
      "extractionState": "manual",
