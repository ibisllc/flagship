    "Your identity key has rotated. Other devices on this account will be asked to re-pair the next time they open the app.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave de identidad ha rotado. A los demás dispositivos de esta cuenta se les pedirá que se vuelvan a vincular la próxima vez que abran la app."
          }
        },
        "fr": {
          "stringUnit": {
