    "Pick one to continue. You can change it any time in the server's Backups section.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una para continuar. Puedes cambiarla cuando quieras en la sección Copias de seguridad del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-en une pour continuer. Vous pouvez la modifier à tout moment dans la section Sauvegardes du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine aus, um fortzufahren. Du kannst sie jederzeit im Bereich „Backups“ des Servers ändern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma para continuar. Você pode mudar a qualquer momento na seção Backups do servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行するには 1 つ選んでください。サーバーの「バックアップ」セクションでいつでも変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一项以继续。你可以随时在服务器的“备份”部分更改。"
          }
        }
      }
    },
    "Nothing is copied. You can turn backups on later.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se copia nada. Puedes activar las copias de seguridad más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est copié. Vous pourrez activer les sauvegardes plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts kopiert. Du kannst Backups später einschalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é copiado. Você pode ativar os backups depois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何もコピーされません。バックアップは後からオンにできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会复制任何内容。你以后可以开启备份。"
          }
        }
      }
    },
    "An encrypted copy is kept on this phone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda una copia cifrada en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie chiffrée est conservée sur ce téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine verschlüsselte Kopie wird auf diesem Telefon aufbewahrt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia criptografada é mantida neste celular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化されたコピーがこのスマートフォンに保管されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密副本保存在这部手机上。"
          }
        }
      }
    },
    "Encrypted pieces are kept on other Flagship servers, and yours keeps theirs.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fragmentos cifrados se guardan en otros servidores de Flagship, y el tuyo guarda los suyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fragments chiffrés sont conservés sur d’autres serveurs Flagship, et le vôtre conserve les leurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte Teile werden auf anderen Flagship-Servern aufbewahrt, und deiner bewahrt deren Teile auf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedaços criptografados são mantidos em outros servidores Flagship, e o seu mantém os deles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された断片が他の Flagship サーバーに保管され、あなたのサーバーも他のサーバーの断片を保管します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密分片保存在其他 Flagship 服务器上，你的服务器也保存它们的分片。"
          }
        }
      }
    },
