    "This build is too big for Flagship Inference. Try a smaller change, or use your own AI key.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación es demasiado grande para Flagship Inference. Prueba un cambio más pequeño o usa tu propia clave de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce build est trop volumineux pour Flagship Inference. Essayez une modification plus petite, ou utilisez votre propre clé d’IA."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build ist für Flagship Inference zu groß. Versuche eine kleinere Änderung oder verwende deinen eigenen KI-Schlüssel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
