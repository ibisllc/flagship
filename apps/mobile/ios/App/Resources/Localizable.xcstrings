    "Server revoked. It can't connect or unlock until you un-revoke it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor revocado. No puede conectarse ni desbloquearse hasta que lo restaures."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur révoqué. Il ne peut ni se connecter ni se déverrouiller tant que vous ne l’avez pas rétabli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server widerrufen. Er kann sich nicht verbinden oder entsperren, bis du den Widerruf aufhebst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor revogado. Ele não pode se conectar nem desbloquear até que você desfaça a revogação."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーを取り消しました。取り消しを解除するまで、接続もロック解除もできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器已撤销。在你恢复之前，它无法连接或解锁。"
          }
        }
      }
    },
