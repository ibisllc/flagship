    "Flagship's maintainers haven't endorsed that release.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los responsables de Flagship no han avalado esa versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mainteneurs de Flagship n’ont pas validé cette version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Flagship-Maintainer haben diese Version nicht freigegeben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os mantenedores do Flagship não endossaram essa versão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship のメンテナーはそのリリースを承認していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship 维护者尚未认可该版本。"
          }
        }
      }
    },
    "Use letters, digits and _ only, not starting with a digit (like API_KEY).": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa solo letras, dígitos y _, sin empezar por un dígito (como API_KEY)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez uniquement des lettres, des chiffres et _, sans commencer par un chiffre (comme API_KEY)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Buchstaben, Ziffern und _ verwenden, nicht mit einer Ziffer beginnen (z. B. API_KEY)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use apenas letras, dígitos e _, sem começar por um dígito (como API_KEY)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字、数字、_ のみを使い、数字で始めないでください（例：API_KEY）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能使用字母、数字和 _，且不能以数字开头（如 API_KEY）。"
          }
        }
      }
    },
    "Names starting with FLAGSHIP_ are set by your server.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres que empiezan por FLAGSHIP_ los define tu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms commençant par FLAGSHIP_ sont définis par votre serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen, die mit FLAGSHIP_ beginnen, legt dein Server fest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes que começam com FLAGSHIP_ são definidos pelo seu servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FLAGSHIP_ で始まる名前はサーバーが設定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 FLAGSHIP_ 开头的名称由你的服务器设置。"
          }
        }
      }
    },
    "Update required. Flagship is paused on this device until you update.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualización necesaria. Flagship queda en pausa en este dispositivo hasta que actualices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour requise. Flagship est en pause sur cet appareil jusqu’à ce que vous mettiez à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Update erforderlich. Flagship ist auf diesem Gerät pausiert, bis du aktualisierst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualização necessária. O Flagship fica em pausa neste dispositivo até você atualizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが必要です。アップデートするまで、このデバイスでは Flagship は一時停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要更新。在你更新之前，Flagship 在此设备上处于暂停状态。"
          }
        }
      }
    },
    "The connection dropped. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cortó la conexión. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été coupée. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wurde unterbrochen. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão caiu. Tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れました。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接已中断。请重试。"
          }
        }
      }
    },
    "That took too long. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tardó demasiado. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela a pris trop de temps. Vérifiez votre connexion et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat zu lange gedauert. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Demorou demais. Verifique sua conexão e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間がかかりすぎました。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耗时过长。请检查网络连接后重试。"
          }
        }
      }
    },
    "Your phone can't find this server's address yet. This usually clears within a few minutes. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono aún no encuentra la dirección de este servidor. Suele resolverse en unos minutos. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléphone ne trouve pas encore l’adresse de ce serveur. Cela se résout généralement en quelques minutes. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon findet die Adresse dieses Servers noch nicht. Das klärt sich meist innerhalb weniger Minuten. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu celular ainda não encontra o endereço deste servidor. Isso costuma se resolver em alguns minutos. Tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンがこのサーバーのアドレスをまだ見つけられません。通常は数分で解消します。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手机暂时还找不到此服务器的地址。通常几分钟内会恢复。请重试。"
          }
        }
      }
    },
    "We couldn't complete that. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos completarlo. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu terminer l’opération. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnten wir nicht abschließen. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos concluir isso. Tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法完成此操作。请重试。"
          }
        }
      }
    },
    "Something went wrong. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado. Tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题。请重试。"
          }
        }
      }
    },
    "That name is still held by an earlier, unfinished order. Cancel that order from Home, or choose another name.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese nombre sigue reservado por un pedido anterior sin terminar. Cancela ese pedido desde Inicio o elige otro nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom est toujours retenu par une commande précédente inachevée. Annulez cette commande depuis l’accueil, ou choisissez un autre nom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name ist noch durch eine frühere, unvollendete Bestellung belegt. Brich diese Bestellung auf dem Startbildschirm ab oder wähle einen anderen Namen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse nome ainda está retido por um pedido anterior não concluído. Cancele esse pedido em Início ou escolha outro nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前は、以前の未完了の注文でまだ確保されています。ホームからその注文をキャンセルするか、別の名前を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名称仍被之前一个未完成的订单占用。请在主页取消该订单，或选择其他名称。"
          }
        }
      }
    },
    "This phone's clock looks off. Check the date and time, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj de este teléfono parece desajustado. Revisa la fecha y la hora e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge de ce téléphone semble décalée. Vérifiez la date et l’heure, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr dieses Telefons scheint falsch zu gehen. Prüfe Datum und Uhrzeit und versuche es dann erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio deste celular parece errado. Confira a data e a hora e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンの時計がずれているようです。日付と時刻を確認してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机的时钟似乎不准。请检查日期和时间后重试。"
          }
        }
      }
    },
    "Your account key didn't match. Try again, or sign in again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de tu cuenta no coincidió. Inténtalo de nuevo o vuelve a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de votre compte ne correspondait pas. Réessayez ou reconnectez-vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kontoschlüssel hat nicht gepasst. Versuche es erneut oder melde dich neu an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave da sua conta não correspondeu. Tente de novo ou entre novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントキーが一致しませんでした。もう一度試すか、サインインし直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户密钥不匹配。请重试，或重新登录。"
          }
        }
      }
    },
    "This device isn't allowed to do that.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene permiso para hacer eso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’est pas autorisé à faire cela."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät darf das nicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem permissão para fazer isso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはその操作を行う権限がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无权执行该操作。"
          }
        }
      }
    },
    "Remove this account from this device?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar esta cuenta de este dispositivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer ce compte de cet appareil ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto von diesem Gerät entfernen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover esta conta deste dispositivo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントをこのデバイスから削除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此设备移除该账户？"
          }
        }
      }
    },
    "This also removes this device's admin key, which you need to sign in to your servers. Save a backup of your account key first, or remove anyway.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto también elimina la clave de administrador de este dispositivo, que necesitas para iniciar sesión en tus servidores. Guarda antes una copia de la clave de tu cuenta, o quítala de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime aussi la clé d’administrateur de cet appareil, dont vous avez besoin pour vous connecter à vos serveurs. Enregistrez d’abord une sauvegarde de la clé de votre compte, ou retirez-la quand même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird auch der Admin-Schlüssel dieses Geräts entfernt, den du brauchst, um dich bei deinen Servern anzumelden. Sichere zuerst deinen Kontoschlüssel oder entferne das Konto trotzdem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso também remove a chave de administrador deste dispositivo, que você precisa para entrar nos seus servidores. Salve antes um backup da chave da sua conta ou remova mesmo assim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、サーバーへのサインインに必要なこのデバイスの管理者キーも削除されます。先にアカウントキーのバックアップを保存するか、そのまま削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这也会移除此设备的管理员密钥，而你需要它来登录你的服务器。请先备份你的账户密钥，或仍然移除。"
          }
        }
      }
    },
    "Save my account key first": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar antes la clave de mi cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer d’abord la clé de mon compte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst meinen Kontoschlüssel sichern"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar primeiro a chave da minha conta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にアカウントキーを保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先保存我的账户密钥"
          }
        }
      }
    },
    "Remove anyway": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar de todos modos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer quand même"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotzdem entfernen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover mesmo assim"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのまま削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然移除"
          }
        }
      }
    },
    "Signing out removes this device's admin key. Save a backup of your account key first, or sign out anyway.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar sesión elimina la clave de administrador de este dispositivo. Guarda antes una copia de la clave de tu cuenta, o cierra sesión de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déconnecter supprime la clé d’administrateur de cet appareil. Enregistrez d’abord une sauvegarde de la clé de votre compte, ou déconnectez-vous quand même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abmelden wird der Admin-Schlüssel dieses Geräts entfernt. Sichere zuerst deinen Kontoschlüssel oder melde dich trotzdem ab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair remove a chave de administrador deste dispositivo. Salve antes um backup da chave da sua conta ou saia mesmo assim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトすると、このデバイスの管理者キーが削除されます。先にアカウントキーのバックアップを保存するか、そのままサインアウトしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录会移除此设备的管理员密钥。请先备份你的账户密钥，或仍然退出登录。"
          }
        }
      }
    },
    "Sign out anyway": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar sesión de todos modos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déconnecter quand même"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotzdem abmelden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair mesmo assim"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのままサインアウト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然退出登录"
          }
        }
      }
    },
    "Signing out removes this device's admin key. You backed up your account key, so keep that file and its passphrase safe.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar sesión elimina la clave de administrador de este dispositivo. Hiciste una copia de la clave de tu cuenta: guarda ese archivo y su frase de contraseña en un lugar seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déconnecter supprime la clé d’administrateur de cet appareil. Vous avez sauvegardé la clé de votre compte : conservez ce fichier et sa phrase secrète en lieu sûr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abmelden wird der Admin-Schlüssel dieses Geräts entfernt. Du hast deinen Kontoschlüssel gesichert – bewahre diese Datei und ihre Passphrase sicher auf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair remove a chave de administrador deste dispositivo. Você fez backup da chave da sua conta: guarde esse arquivo e a frase secreta dele em local seguro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトすると、このデバイスの管理者キーが削除されます。アカウントキーはバックアップ済みですので、そのファイルとパスフレーズを安全に保管してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录会移除此设备的管理员密钥。你已备份账户密钥，请妥善保管该文件及其密码短语。"
          }
        }
      }
    },
    "Unlock first to save your key.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea primero para guardar tu clave."
