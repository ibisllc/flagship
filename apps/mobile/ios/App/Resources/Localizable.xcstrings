    "Signed actions — disconnecting a device, rotating recovery, renaming an app URL — land here so you have one place to review your account history.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones firmadas (desconectar un dispositivo, rotar la recuperación, renombrar la URL de una app) aparecen aquí para que tengas un solo lugar donde revisar el historial de tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions signées — déconnecter un appareil, renouveler la récupération, renommer l’URL d’une app — apparaissent ici pour que vous ayez un seul endroit où consulter l’historique de votre compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signierte Aktionen – ein Gerät trennen, die Wiederherstellung rotieren, die URL einer App umbenennen – erscheinen hier, damit du den Verlauf deines Kontos an einer Stelle prüfen kannst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações assinadas — desconectar um dispositivo, girar a recuperação, renomear a URL de um app — aparecem aqui para que você tenha um só lugar para revisar o histórico da sua conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名済みの操作（デバイスの切断、リカバリーのローテーション、アプリ URL の名前変更など）がここに表示されるため、アカウント履歴を一か所で確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已签名的操作（断开设备、轮换恢复、重命名应用 URL）会显示在这里，让你在一个地方查看账户历史。"
          }
        }
      }
    },
