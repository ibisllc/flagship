    "Couldn't verify your recovery credential — your recovery backup was left unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar tu credencial de recuperación; tu copia de seguridad de recuperación quedó sin cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier votre justificatif de récupération — votre sauvegarde de récupération est restée inchangée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wiederherstellungsnachweis konnte nicht überprüft werden – dein Wiederherstellungs-Backup blieb unverändert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar sua credencial de recuperação — seu backup de recuperação ficou inalterado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリー用の認証情報を確認できなかったため、リカバリーバックアップは変更されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证你的恢复凭证；你的恢复备份保持不变。"
          }
        }
      }
    },
    "Your stored recovery backup looks corrupted — re-run recovery setup.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu copia de seguridad de recuperación guardada parece dañada: vuelve a ejecutar la configuración de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre sauvegarde de récupération enregistrée semble corrompue — relancez la configuration de la récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein gespeichertes Wiederherstellungs-Backup scheint beschädigt zu sein – führe die Wiederherstellungs-Einrichtung erneut aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu backup de recuperação salvo parece corrompido — execute de novo a configuração de recuperação."
