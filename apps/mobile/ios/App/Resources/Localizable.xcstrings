    "Your device list changed in the background. Refresh and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lista de dispositivos cambió en segundo plano. Actualiza e inténtalo de nuevo."
          }
        },
        "fr": {
