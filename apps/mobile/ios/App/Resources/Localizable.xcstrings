    "AI keys power app builds but stay on this phone. Your server sends them only to the provider; Flagship never sees them.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de IA sirven para crear apps, pero se quedan en este teléfono. Tu servidor las envía solo al proveedor; Flagship nunca las ve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés d’IA servent à créer des apps mais restent sur ce téléphone. Votre serveur ne les envoie qu’au fournisseur ; Flagship ne les voit jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Schlüssel ermöglichen App-Builds, bleiben aber auf diesem Telefon. Dein Server sendet sie nur an den Anbieter; Flagship sieht sie nie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves de IA alimentam a criação de apps, mas ficam neste celular. Seu servidor as envia apenas ao provedor; o Flagship nunca as vê."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI キーはアプリのビルドに使われますが、このスマートフォンから出ません。サーバーはプロバイダにのみ送信し、Flagship がキーを見ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 密钥用于构建应用，但只保存在这部手机上。你的服务器只会把它们发送给提供商；Flagship 绝不会看到。"
          }
        }
      }
    },
