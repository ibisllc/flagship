    "Unlocked. Tap Approve on your watch again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado. Vuelve a tocar Aprobar en tu reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillé. Touchez à nouveau Approuver sur votre montre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperrt. Tippe auf deiner Uhr noch einmal auf „Genehmigen“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueado. Toque em Aprovar no seu relógio de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック解除しました。ウォッチで「承認」をもう一度タップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已解锁。请在手表上再次点按“批准”。"
          }
        }
      }
    },
    "Your Apple Watch is waiting to approve a server's start-up. Unlock, then tap Approve on the watch again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Apple Watch espera para aprobar el arranque de un servidor. Desbloquea y vuelve a tocar Aprobar en el reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Apple Watch attend d’approuver le démarrage d’un serveur. Déverrouillez, puis touchez à nouveau Approuver sur la montre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apple Watch wartet darauf, den Start eines Servers zu genehmigen. Entsperre und tippe auf der Uhr noch einmal auf „Genehmigen“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Apple Watch está aguardando para aprovar a inicialização de um servidor. Desbloqueie e toque em Aprovar no relógio de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch がサーバーの起動を承認しようと待っています。ロックを解除してから、ウォッチで「承認」をもう一度タップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Apple Watch 正在等待批准某台服务器的启动。请解锁，然后在手表上再次点按“批准”。"
          }
        }
      }
    },
    "Your watch asked to approve %@. Unlock Flagship once so it can, then tap Approve on the watch again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reloj pidió aprobar %@. Desbloquea Flagship una vez para que pueda, y vuelve a tocar Aprobar en el reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre montre a demandé d’approuver %@. Déverrouillez Flagship une fois pour qu’elle le puisse, puis touchez à nouveau Approuver sur la montre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Uhr wollte %@ genehmigen. Entsperre Flagship einmal, damit sie das kann, und tippe auf der Uhr noch einmal auf „Genehmigen“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu relógio pediu para aprovar %@. Desbloqueie o Flagship uma vez para que ele possa, e toque em Aprovar no relógio de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチが %@ の承認を求めました。承認できるよう Flagship のロックを一度解除してから、ウォッチで「承認」をもう一度タップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手表请求批准 %@。请先解锁一次 Flagship，这样它才能批准，然后在手表上再次点按“批准”。"
          }
        }
      }
    },
    "%@'s start-up": {
