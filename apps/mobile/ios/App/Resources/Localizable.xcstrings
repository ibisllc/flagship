    },
    "Sites you've signed a browser into from this phone. They stay open for a while, then expire on their own. Stop one anytime.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitios en los que has iniciado sesión desde un navegador con este teléfono. Siguen abiertos un tiempo y caducan solos. Detén uno cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites où vous avez connecté un navigateur depuis ce téléphone. Ils restent ouverts un certain temps, puis expirent d’eux-mêmes. Arrêtez-en un à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Websites, bei denen du von diesem Telefon aus einen Browser angemeldet hast. Sie bleiben eine Weile offen und laufen dann von selbst ab. Beende eine Sitzung jederzeit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites em que você conectou um navegador a partir deste celular. Eles ficam abertos por um tempo e depois expiram sozinhos. Pare um a qualquer momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンからブラウザーでサインインしたサイトです。しばらく開いたままになり、その後自動的に失効します。いつでも停止できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你通过这部手机在浏览器中登录过的网站。它们会保持一段时间，然后自动过期。你可以随时停止其中任何一个。"
          }
        }
      }
    },
    "Stop session": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
