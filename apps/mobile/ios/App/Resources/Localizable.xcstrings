    "This server's release can't hand out the backup as one file yet. Update the server and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de este servidor aún no puede entregar la copia como un solo archivo. Actualiza el servidor e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
