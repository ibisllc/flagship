{
  "sourceLanguage": "en",
  "strings": {
    "This device has no screen lock set up.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene bloqueo de pantalla configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de verrouillage d’écran configuré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist keine Bildschirmsperre eingerichtet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem bloqueio de tela configurado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスには画面ロックが設定されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备未设置屏幕锁。"
          }
        }
      }
    },
    "Unlock was cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló el desbloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déverrouillage a été annulé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entsperren wurde abgebrochen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desbloqueio foi cancelado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック解除がキャンセルされました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁已取消。"
          }
        }
      }
    },
    "Unlock was interrupted. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se interrumpió el desbloqueo. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déverrouillage a été interrompu. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entsperren wurde unterbrochen. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desbloqueio foi interrompido. Tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック解除が中断されました。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁被中断。请重试。"
          }
        }
      }
    },
    "Too many failed attempts. Unlock your device with its passcode, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos fallidos. Desbloquea tu dispositivo con su código y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives échouées. Déverrouillez votre appareil avec son code, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Fehlversuche. Entsperre dein Gerät mit seinem Code und versuche es dann erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas malsucedidas. Desbloqueie seu dispositivo com o código dele e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗が多すぎます。デバイスをパスコードでロック解除してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败次数过多。请先用设备密码解锁设备，然后再试。"
          }
        }
      }
    },
    "That didn't match. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No coincide. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne correspond pas. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nicht gepasst. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conferiu. Tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致しませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不匹配。请重试。"
          }
        }
      }
    },
    "Unlock didn't work. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desbloqueo no funcionó. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déverrouillage n’a pas fonctionné. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entsperren hat nicht funktioniert. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desbloqueio não funcionou. Tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック解除できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁未成功。请重试。"
          }
        }
      }
    },
    "This device doesn't hold your account key yet.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo aún no tiene la clave de tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne détient pas encore la clé de votre compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hält deinen Kontoschlüssel noch nicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo ainda não tem a chave da sua conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはまだアカウントキーがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备尚未持有你的账户密钥。"
          }
        }
      }
    },
    "This device couldn't confirm it was you. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no pudo confirmar que eras tú. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas pu confirmer que c’était bien vous. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät konnte nicht bestätigen, dass du es warst. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não conseguiu confirmar que era você. Tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは、ご本人かどうか確認できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法确认是你本人。请重试。"
          }
        }
      }
    },
    "Your account key couldn't be read on this device. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la clave de tu cuenta en este dispositivo. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de votre compte n’a pas pu être lue sur cet appareil. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kontoschlüssel konnte auf diesem Gerät nicht gelesen werden. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a chave da sua conta neste dispositivo. Tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではアカウントキーを読み取れませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此设备上读取你的账户密钥。请重试。"
          }
        }
      }
    },
