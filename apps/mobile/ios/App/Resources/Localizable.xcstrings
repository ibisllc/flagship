            "value": "%@ démarre. Le déverrouiller ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ startet. Entsperren?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está iniciando. Desbloquear?"
          }
        },
        "ja": {
