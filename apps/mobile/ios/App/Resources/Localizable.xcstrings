    "Downloaded. The server has removed its copy. Save the file: to Files (a folder on this phone, iCloud Drive or a USB drive), or AirDrop it to a computer.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargado. El servidor ha eliminado su copia. Guarda el archivo en Archivos (una carpeta de este teléfono, iCloud Drive o una unidad USB), o envíalo por AirDrop a un ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargé. Le serveur a supprimé sa copie. Enregistrez le fichier dans Fichiers (un dossier de ce téléphone, iCloud Drive ou une clé USB), ou envoyez-le par AirDrop vers un ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladen. Der Server hat seine Kopie entfernt. Speichere die Datei in Dateien (ein Ordner auf diesem Telefon, iCloud Drive oder ein USB-Stick) oder sende sie per AirDrop an einen Computer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixado. O servidor removeu a cópia dele. Salve o arquivo em Arquivos (uma pasta neste celular, o iCloud Drive ou um pen drive) ou envie por AirDrop para um computador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしました。サーバーはコピーを削除しました。ファイルは「ファイル」（このスマートフォン内のフォルダ、iCloud Drive、USB ドライブ）に保存するか、AirDrop でパソコンへ送ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载。服务器已删除其副本。请把文件保存到“文件”中（这部手机上的文件夹、iCloud 云盘或 U 盘），或通过隔空投送发到电脑。"
          }
        }
      }
    },
