    "The server's disk is full: apps' folders are read-only until there's room.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco del servidor está lleno: las carpetas de las apps son de solo lectura hasta que haya espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque du serveur est plein : les dossiers des apps sont en lecture seule tant qu’il n’y a pas de place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datenträger des Servers ist voll: Die Ordner der Apps sind schreibgeschützt, bis wieder Platz ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco do servidor está cheio: as pastas dos apps ficam somente leitura até haver espaço."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのディスクがいっぱいです。空きができるまで、アプリのフォルダーは読み取り専用になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器磁盘已满：在有空间之前，应用的文件夹为只读。"
          }
        }
      }
    },
    "The server's disk is nearly full: apps can't save more until there's room.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco del servidor está casi lleno: las apps no pueden guardar más hasta que haya espacio."
