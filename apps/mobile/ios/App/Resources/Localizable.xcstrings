    },
    "No sealed disk key is on file for this box yet.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay una clave de disco sellada guardada para este equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé de disque scellée n’est encore enregistrée pour ce boîtier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Box liegt noch kein versiegelter Datenträgerschlüssel vor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há uma chave de disco selada registrada para esta caixa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボックスには、封印されたディスクキーがまだ保存されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主机尚未保存密封的磁盘密钥。"
          }
        }
      }
    },
    "Couldn't unseal the disk key with this phone's keys.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desellar la clave del disco con las claves de este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de desceller la clé du disque avec les clés de ce téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datenträgerschlüssel ließ sich mit den Schlüsseln dieses Telefons nicht entsiegeln."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir a chave do disco com as chaves deste celular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンの鍵では、ディスクキーの封印を解けませんでした。"
          }
        },
