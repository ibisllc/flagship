    "Your computer's builder has the recipe. Pick the USB drive and any Advanced options on the computer; nothing more is needed from your phone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El creador de tu ordenador ya tiene la receta. Elige la unidad USB y las opciones avanzadas en el ordenador; tu teléfono no tiene que hacer nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le créateur de votre ordinateur a la recette. Choisissez la clé USB et les options avancées sur l’ordinateur ; plus rien n’est nécessaire de votre téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Builder auf deinem Computer hat das Rezept. Wähle den USB-Stick und alle erweiterten Optionen am Computer aus; von deinem Telefon ist nichts weiter nötig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O criador do seu computador já tem a receita. Escolha o pen drive e as opções avançadas no computador; nada mais é necessário do seu celular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのパソコンのビルダーにレシピが届きました。USB ドライブと詳細オプションはパソコン側で選んでください。スマートフォンでの操作はもう必要ありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你电脑上的构建器已收到配方。请在电脑上选择 U 盘和高级选项；手机无需再做任何操作。"
          }
        }
      }
    },
    "Pairing failed": {
