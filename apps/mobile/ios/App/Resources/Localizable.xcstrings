    "Fetching your account key and restoring access on this device.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obteniendo la clave de tu cuenta y restaurando el acceso en este dispositivo."
          }
        },
        "fr": {
