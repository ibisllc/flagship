    },
    "We couldn't find your recovery passkey on this device. Make sure you're signed in to the same iCloud account with iCloud Keychain on, or use Import backup file below.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontramos tu llave de acceso de recuperación en este dispositivo. Comprueba que has iniciado sesión en la misma cuenta de iCloud con el llavero de iCloud activado, o usa Importar archivo de copia de seguridad más abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas trouvé votre clé d’accès de récupération sur cet appareil. Vérifiez que vous êtes connecté au même compte iCloud avec le Trousseau iCloud activé, ou utilisez Importer un fichier de sauvegarde ci-dessous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben deinen Wiederherstellungs-Passkey auf diesem Gerät nicht gefunden. Stelle sicher, dass du beim selben iCloud-Konto mit aktivem iCloud-Schlüsselbund angemeldet bist, oder nutze unten „Backup-Datei importieren“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontramos sua passkey de recuperação neste dispositivo. Verifique se você está conectado à mesma conta do iCloud com o Chaveiro do iCloud ativado, ou use Importar arquivo de backup abaixo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでリカバリーパスキーが見つかりませんでした。同じ iCloud アカウントで iCloud キーチェーンをオンにしてサインインしているか確認するか、下の「バックアップファイルを読み込む」を使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们在此设备上找不到你的恢复通行密钥。请确认你已登录同一个 iCloud 账户并开启了 iCloud 钥匙串，或使用下方的“导入备份文件”。"
          }
        }
      }
    },
    "Authorize takeover": {
      "extractionState": "manual",
      "localizations": {
