          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时将此设备设为管理员"
          }
        }
      }
    },
    "Scanned — now compare the codes.": {
      "extractionState": "manual",
      "localizations": {
