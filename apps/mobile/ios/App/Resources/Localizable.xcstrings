    "Print these or store them in a password manager. Each code works once if you lose your authenticator. They're the ONLY way back in.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprímelos o guárdalos en un gestor de contraseñas. Cada código sirve una sola vez si pierdes tu autenticador. Son la ÚNICA forma de volver a entrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprimez-les ou conservez-les dans un gestionnaire de mots de passe. Chaque code ne fonctionne qu’une fois si vous perdez votre authentificateur. Ce sont le SEUL moyen de revenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drucke sie aus oder speichere sie in einem Passwortmanager. Jeder Code funktioniert einmal, falls du deinen Authenticator verlierst. Sie sind der EINZIGE Weg zurück."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprima-os ou guarde-os em um gerenciador de senhas. Cada código funciona uma vez se você perder seu autenticador. Eles são a ÚNICA forma de voltar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印刷するか、パスワードマネージャーに保管してください。認証アプリを失った場合、各コードは 1 回だけ使えます。再びサインインする唯一の手段です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打印它们，或存放在密码管理器中。如果你丢失了验证器，每个代码可使用一次。它们是你重新登录的唯一途径。"
          }
        }
      }
    },
