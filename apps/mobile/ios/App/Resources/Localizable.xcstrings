    "Computers you've docked a browser from. They can manage this account for a few hours, then expire.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenadores desde los que has conectado un navegador. Pueden gestionar esta cuenta durante unas horas y luego caducan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinateurs depuis lesquels vous avez connecté un navigateur. Ils peuvent gérer ce compte pendant quelques heures, puis expirent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer, von denen aus du einen Browser angedockt hast. Sie können dieses Konto einige Stunden lang verwalten und laufen dann ab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Computadores a partir dos quais você conectou um navegador. Eles podem gerenciar esta conta por algumas horas e depois expiram."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザーを接続したパソコンの一覧です。数時間のあいだこのアカウントを管理でき、その後は失効します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你曾用来对接浏览器的电脑。它们可以管理此账户几个小时，之后会过期。"
          }
        }
      }
    },
