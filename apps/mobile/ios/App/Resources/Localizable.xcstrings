            "state": "translated",
            "value": "接管 %@"
          }
        }
      }
    },
    "Scan a transfer code first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea primero un código de transferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez d’abord un code de transfert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne zuerst einen Übertragungscode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie primeiro um código de transferência."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に移管コードをスキャンしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先扫描转移代码。"
          }
        }
      }
    },
    "Couldn't reach the broker. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con el intermediario. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le courtier. Vérifiez votre connexion et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Broker ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar o broker. Verifique sua conexão e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブローカーに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接代理。请检查网络连接后重试。"
          }
        }
      }
    },
    "Transfer %@ to another account": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferir %@ a otra cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transférer %@ vers un autre compte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auf ein anderes Konto übertragen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferir %@ para outra conta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を別のアカウントに移管"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 %@ 转移到另一个账户"
          }
        }
      }
    },
    "Hand off admin of %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traspasar la administración de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmettre l’administration de %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Admin-Rechte für %@ übergeben"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferir a administração de %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の管理者権限を引き継ぐ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移交 %@ 的管理员权限"
          }
        }
      }
    },
    "Ownership moved, but the disk key re-seal failed: %@. The new owner can retry from their device.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propiedad se movió, pero falló el resellado de la clave del disco: %@. El nuevo propietario puede reintentarlo desde su dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La propriété a été transférée, mais le rescellement de la clé de disque a échoué : %@. Le nouveau propriétaire peut réessayer depuis son appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Eigentum wurde übertragen, aber das erneute Versiegeln des Datenträgerschlüssels ist fehlgeschlagen: %@. Der neue Eigentümer kann es von seinem Gerät aus erneut versuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A propriedade foi transferida, mas o novo selamento da chave de disco falhou: %@. O novo proprietário pode tentar de novo do dispositivo dele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有権は移りましたが、ディスクキーの再封印に失敗しました：%@。新しい所有者は自分のデバイスから再試行できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有权已转移，但磁盘密钥重新密封失败：%@。新所有者可以从其设备重试。"
          }
        }
      }
    },
    "Ownership moved, but the admin hand-off failed: %@. The new owner's server will wait for this hand-off before re-homing while it has a pinned admin key — retry the transfer hand-off from this device.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propiedad se movió, pero falló el traspaso de administración: %@. El servidor del nuevo propietario esperará este traspaso antes de reubicarse mientras tenga una clave de administrador fijada: reintenta el traspaso desde este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La propriété a été transférée, mais la transmission de l’administration a échoué : %@. Le serveur du nouveau propriétaire attendra cette transmission avant de se réinstaller tant qu’il a une clé d’administrateur épinglée — relancez la transmission depuis cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Eigentum wurde übertragen, aber die Übergabe der Admin-Rechte ist fehlgeschlagen: %@. Der Server des neuen Eigentümers wartet auf diese Übergabe, bevor er umzieht, solange er einen angehefteten Admin-Schlüssel hat – wiederhole die Übergabe von diesem Gerät aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A propriedade foi transferida, mas a transferência da administração falhou: %@. O servidor do novo proprietário aguardará essa transferência antes de ser realocado enquanto tiver uma chave de administrador fixada — tente a transferência de novo deste dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有権は移りましたが、管理者権限の引き継ぎに失敗しました：%@。管理者キーが固定されている間、新しい所有者のサーバーはこの引き継ぎを待ってから再配置されます。このデバイスから引き継ぎを再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有权已转移，但管理员权限移交失败：%@。只要新所有者的服务器仍固定着管理员密钥，它就会等待此移交完成后才迁移：请从此设备重试移交。"
          }
        }
      }
    },
    "Ownership moved, but the re-home authorization failed: %@. The new owner's server will wait for this authorization before re-homing — retry the transfer hand-off from this device.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propiedad se movió, pero falló la autorización de reubicación: %@. El servidor del nuevo propietario esperará esta autorización antes de reubicarse: reintenta el traspaso desde este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La propriété a été transférée, mais l’autorisation de réinstallation a échoué : %@. Le serveur du nouveau propriétaire attendra cette autorisation avant de se réinstaller — relancez la transmission depuis cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Eigentum wurde übertragen, aber die Umzugsautorisierung ist fehlgeschlagen: %@. Der Server des neuen Eigentümers wartet auf diese Autorisierung, bevor er umzieht – wiederhole die Übergabe von diesem Gerät aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A propriedade foi transferida, mas a autorização de realocação falhou: %@. O servidor do novo proprietário aguardará essa autorização antes de ser realocado — tente a transferência de novo deste dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有権は移りましたが、再配置の承認に失敗しました：%@。新しい所有者のサーバーは、この承認を待ってから再配置されます。このデバイスから引き継ぎを再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有权已转移，但迁移授权失败：%@。新所有者的服务器会等待此授权完成后才会迁移：请从此设备重试移交。"
          }
        }
      }
    },
    "Transfer server": {
      "extractionState": "manual",
      "localizations": {
