    "Waiting for this server to report its current version — it can't be updated in place until it does.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que este servidor informe de su versión actual; hasta entonces no se puede actualizar en el sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente que ce serveur signale sa version actuelle — il ne peut pas être mis à jour sur place tant qu’il ne l’a pas fait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte darauf, dass dieser Server seine aktuelle Version meldet – bis dahin lässt er sich nicht direkt aktualisieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
