        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo nuevo se unió como par y está en una ventana de revisión de 14 días. Te recordaremos que revises tus dispositivos de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouvel appareil a rejoint en tant que pair et se trouve dans une fenêtre de contrôle de 14 jours. Un rappel vous invitera à vérifier vos appareils de confiance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das neue Gerät ist als Peer beigetreten und befindet sich in einem 14-tägigen Prüfzeitraum. Du wirst erinnert, deine vertrauenswürdigen Geräte zu prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo dispositivo entrou como par e está em uma janela de revisão de 14 dias. Você receberá lembretes para verificar seus dispositivos confiáveis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいデバイスはピアとして参加し、14 日間の確認期間中です。信頼済みデバイスを確認するようリマインダーが届きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新设备已作为对等设备加入，处于 14 天的审查期。我们会提醒你检查受信任的设备。"
          }
        }
      }
    },
