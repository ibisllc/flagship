    "Another device on this account ran Disconnect, Replace, or Wipe. Sign in again with your recovery passkey to get back in.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro dispositivo de esta cuenta ejecutó Desconectar, Reemplazar o Borrar. Vuelve a iniciar sesión con tu llave de acceso de recuperación para volver a entrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre appareil de ce compte a exécuté Déconnecter, Remplacer ou Effacer. Reconnectez-vous avec votre clé d’accès de récupération pour y retourner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Gerät dieses Kontos hat Trennen, Ersetzen oder Löschen ausgeführt. Melde dich mit deinem Wiederherstellungs-Passkey erneut an, um wieder hineinzukommen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro dispositivo desta conta executou Desconectar, Substituir ou Apagar. Entre de novo com sua passkey de recuperação para voltar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの別のデバイスで「切断」「置き換え」「消去」が実行されました。リカバリーパスキーで再度サインインして戻ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户上的另一台设备执行了断开、替换或擦除。请使用恢复通行密钥重新登录以回到账户。"
          }
        }
      }
    },
