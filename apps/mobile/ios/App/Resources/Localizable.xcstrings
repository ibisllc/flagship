        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque du serveur est presque plein : les apps ne peuvent plus enregistrer tant qu’il n’y a pas de place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datenträger des Servers ist fast voll: Apps können nichts mehr speichern, bis wieder Platz ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco do servidor está quase cheio: os apps não conseguem salvar mais nada até haver espaço."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのディスクがほぼいっぱいです。空きができるまで、アプリはこれ以上保存できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器磁盘快满了：在有空间之前，应用无法保存更多内容。"
          }
        }
      }
    },
    "%@ is full: new data is refused until you free space or raise the limit.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está lleno: se rechazan datos nuevos hasta que liberes espacio o aumentes el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est plein : les nouvelles données sont refusées tant que vous ne libérez pas d’espace ou n’augmentez pas la limite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist voll: Neue Daten werden abgelehnt, bis du Platz schaffst oder das Limit erhöhst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está cheio: novos dados são recusados até você liberar espaço ou aumentar o limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がいっぱいです。空き容量を確保するか上限を引き上げるまで、新しいデータは拒否されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已满：在你释放空间或提高上限之前，新数据会被拒绝。"
          }
        }
      }
    },
    "No health report for %@ min. The server itself may be off or frozen.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay informe de estado desde hace %@ min. Puede que el servidor esté apagado o bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun rapport d’état depuis %@ min. Le serveur est peut-être éteint ou bloqué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit %@ Min. kein Statusbericht. Der Server ist möglicherweise aus oder hängt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem relatório de saúde há %@ min. O próprio servidor pode estar desligado ou travado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 分間、ヘルスレポートがありません。サーバー自体が停止しているか、フリーズしている可能性があります。"
