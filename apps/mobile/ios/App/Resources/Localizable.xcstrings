    "Update to %@ sent %@. The server picks it up within about five minutes, restarts, and goes back on its own if the new version doesn't start.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualización a %@ enviada %@. El servidor la recoge en unos cinco minutos, se reinicia y vuelve atrás por sí solo si la nueva versión no arranca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour vers %@ envoyée %@. Le serveur la récupère en cinq minutes environ, redémarre, et revient en arrière tout seul si la nouvelle version ne démarre pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Update auf %@ %@ gesendet. Der Server holt es innerhalb von etwa fünf Minuten ab, startet neu und geht von selbst zurück, falls die neue Version nicht startet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualização para %@ enviada %@. O servidor a recebe em cerca de cinco minutos, reinicia e volta sozinho se a nova versão não iniciar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ へのアップデートを %@ に送信しました。サーバーは約 5 分以内に受け取って再起動し、新しいバージョンが起動しない場合は自動的に元に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已 %2$@ 发送更新到 %1$@。服务器会在大约五分钟内获取并重启；如果新版本无法启动，会自行回退。"
          }
        }
      }
    },
