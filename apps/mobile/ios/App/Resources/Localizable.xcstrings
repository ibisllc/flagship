    "Let scripts, devices and other servers call this app. Each key works until you revoke it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que scripts, dispositivos y otros servidores llamen a esta app. Cada clave funciona hasta que la revocas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettez à des scripts, appareils et autres serveurs d’appeler cette app. Chaque clé fonctionne jusqu’à sa révocation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Skripten, Geräten und anderen Servern, diese App aufzurufen. Jeder Schlüssel funktioniert, bis du ihn widerrufst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que scripts, dispositivos e outros servidores chamem este app. Cada chave funciona até você revogá-la."
          }
        },
