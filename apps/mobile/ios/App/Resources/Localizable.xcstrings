          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules ces %lld personnes pourront l’ouvrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diese %lld Personen können sie öffnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente estas %lld pessoas poderão abri-la."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開けるのはこの %lld 人だけになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有这 %lld 个人能打开它。"
          }
        }
      }
    },
    "Removed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retiré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Removido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除。"
          }
        }
      }
    },
    "Everyone who joined through this link loses access, unless they were also invited another way.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las personas que se unieron con este enlace pierden el acceso, salvo que las hayan invitado también de otra forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les personnes qui ont rejoint via ce lien perdent l’accès, sauf si elles ont aussi été invitées autrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, die über diesen Link beigetreten sind, verlieren den Zugriff, sofern sie nicht auch auf anderem Weg eingeladen wurden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as pessoas que entraram por este link perdem o acesso, a menos que também tenham sido convidadas de outra forma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクから参加した全員がアクセスを失います（別の方法でも招待されている場合を除く）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过此链接加入的所有人都会失去访问权限，除非他们还通过其他方式被邀请过。"
          }
        }
      }
    },
    "Everyone who joined through this link loses their rank and can still visit as anyone can.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las personas que se unieron con este enlace pierden su rango y siguen pudiendo visitar como cualquiera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les personnes qui ont rejoint via ce lien perdent leur rang et peuvent toujours visiter comme n’importe qui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, die über diesen Link beigetreten sind, verlieren ihren Rang und können weiterhin wie jeder andere besuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as pessoas que entraram por este link perdem o nível e ainda podem visitar como qualquer pessoa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクから参加した全員がランクを失いますが、一般の訪問者としては引き続きアクセスできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过此链接加入的所有人都会失去等级，但仍可像任何人一样访问。"
          }
        }
      }
    },
    "They're signed out and kept out. You can invite them again later.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se les cierra la sesión y se les deja fuera. Puedes volver a invitarlas más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles sont déconnectées et tenues à l’écart. Vous pourrez les inviter à nouveau plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden abgemeldet und ausgesperrt. Du kannst sie später erneut einladen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elas são desconectadas e mantidas de fora. Você pode convidá-las de novo depois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトされ、アクセスできなくなります。後でもう一度招待することもできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他们会被登出并拒之门外。你以后可以再次邀请他们。"
          }
        }
      }
    },
    "They lose their rank and can still visit as anyone can. You can invite them again later.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierden su rango y siguen pudiendo visitar como cualquiera. Puedes volver a invitarlas más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles perdent leur rang et peuvent toujours visiter comme n’importe qui. Vous pourrez les inviter à nouveau plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verlieren ihren Rang und können weiterhin wie jeder andere besuchen. Du kannst sie später erneut einladen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elas perdem o nível e ainda podem visitar como qualquer pessoa. Você pode convidá-las de novo depois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランクを失いますが、一般の訪問者としては引き続きアクセスできます。後でもう一度招待することもできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他们会失去等级，但仍可像任何人一样访问。你以后可以再次邀请他们。"
          }
        }
      }
    },
