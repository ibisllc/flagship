    "The new version replaces the one running now. Its address, data and the people who can open it stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión nueva sustituye a la que se está ejecutando. Su dirección, sus datos y las personas que pueden abrirla siguen igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle version remplace celle qui s’exécute actuellement. Son adresse, ses données et les personnes qui peuvent l’ouvrir restent les mêmes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Version ersetzt die aktuell laufende. Adresse, Daten und die Personen, die sie öffnen können, bleiben gleich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova versão substitui a que está em execução. O endereço, os dados e as pessoas que podem abri-la continuam os mesmos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンが現在実行中のものと置き換わります。アドレス、データ、開ける人は変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本会替换当前运行的版本。它的地址、数据以及能打开它的人都保持不变。"
          }
        }
      }
    },
    "What should change?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué debe cambiar?"
          }
        },
        "fr": {
