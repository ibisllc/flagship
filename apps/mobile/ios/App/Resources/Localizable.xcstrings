          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez enregistré une sauvegarde de vos serveurs, vous pouvez la restaurer dans un nouveau compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
