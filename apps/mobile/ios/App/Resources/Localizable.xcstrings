    "Keep this screen open. If it stops, it picks up where it left off.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén esta pantalla abierta. Si se detiene, continúa donde lo dejó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez cet écran ouvert. S’il s’arrête, l’envoi reprend là où il s’était arrêté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass diesen Bildschirm geöffnet. Stoppt er, macht er dort weiter, wo er aufgehört hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha esta tela aberta. Se parar, ele continua de onde parou."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面を開いたままにしてください。中断しても、続きから再開します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
