    "Your admin key was rotated, but saving it on this device failed. Recover on this device to finish. (%@)": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave de administrador se rotó, pero no se pudo guardar en este dispositivo. Haz una recuperación en este dispositivo para terminar. (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé d’administrateur a été renouvelée, mais son enregistrement sur cet appareil a échoué. Lancez une récupération sur cet appareil pour terminer. (%@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Admin-Schlüssel wurde rotiert, aber das Speichern auf diesem Gerät ist fehlgeschlagen. Führe auf diesem Gerät eine Wiederherstellung durch, um abzuschließen. (%@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave de administrador foi girada, mas não foi possível salvá-la neste dispositivo. Faça uma recuperação neste dispositivo para concluir. (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者キーはローテーションされましたが、このデバイスへの保存に失敗しました。完了するには、このデバイスで復旧してください。（%@）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的管理员密钥已轮换，但在此设备上保存失败。请在此设备上恢复以完成。（%@）"
          }
        }
      }
