    "Your accounts and servers are unchanged and nothing has been deleted. Flagship is paused on this device until you update.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cuentas y servidores no han cambiado y no se ha borrado nada. Flagship queda en pausa en este dispositivo hasta que actualices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos comptes et vos serveurs sont inchangés et rien n’a été supprimé. Flagship est en pause sur cet appareil jusqu’à ce que vous mettiez à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Konten und Server sind unverändert, und nichts wurde gelöscht. Flagship ist auf diesem Gerät pausiert, bis du aktualisierst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas contas e servidores não foram alterados e nada foi excluído. O Flagship fica em pausa neste dispositivo até você atualizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとサーバーは変更されておらず、何も削除されていません。アップデートするまで、このデバイスでは Flagship は一時停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户和服务器没有任何变化，也没有删除任何内容。在你更新之前，Flagship 在此设备上处于暂停状态。"
          }
        }
      }
    },
