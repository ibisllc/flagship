        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sécurisez votre compte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto absichern"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja sua conta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを保護"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护你的账户"
          }
        }
      }
    },
    "Without a backup, losing this device means losing your account for good. You can set this up anytime in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin copia de seguridad, perder este dispositivo significa perder tu cuenta para siempre. Puedes configurarlo cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans sauvegarde, perdre cet appareil signifie perdre définitivement votre compte. Vous pouvez la configurer à tout moment dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Backup bedeutet der Verlust dieses Geräts, dein Konto für immer zu verlieren. Du kannst das jederzeit in den Einstellungen einrichten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem backup, perder este dispositivo significa perder sua conta para sempre. Você pode configurar isso a qualquer momento em Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップがないと、このデバイスを紛失した時点でアカウントは完全に失われます。「設定」からいつでも設定できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有备份的话，丢失此设备就意味着永久失去你的账户。你可以随时在“设置”中进行设置。"
          }
        }
      }
    },
    "Backing up…": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiando…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere …"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazendo backup…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在备份…"
          }
        }
      }
    },
    "Back up your account now so you can get back in if you lose this device. No one — not even us — can recover it for you.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz ahora una copia de tu cuenta para poder volver a entrar si pierdes este dispositivo. Nadie, ni siquiera nosotros, puede recuperarla por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardez votre compte dès maintenant pour pouvoir y revenir si vous perdez cet appareil. Personne — pas même nous — ne peut le récupérer à votre place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere dein Konto jetzt, damit du wieder hineinkommst, falls du dieses Gerät verlierst. Niemand – auch wir nicht – kann es für dich wiederherstellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça backup da sua conta agora para poder voltar se perder este dispositivo. Ninguém — nem nós — pode recuperá-la por você."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまアカウントをバックアップして、このデバイスを紛失しても戻れるようにしましょう。誰も、私たちでさえも、代わりに復旧することはできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在就备份你的账户，这样即使丢失此设备也能重新进入。没有人（包括我们）能替你恢复它。"
          }
        }
      }
    },
    "Back up to iCloud": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer copia en iCloud"
          }
