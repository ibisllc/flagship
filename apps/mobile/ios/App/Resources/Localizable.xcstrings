    "This server self-unlocks its encrypted disk after a reboot — no phone needed. flagshipserver.com only ever holds a key it can't read.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor desbloquea solo su disco cifrado tras un reinicio, sin necesidad del teléfono. flagshipserver.com solo guarda una clave que no puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur déverrouille tout seul son disque chiffré après un redémarrage, sans téléphone. flagshipserver.com ne détient qu’une clé qu’il ne peut pas lire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server entsperrt seinen verschlüsselten Datenträger nach einem Neustart selbst, ohne Telefon. flagshipserver.com hält nur einen Schlüssel, den es nicht lesen kann."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor desbloqueia sozinho o disco criptografado depois de um reinício, sem precisar do celular. O flagshipserver.com guarda apenas uma chave que não consegue ler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは、再起動後に暗号化ディスクを自動でロック解除します。スマートフォンは不要です。flagshipserver.com が保持するのは、読み取れない鍵だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器重启后会自行解锁其加密磁盘，无需手机。flagshipserver.com 只保管一把它无法读取的密钥。"
          }
        }
      }
    },
    "Disabling…": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivando…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivation…"
          }
        },
        "de": {
