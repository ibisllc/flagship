    "This hands %@ and ALL its contents to another account. You will lose control of it. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto entrega %@ y TODO su contenido a otra cuenta. Perderás el control. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remet %@ et TOUT son contenu à un autre compte. Vous en perdrez le contrôle. Irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden %@ und ALLE seine Inhalte an ein anderes Konto übergeben. Du verlierst die Kontrolle darüber. Das lässt sich nicht rückgängig machen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso entrega %@ e TODO o conteúdo dele a outra conta. Você perderá o controle. Não pode ser desfeito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ とそのすべての内容を別のアカウントに引き渡します。あなたは管理できなくなります。元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会把 %@ 及其所有内容交给另一个账户。你将失去对它的控制，且无法撤销。"
          }
        }
      }
    },
    "Type the server's address to confirm:": {
      "extractionState": "manual",
      "localizations": {
