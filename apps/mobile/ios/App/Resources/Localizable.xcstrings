            "value": "关闭"
          }
        }
      }
    },
    "Removes your authenticator and recovery codes. Recovery goes back to a 3-day wait. Refused while other trusted devices exist.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tu autenticador y los códigos de recuperación. La recuperación vuelve a una espera de 3 días. Se rechaza mientras existan otros dispositivos de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime votre authentificateur et vos codes de récupération. La récupération revient à 3 jours d’attente. Refusé tant que d’autres appareils de confiance existent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt deinen Authenticator und die Wiederherstellungscodes. Die Wiederherstellung geht zurück auf 3 Tage Wartezeit. Wird abgelehnt, solange andere vertrauenswürdige Geräte existieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove seu autenticador e os códigos de recuperação. A recuperação volta a uma espera de 3 dias. Recusado enquanto existirem outros dispositivos confiáveis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリとリカバリーコードを削除します。リカバリーは 3 日間の待機に戻ります。他の信頼済みデバイスがある間は実行できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除你的验证器和恢复代码。恢复将回到等待 3 天。只要还有其他受信任的设备，此操作就会被拒绝。"
          }
        }
      }
    },
    "Code protection is on": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La protección con código está activada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La protection par code est activée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
