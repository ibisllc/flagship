    "The server keeps waiting for its backup. Pick the backup again from Home to send it, or delete the server there.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor sigue esperando su copia de seguridad. Elige la copia de nuevo desde Inicio para enviarla, o elimina el servidor allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur continue d’attendre sa sauvegarde. Choisissez à nouveau la sauvegarde depuis l’accueil pour l’envoyer, ou supprimez le serveur à cet endroit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wartet weiter auf sein Backup. Wähle das Backup auf dem Startbildschirm erneut aus, um es zu senden, oder lösche den Server dort."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor continua aguardando o backup. Escolha o backup de novo no Início para enviá-lo, ou exclua o servidor lá."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはバックアップを待ち続けています。ホームからもう一度バックアップを選んで送信するか、そこでサーバーを削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器仍在等待其备份。请在主页重新选择备份来发送，或在那里删除该服务器。"
          }
        }
      }
    },
    "Download a backup in a browser?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descargar una copia de seguridad en un navegador?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
