    "This approval was for a different server. Open the app from the server it runs on and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aprobación era para otro servidor. Abre la app desde el servidor en el que se ejecuta e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette approbation était destinée à un autre serveur. Ouvrez l’app depuis le serveur sur lequel elle s’exécute et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Genehmigung galt für einen anderen Server. Öffne die App von dem Server, auf dem sie läuft, und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aprovação era para outro servidor. Abra o app a partir do servidor em que ele executa e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この承認は別のサーバー向けのものでした。アプリが動いているサーバーから開いて、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此批准是针对另一台服务器的。请从应用所运行的服务器打开它，然后重试。"
          }
        }
      }
    },
    "The server didn't accept your signature. Only the account owner's phone can allow this.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
