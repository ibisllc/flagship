    "Review writes sent by docked browsers. Your phone signs approved requests; browsers never receive your account key.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las escrituras enviadas por navegadores conectados. Tu teléfono firma las solicitudes aprobadas; los navegadores nunca reciben la clave de tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez les écritures envoyées par les navigateurs reliés. Votre téléphone signe les demandes approuvées ; les navigateurs ne reçoivent jamais la clé de votre compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe Schreibvorgänge, die von verbundenen Browsern gesendet wurden. Dein Telefon signiert genehmigte Anfragen; Browser erhalten nie deinen Kontoschlüssel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise as gravações enviadas por navegadores conectados. Seu celular assina as solicitações aprovadas; os navegadores nunca recebem a chave da sua conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続されたブラウザーから送られた書き込みを確認します。承認したリクエストはスマートフォンが署名し、ブラウザーにアカウントキーが渡ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审阅已对接的浏览器发来的写入请求。已批准的请求由你的手机签名；浏览器永远拿不到你的账户密钥。"
          }
        }
      }
    },
