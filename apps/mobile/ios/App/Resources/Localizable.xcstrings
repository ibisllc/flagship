    "Off. Turn it on to let one SSH key into this server as the debug user for a while.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. Actívalo para dejar entrar durante un tiempo a una clave SSH en este servidor como usuario de depuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé. Activez-le pour autoriser une clé SSH à se connecter à ce serveur comme utilisateur de débogage pendant un certain temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus. Schalte es ein, um für eine Weile einen SSH-Schlüssel als Debug-Benutzer auf diesen Server zu lassen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado. Ative para deixar uma chave SSH entrar neste servidor como usuário de depuração por um tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフです。オンにすると、一定期間、1 つの SSH キーがデバッグユーザーとしてこのサーバーに接続できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭。开启后，可让一个 SSH 密钥在一段时间内以调试用户身份登录此服务器。"
          }
        }
      }
    },
