    "Bring this device into your account using its backup key file. You'll need the file and its passphrase.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpora este dispositivo a tu cuenta con su archivo de clave de copia de seguridad. Necesitarás el archivo y su frase de contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rattachez cet appareil à votre compte avec son fichier de clé de sauvegarde. Vous aurez besoin du fichier et de sa phrase secrète."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dieses Gerät mit seiner Backup-Schlüsseldatei in dein Konto auf. Du brauchst die Datei und ihre Passphrase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga este dispositivo para a sua conta usando o arquivo de chave de backup dela. Você precisará do arquivo e da frase secreta dele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップのキーファイルを使って、このデバイスをアカウントに追加します。ファイルとそのパスフレーズが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用备份密钥文件把此设备加入你的账户。你需要该文件及其密码短语。"
          }
        }
      }
    },
