          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gerät zu deinem Flagship-Konto hinzufügen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar um dispositivo à sua conta Flagship"
          }
        },
        "ja": {
