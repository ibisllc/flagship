    "%@ is starting. Unlock it?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se está iniciando. ¿Desbloquearlo?"
          }
        },
        "fr": {
