          }
        }
      }
    },
    "This account has a second factor enrolled. Choose \"Connect to an existing account\" and sign in with your account name — it will ask for your authenticator or recovery code.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta tiene registrado un segundo factor. Elige «Conectar con una cuenta existente» e inicia sesión con el nombre de tu cuenta: te pedirá tu código del autenticador o de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un second facteur est enrôlé sur ce compte. Choisissez « Se connecter à un compte existant » et connectez-vous avec le nom de votre compte : il demandera votre code d’authentification ou de récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Konto ist ein zweiter Faktor registriert. Wähle „Mit einem bestehenden Konto verbinden“ und melde dich mit deinem Kontonamen an – dann wirst du nach deinem Authenticator- oder Wiederherstellungscode gefragt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta tem um segundo fator cadastrado. Escolha “Conectar a uma conta existente” e entre com o nome da sua conta — ele pedirá seu código do autenticador ou de recuperação."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントには二要素認証が登録されています。「既存のアカウントに接続」を選び、アカウント名でサインインしてください。認証アプリまたはリカバリーのコードを求められます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户已注册第二重验证。请选择“连接到现有账户”并用你的账户名登录，系统会要求你输入验证器代码或恢复代码。"
          }
        }
      }
    },
    "Couldn't start bringing this device in. %@": {
