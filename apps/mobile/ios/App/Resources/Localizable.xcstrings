          }
        }
      }
    },
    "Revoke device?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Revocar el dispositivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révoquer l’appareil ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerät widerrufen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revogar o dispositivo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを取り消しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销设备？"
          }
        }
      }
    },
    "This revokes the device's account access. Its presentation name is never sent to Flagship's control plane in plaintext.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto revoca el acceso del dispositivo a la cuenta. Su nombre visible nunca se envía en texto claro al plano de control de Flagship."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela révoque l’accès de l’appareil au compte. Son nom d’affichage n’est jamais envoyé en clair au plan de contrôle de Flagship."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Kontozugriff des Geräts widerrufen. Sein Anzeigename wird nie im Klartext an die Flagship-Steuerungsebene gesendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso revoga o acesso do dispositivo à conta. O nome de exibição dele nunca é enviado em texto simples ao plano de controle do Flagship."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのアカウントへのアクセスを取り消します。表示名が Flagship のコントロールプレーンに平文で送信されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会撤销该设备对账户的访问权限。其显示名称绝不会以明文发送到 Flagship 控制平面。"
          }
        }
      }
    },
    "Couldn't save the encrypted name. Check the name and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el nombre cifrado. Revisa el nombre e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le nom chiffré. Vérifiez le nom et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verschlüsselte Name konnte nicht gespeichert werden. Prüfe den Namen und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o nome criptografado. Verifique o nome e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された名前を保存できませんでした。名前を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存加密的名称。请检查名称后重试。"
          }
        }
      }
    },
    "Revoke session %@?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Revocar la sesión %@?"
          }
        },
        "fr": {
