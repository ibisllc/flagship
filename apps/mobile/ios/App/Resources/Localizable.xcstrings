    "Check the spelling, or go back and create a new account.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la ortografía o vuelve atrás y crea una cuenta nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’orthographe, ou revenez en arrière et créez un nouveau compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Schreibweise oder geh zurück und erstelle ein neues Konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a grafia ou volte e crie uma conta nova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つづりを確認するか、戻って新しいアカウントを作成してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查拼写，或返回并创建新账户。"
          }
        }
      }
    },
    "That's a pairing link, so we're joining with it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un enlace de vinculación, así que nos unimos con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un lien d’association ; nous l’utilisons donc pour rejoindre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Kopplungslink, daher treten wir damit bei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um link de pareamento, então vamos entrar com ele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはペアリングリンクなので、これを使って参加します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一个配对链接，所以我们用它来加入。"
          }
        }
      }
    },
    "That isn't a pairing code. Paste the whole link from the other device, or scan its code.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es un código de vinculación. Pega el enlace completo del otro dispositivo o escanea su código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un code d’association. Collez le lien complet de l’autre appareil, ou scannez son code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Kopplungscode. Füge den ganzen Link vom anderen Gerät ein oder scanne dessen Code."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não é um código de pareamento. Cole o link completo do outro dispositivo ou leia o código dele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはペアリングコードではありません。もう一方のデバイスのリンク全体を貼り付けるか、そのコードをスキャンしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是配对码。请粘贴另一台设备上的完整链接，或扫描它的二维码。"
          }
        }
      }
    },
    "That looks like an account name. Type it under Sign in with your account name.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece un nombre de cuenta. Escríbelo en Iniciar sesión con el nombre de tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On dirait un nom de compte. Saisissez-le sous Se connecter avec le nom de votre compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nach einem Kontonamen aus. Gib ihn unter „Mit deinem Kontonamen anmelden“ ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
