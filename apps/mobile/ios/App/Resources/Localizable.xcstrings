          }
        }
      }
    },
    "Your device's clock looks off. Check it and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj de tu dispositivo parece desajustado. Revísalo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge de votre appareil semble décalée. Vérifiez-la et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr deines Geräts scheint falsch zu gehen. Prüfe sie und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio do seu dispositivo parece errado. Confira e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの時計がずれているようです。確認してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你设备的时钟似乎不准。请检查后重试。"
          }
        }
      }
    },
    "The server didn't take the update.": {
