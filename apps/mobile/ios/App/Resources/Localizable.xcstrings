          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在关闭…"
          }
        }
      }
    },
    "Require my phone each boot": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigir mi teléfono en cada arranque"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exiger mon téléphone à chaque démarrage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mein Telefon bei jedem Start verlangen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigir meu celular a cada inicialização"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動のたびにスマートフォンを必須にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次启动都要求使用我的手机"
          }
        }
      }
    },
    "After you approve its first boot, this server will self-unlock on future reboots. Nothing to do until then.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando apruebes su primer arranque, este servidor se desbloqueará solo en los próximos reinicios. No hay nada que hacer hasta entonces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois son premier démarrage approuvé, ce serveur se déverrouillera tout seul lors des prochains redémarrages. Rien à faire d’ici là."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdem du den ersten Start genehmigt hast, entsperrt sich dieser Server bei künftigen Neustarts selbst. Bis dahin ist nichts zu tun."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois que você aprovar a primeira inicialização, este servidor se desbloqueará sozinho nos próximos reinícios. Nada a fazer até lá."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の起動を承認すると、以降の再起動ではこのサーバーが自動でロック解除されます。それまでは何もする必要はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准其首次启动后，此服务器在以后重启时会自行解锁。在此之前无需任何操作。"
          }
        }
      }
    },
    "This server asks your phone for approval on every reboot — the most theft-resistant mode.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor pide la aprobación de tu teléfono en cada reinicio, el modo más resistente al robo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur demande l’approbation de votre téléphone à chaque redémarrage — le mode le plus résistant au vol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server fragt bei jedem Neustart dein Telefon um Genehmigung – der am besten gegen Diebstahl geschützte Modus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor pede a aprovação do seu celular a cada reinício — o modo mais resistente a roubo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは再起動のたびにスマートフォンの承認を求めます。盗難に最も強いモードです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器每次重启都会请求你手机的批准，这是最能防盗的模式。"
          }
        }
      }
    },
    "Auto-unlock disabled. This server will ask your phone on its next reboot.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueo automático desactivado. Este servidor pedirá permiso a tu teléfono en su próximo reinicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillage automatique désactivé. Ce serveur sollicitera votre téléphone à son prochain redémarrage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Entsperrung ausgeschaltet. Dieser Server fragt beim nächsten Neustart dein Telefon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueio automático desativado. Este servidor vai pedir ao seu celular no próximo reinício."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動ロック解除をオフにしました。次回の再起動時、このサーバーはスマートフォンに確認を求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动解锁已关闭。此服务器下次重启时会向你的手机请求授权。"
          }
        }
      }
    },
    "Couldn't disable auto-unlock: %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desactivar el desbloqueo automático: %@"
          }
        },
        "fr": {
