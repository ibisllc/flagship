        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器的版本已更改。请刷新后重试。"
          }
        }
      }
    },
    "Only someone who can manage this server can update it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quien puede administrar este servidor puede actualizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une personne pouvant gérer ce serveur peut le mettre à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wer diesen Server verwalten darf, kann ihn aktualisieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente quem pode gerenciar este servidor pode atualizá-lo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーを更新できるのは、管理権限を持つ人だけです。"
          }
