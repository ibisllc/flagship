    "We'll create your account keys for %@ and name this device. You can add a server afterwards — or run with none.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crearemos las claves de tu cuenta para %@ y daremos nombre a este dispositivo. Después puedes añadir un servidor, o seguir sin ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous allons créer les clés de votre compte pour %@ et nommer cet appareil. Vous pourrez ensuite ajouter un serveur — ou continuer sans."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir erstellen die Kontoschlüssel für %@ und benennen dieses Gerät. Danach kannst du einen Server hinzufügen – oder ohne einen weitermachen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos criar as chaves da sua conta para %@ e dar um nome a este dispositivo. Depois você pode adicionar um servidor — ou seguir sem nenhum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 用のアカウントキーを作成し、このデバイスに名前を付けます。その後、サーバーを追加することも、追加せずに使うこともできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们将为 %@ 创建你的账户密钥，并为此设备命名。之后你可以添加服务器，也可以不添加。"
          }
        }
      }
    },
