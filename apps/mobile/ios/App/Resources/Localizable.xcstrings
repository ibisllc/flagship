    "This grants your account access to a restricted service on %@. The owner sees only a private label they assign you — your username and domain are never shared.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto da acceso a tu cuenta a un servicio restringido en %@. El propietario solo ve una etiqueta privada que te asigna; tu nombre de usuario y tu dominio nunca se comparten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela donne à votre compte l’accès à un service restreint sur %@. Le propriétaire ne voit qu’un libellé privé qu’il vous attribue — votre nom d’utilisateur et votre domaine ne sont jamais partagés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch erhält dein Konto Zugriff auf einen eingeschränkten Dienst auf %@. Der Eigentümer sieht nur eine private Bezeichnung, die er dir gibt – dein Benutzername und deine Domain werden nie geteilt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso dá à sua conta acesso a um serviço restrito em %@. O proprietário vê apenas um rótulo privado que ele atribui a você — seu nome de usuário e domínio nunca são compartilhados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、あなたのアカウントが %@ 上の制限付きサービスにアクセスできるようになります。所有者に見えるのは、所有者が付ける非公開のラベルだけです。ユーザー名やドメインが共有されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会让你的账户获得 %@ 上一项受限服务的访问权限。所有者只能看到 TA 为你分配的私有标签；你的用户名和域名绝不会被共享。"
          }
        }
      }
    },
