          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A proteção por código está ativada"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コード保護はオンです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码保护已开启"
          }
        }
      }
    },
    "Recovering this account needs a 6-digit code from your authenticator app (or a recovery code) and a 24-hour wait.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar esta cuenta requiere un código de 6 dígitos de tu app de autenticación (o un código de recuperación) y una espera de 24 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération de ce compte nécessite un code à 6 chiffres de votre application d’authentification (ou un code de récupération) et 24 heures d’attente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Wiederherstellen dieses Kontos brauchst du einen 6-stelligen Code aus deiner Authenticator-App (oder einen Wiederherstellungscode) und 24 Stunden Wartezeit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar esta conta exige um código de 6 dígitos do seu app autenticador (ou um código de recuperação) e uma espera de 24 horas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントのリカバリーには、認証アプリの 6 桁コード（またはリカバリーコード）と 24 時間の待機が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复此账户需要验证器应用中的 6 位代码（或恢复代码），并等待 24 小时。"
          }
        }
      }
    },
