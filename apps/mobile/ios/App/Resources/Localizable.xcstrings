    "We couldn't read that link. Copy the full link from the sign-in page and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos leer ese enlace. Copia el enlace completo de la página de inicio de sesión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
