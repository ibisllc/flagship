          }
        }
      }
    },
    "You can view this server but not manage it, so you can't invite people to its apps.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ver este servidor, pero no gestionarlo, así que no puedes invitar a personas a sus apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez voir ce serveur mais pas le gérer ; vous ne pouvez donc pas inviter de personnes dans ses apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diesen Server ansehen, aber nicht verwalten, daher kannst du keine Personen zu seinen Apps einladen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ver este servidor, mas não gerenciá-lo, então não pode convidar pessoas para os apps dele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは表示のみで管理はできないため、そのアプリに人を招待することはできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以查看此服务器但不能管理它，因此无法邀请他人加入它的应用。"
          }
        }
      }
    },
    "An admin made you a Member of this app, so you can't invite people to it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un administrador te hizo Miembro de esta app, así que no puedes invitar a personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un administrateur a fait de vous un Membre de cette app ; vous ne pouvez donc pas y inviter de personnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Admin hat dich zum Mitglied dieser App gemacht, daher kannst du niemanden einladen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um administrador fez de você Membro deste app, então você não pode convidar pessoas."
          }
