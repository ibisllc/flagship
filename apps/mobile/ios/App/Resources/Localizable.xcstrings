            "state": "translated",
            "value": "Retirer cet appareil de votre compte ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät aus deinem Konto entfernen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover este dispositivo da sua conta?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスをアカウントから削除しますか？"
