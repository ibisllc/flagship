    },
    "Until you allow them, the app can't reach any of these. Only allow hosts you expect this app to need.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que los permitas, la app no puede acceder a ninguno de estos. Permite solo los hosts que esperes que esta app necesite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous ne les autorisez pas, l’app ne peut en joindre aucun. N’autorisez que les hôtes dont cette app devrait avoir besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du sie nicht erlaubst, kann die App keinen davon erreichen. Erlaube nur Hosts, die diese App voraussichtlich braucht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até você permitir, o app não pode acessar nenhum destes. Permita apenas os hosts que você espera que este app precise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可するまで、アプリはこれらのいずれにもアクセスできません。このアプリに必要と思われるホストだけを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你允许之前，应用无法访问其中任何一个。只允许你预期此应用需要的主机。"
          }
        }
      }
    },
