    "Install complete. If it ran from a USB stick, unplug it and power the server back on.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalación completada. Si se ejecutó desde una memoria USB, desconéctala y vuelve a encender el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation terminée. Si elle a été lancée depuis une clé USB, débranchez-la et rallumez le serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation abgeschlossen. Falls sie von einem USB-Stick lief, zieh ihn ab und schalte den Server wieder ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalação concluída. Se ela rodou a partir de um pen drive, desconecte-o e ligue o servidor de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールが完了しました。USB メモリから実行した場合は、抜いてからサーバーの電源を入れ直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装完成。如果是从 U 盘运行的，请拔出 U 盘并重新开启服务器。"
          }
        }
      }
    },
