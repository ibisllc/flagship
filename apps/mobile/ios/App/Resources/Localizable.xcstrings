    },
    "A browser is asking to download the backup of %@. Approve only if this code is on the page in front of you:": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un navegador pide descargar la copia de seguridad de %@. Aprueba solo si este código aparece en la página que tienes delante:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un navigateur demande à télécharger la sauvegarde de %@. N’approuvez que si ce code figure sur la page devant vous :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Browser möchte das Backup von %@ herunterladen. Genehmige nur, wenn dieser Code auf der Seite vor dir steht:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um navegador está pedindo para baixar o backup de %@. Aprove somente se este código estiver na página à sua frente:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザーが %@ のバックアップのダウンロードを求めています。目の前のページにこのコードが表示されている場合にのみ承認してください："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有浏览器请求下载 %@ 的备份。只有当这个代码就显示在你面前的页面上时才批准："
          }
        }
      }
    },
    "The backup opens only with its passcode or on your own devices, but anyone at that browser can save the files.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia solo se abre con su código o en tus propios dispositivos, pero cualquiera que use ese navegador puede guardar los archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde ne s’ouvre qu’avec son code d’accès ou sur vos propres appareils, mais toute personne devant ce navigateur peut enregistrer les fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup lässt sich nur mit seinem Passcode oder auf deinen eigenen Geräten öffnen, aber jeder an diesem Browser kann die Dateien speichern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup só abre com o código dele ou nos seus próprios dispositivos, mas qualquer pessoa nesse navegador pode salvar os arquivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップはパスコードか、ご自身のデバイスでのみ開けますが、そのブラウザーを操作できる人は誰でもファイルを保存できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该备份只能用其密码或在你自己的设备上打开，但使用那个浏览器的任何人都可以保存这些文件。"
          }
        }
      }
    },
