    "Pairing didn't complete. Show a new code and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vinculación no se completó. Muestra un código nuevo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’association n’a pas abouti. Affichez un nouveau code et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopplung wurde nicht abgeschlossen. Zeige einen neuen Code an und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pareamento não foi concluído. Mostre um código novo e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングが完了しませんでした。新しいコードを表示して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对未完成。请显示新的代码后重试。"
          }
        }
      }
    },
    "Add a device to your Flagship account": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir un dispositivo a tu cuenta de Flagship"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
