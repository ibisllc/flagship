    "Build from your own IDE (Claude Code, Cursor, VS Code or Cline) using your own AI. No model key ever touches the server.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea desde tu propio IDE (Claude Code, Cursor, VS Code o Cline) con tu propia IA. Ninguna clave de modelo toca nunca el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez depuis votre propre IDE (Claude Code, Cursor, VS Code ou Cline) avec votre propre IA. Aucune clé de modèle ne touche jamais le serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue aus deiner eigenen IDE (Claude Code, Cursor, VS Code oder Cline) mit deiner eigenen KI. Kein Modellschlüssel berührt je den Server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie a partir do seu próprio IDE (Claude Code, Cursor, VS Code ou Cline) usando a sua própria IA. Nenhuma chave de modelo toca o servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身の IDE（Claude Code、Cursor、VS Code、Cline）から、ご自身の AI で開発できます。モデルキーがサーバーに触れることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你自己的 IDE（Claude Code、Cursor、VS Code 或 Cline）中使用你自己的 AI 来构建。任何模型密钥都不会接触服务器。"
          }
        }
      }
    },
