    "It gets a keyless, read-only session for four hours. Protected actions still need this phone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiene una sesión de solo lectura y sin clave durante cuatro horas. Las acciones protegidas siguen necesitando este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il obtient une session en lecture seule, sans clé, pendant quatre heures. Les actions protégées nécessitent toujours ce téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er erhält vier Stunden lang eine schlüssellose, schreibgeschützte Sitzung. Geschützte Aktionen brauchen weiterhin dieses Telefon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele recebe uma sessão somente leitura e sem chave por quatro horas. Ações protegidas ainda exigem este celular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4 時間のあいだ、キーなしの読み取り専用セッションが付与されます。保護された操作には、引き続きこのスマートフォンが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将获得四小时的无密钥只读会话。受保护的操作仍需要这部手机。"
          }
        }
      }
    },
