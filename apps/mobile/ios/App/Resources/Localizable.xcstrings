    "%@ can't be attached. Attach an image, a text file, a CSV or JSON file, or a PDF.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede adjuntar %@. Adjunta una imagen, un archivo de texto, un archivo CSV o JSON, o un PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas être joint. Joignez une image, un fichier texte, un fichier CSV ou JSON, ou un PDF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nicht angehängt werden. Hänge ein Bild, eine Textdatei, eine CSV- oder JSON-Datei oder ein PDF an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
