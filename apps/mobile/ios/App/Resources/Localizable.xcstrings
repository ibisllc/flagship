    "Couldn't install your account key. %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo instalar la clave de tu cuenta. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’installer la clé de votre compte. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
