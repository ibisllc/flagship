          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "dans environ %lld heures"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "in etwa %lld Stunden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "em cerca de %lld horas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約 %lld 時間後"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %lld 小时后"
          }
        }
      }
    },
    "This device isn't connected to a server yet.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo aún no está conectado a un servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’est pas encore connecté à un serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist noch nicht mit einem Server verbunden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo ainda não está conectado a um servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはまだサーバーに接続されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备尚未连接到服务器。"
          }
        }
      }
    },
    "Your connection to this box expired. Reconnect and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu conexión con este equipo caducó. Vuelve a conectar e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre connexion à ce boîtier a expiré. Reconnectez-vous et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Verbindung zu dieser Box ist abgelaufen. Verbinde dich erneut und versuche es noch einmal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conexão com esta caixa expirou. Reconecte e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボックスへの接続の有効期限が切れました。再接続して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你与此主机的连接已过期。请重新连接后再试。"
          }
        }
      }
    },
    "That isn't available yet.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso aún no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela n’est pas encore disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist noch nicht verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso ainda não está disponível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それはまだ利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这暂时还不可用。"
          }
        }
      }
    },
    "This box's security certificate doesn't match what we expected — someone may be intercepting the connection. Reinstall the box, or contact whoever runs it before continuing.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado de seguridad de este equipo no coincide con lo esperado: puede que alguien esté interceptando la conexión. Reinstala el equipo o contacta con quien lo gestione antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de sécurité de ce boîtier ne correspond pas à ce que nous attendions — quelqu’un intercepte peut-être la connexion. Réinstallez le boîtier ou contactez la personne qui l’exploite avant de continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sicherheitszertifikat dieser Box entspricht nicht dem Erwarteten – jemand fängt möglicherweise die Verbindung ab. Installiere die Box neu oder wende dich an den Betreiber, bevor du fortfährst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado de segurança desta caixa não corresponde ao esperado — alguém pode estar interceptando a conexão. Reinstale a caixa ou entre em contato com quem a administra antes de continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボックスのセキュリティ証明書が想定と一致しません。誰かが通信を傍受している可能性があります。続行する前に、ボックスを再インストールするか、運用している人に連絡してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此主机的安全证书与预期不符：可能有人在拦截连接。继续之前，请重新安装主机或联系其运营者。"
          }
        }
      }
    },
    "We can't currently verify the Flagship control server. Connecting is paused until it checks out — or you can choose to continue anyway.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no podemos verificar el servidor de control de Flagship. La conexión está en pausa hasta que se compruebe, o puedes elegir continuar de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne pouvons pas vérifier le serveur de contrôle Flagship pour le moment. La connexion est suspendue jusqu’à vérification — ou vous pouvez choisir de continuer malgré tout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir können den Flagship-Kontrollserver derzeit nicht verifizieren. Die Verbindung ist angehalten, bis er überprüft ist – oder du entscheidest dich, trotzdem fortzufahren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No momento não conseguimos verificar o servidor de controle do Flagship. A conexão fica em pausa até ser verificado — ou você pode escolher continuar mesmo assim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、Flagship コントロールサーバーを確認できません。確認が取れるまで接続は一時停止されます。このまま続行することも選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们目前无法验证 Flagship 控制服务器。在验证通过之前连接会暂停，你也可以选择仍然继续。"
          }
        }
      }
    },
    "This server isn't set up to build services yet. Building services needs the services feature enabled on this box.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor aún no está preparado para crear servicios. Crear servicios requiere que la función de servicios esté activada en este equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n’est pas encore prêt à créer des services. La création de services nécessite que la fonction services soit activée sur ce boîtier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server ist noch nicht zum Bauen von Diensten eingerichtet. Dafür muss die Dienste-Funktion auf dieser Box aktiviert sein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor ainda não está configurado para criar serviços. Criar serviços exige que o recurso de serviços esteja ativado nesta caixa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは、まだサービスを作成できる状態ではありません。サービスの作成には、このボックスでサービス機能が有効になっている必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器尚未设置为可构建服务。构建服务需要在此主机上启用服务功能。"
          }
        }
      }
    },
    "You're not signed in for that. Try signing in again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has iniciado sesión para eso. Prueba a iniciar sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’êtes pas connecté pour cela. Essayez de vous reconnecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür bist du nicht angemeldet. Versuche, dich erneut anzumelden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não está conectado para isso. Tente entrar de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのためのサインインがされていません。もう一度サインインしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未为此登录。请尝试重新登录。"
          }
        }
      }
    },
    "We couldn't find that. It may have moved or been removed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos encontrarlo. Puede que se haya movido o eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne l’avons pas trouvé. Il a peut-être été déplacé ou supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnten wir nicht finden. Es wurde möglicherweise verschoben oder entfernt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontramos isso. Pode ter sido movido ou removido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つかりませんでした。移動または削除された可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到它。它可能已被移动或删除。"
          }
        }
      }
    },
    "The server is busy right now. Give it a moment and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor está ocupado ahora mismo. Espera un momento y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur est occupé pour le moment. Patientez un instant et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist gerade ausgelastet. Warte einen Moment und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está ocupado agora. Aguarde um instante e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはいま混み合っています。少し待ってから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器目前繁忙。请稍等片刻后重试。"
          }
        }
      }
    },
    "Service temporarily unavailable. Try again in a few minutes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicio no disponible temporalmente. Inténtalo de nuevo en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Service temporairement indisponible. Réessayez dans quelques minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienst vorübergehend nicht verfügbar. Versuche es in ein paar Minuten erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviço temporariamente indisponível. Tente de novo em alguns minutos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスは一時的に利用できません。数分後にもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务暂时不可用。请几分钟后再试。"
          }
        }
      }
    },
    "Something went wrong. Try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu. Réessayez dans un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Versuche es gleich noch einmal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado. Tente de novo em instantes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题。请稍后再试。"
          }
        }
      }
    },
    "Apps can't start on this server: the internet firewall that keeps them to their allowed hosts isn't running": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps no pueden iniciarse en este servidor: no está en marcha el cortafuegos de internet que las limita a sus hosts permitidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ne peuvent pas démarrer sur ce serveur : le pare-feu Internet qui les limite à leurs hôtes autorisés n’est pas en cours d’exécution"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps können auf diesem Server nicht starten: Die Internet-Firewall, die sie auf ihre erlaubten Hosts beschränkt, läuft nicht"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps não podem iniciar neste servidor: o firewall de internet que os limita aos hosts permitidos não está em execução"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーではアプリを起動できません。アプリを許可されたホストに制限するインターネットファイアウォールが動作していません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器上的应用无法启动：将应用限制在其允许主机范围内的互联网防火墙未在运行"
          }
        }
      }
    },
    "Apps can't start on this server: the sandbox they run in isn't working (%@). The server tries again every 10 minutes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps no pueden iniciarse en este servidor: el entorno aislado en el que se ejecutan no funciona (%@). El servidor lo reintenta cada 10 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ne peuvent pas démarrer sur ce serveur : le bac à sable dans lequel elles tournent ne fonctionne pas (%@). Le serveur réessaie toutes les 10 minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps können auf diesem Server nicht starten: Die Sandbox, in der sie laufen, funktioniert nicht (%@). Der Server versucht es alle 10 Minuten erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps não podem iniciar neste servidor: o ambiente isolado em que rodam não está funcionando (%@). O servidor tenta de novo a cada 10 minutos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーではアプリを起動できません。アプリを動かすサンドボックスが動作していません（%@）。サーバーは 10 分ごとに再試行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器上的应用无法启动：它们所运行的沙箱无法工作（%@）。服务器每 10 分钟重试一次。"
          }
        }
      }
    },
    "Setting up the sandbox apps run in. They start once it's ready.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurando el entorno aislado en el que se ejecutan las apps. Se iniciarán cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise en place du bac à sable dans lequel les apps tournent. Elles démarreront dès qu’il sera prêt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sandbox, in der Apps laufen, wird eingerichtet. Sie starten, sobald sie bereit ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurando o ambiente isolado em que os apps rodam. Eles iniciam quando estiver pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを動かすサンドボックスを準備しています。準備ができたらアプリが起動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在设置应用运行的沙箱。准备好后它们就会启动。"
          }
        }
      }
    },
    "The last update%@ didn't start cleanly, so the server went back%@ on its own.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última actualización%@ no arrancó bien, así que el servidor volvió%@ por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière mise à jour%@ n’a pas démarré correctement ; le serveur est donc revenu%@ de lui-même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das letzte Update%@ ist nicht sauber gestartet, daher ist der Server von selbst zurückgegangen%@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última atualização%@ não iniciou direito, então o servidor voltou%@ por conta própria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近のアップデート%@ が正常に起動しなかったため、サーバーは自動的に%@元に戻りました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次更新%@ 没能正常启动，因此服务器自行回退%@。"
          }
        }
      }
    },
    "The server refused the last update: %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó la última actualización: %@"
          }
        },
        "fr": {
