            "state": "translated",
            "value": "Pode ver"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧可"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可查看"
          }
        }
      }
    },
    "Can manage": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede gestionar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut gérer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darf verwalten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode gerenciar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理可"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可管理"
          }
        }
      }
    },
    "Sees the server's status, monitoring and apps.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve el estado, la supervisión y las apps del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit l’état, la supervision et les apps du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieht Status, Überwachung und Apps des Servers."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê o status, o monitoramento e os apps do servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのステータス、モニタリング、アプリを閲覧できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可查看服务器的状态、监控和应用。"
          }
        }
      }
    },
    "Also builds apps with AI, accepts app updates, updates the server and changes apps' internet access.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También crea apps con IA, acepta actualizaciones de apps, actualiza el servidor y cambia el acceso a internet de las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée aussi des apps avec l’IA, accepte les mises à jour d’apps, met à jour le serveur et modifie l’accès Internet des apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baut außerdem Apps mit KI, nimmt App-Updates an, aktualisiert den Server und ändert den Internetzugriff der Apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também cria apps com IA, aceita atualizações de apps, atualiza o servidor e altera o acesso à internet dos apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに、AI でアプリを作成し、アプリのアップデートを受け入れ、サーバーを更新し、アプリのインターネットアクセスを変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还可以用 AI 构建应用、接受应用更新、更新服务器，以及更改应用的互联网访问。"
          }
        }
      }
    },
    "Approve start-ups": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar arranques"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver les démarrages"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts genehmigen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar inicializações"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動を承認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准启动"
          }
        }
      }
    },
    "Their phone can unlock this server when it starts. That gives them a copy of its disk key.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su teléfono puede desbloquear este servidor cuando arranca. Eso le da una copia de la clave de su disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son téléphone peut déverrouiller ce serveur au démarrage. Cela lui donne une copie de sa clé de disque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Telefon kann diesen Server beim Start entsperren. Dadurch erhält es eine Kopie seines Datenträgerschlüssels."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular dela pode desbloquear este servidor quando ele inicia. Isso dá a ela uma cópia da chave de disco dele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のスマートフォンは、このサーバーの起動時にロックを解除できます。そのため、ディスクキーのコピーが相手に渡ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方的手机可以在此服务器启动时将其解锁。这意味着对方会获得其磁盘密钥的一份副本。"
          }
        }
      }
    },
    "Only give this to someone you'd give a house key. Ending the share deletes their copy, but they could have kept one.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da esto solo a alguien a quien le darías la llave de tu casa. Terminar el acceso compartido elimina su copia, pero podrían haber guardado otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne l’accordez qu’à quelqu’un à qui vous confieriez la clé de votre maison. Mettre fin au partage supprime sa copie, mais elle a pu en conserver une."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das nur jemandem, dem du auch einen Hausschlüssel geben würdest. Das Beenden der Freigabe löscht seine Kopie, aber er könnte eine behalten haben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê isso apenas a alguém a quem você daria a chave da sua casa. Encerrar o compartilhamento exclui a cópia dela, mas ela pode ter guardado uma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家の鍵を渡せる相手にだけ許可してください。共有を終了すると相手のコピーは削除されますが、コピーを保持されている可能性もあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只把它授予你会交出家门钥匙的人。结束共享会删除对方的副本，但对方可能已经另外留存了一份。"
          }
        }
      }
    },
    "See app data": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver los datos de las apps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir les données des apps"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Daten sehen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver os dados dos apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのデータを表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看应用数据"
          }
        }
      }
    },
    "They can read your apps' databases, and change data if they can manage.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pueden leer las bases de datos de tus apps y, si pueden gestionar, cambiar los datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles peuvent lire les bases de données de vos apps et, si elles peuvent gérer, modifier les données."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können die Datenbanken deiner Apps lesen und, wenn sie verwalten dürfen, Daten ändern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elas podem ler os bancos de dados dos seus apps e, se puderem gerenciar, alterar os dados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのデータベースを読み取れ、管理権限があればデータも変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他们可以读取你应用的数据库，如果拥有管理权限还能更改数据。"
          }
        }
      }
    },
    "Notify this device when it needs to start": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar a este dispositivo cuando el servidor necesite arrancar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifier cet appareil lorsque le serveur doit démarrer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät benachrichtigen, wenn der Server starten muss"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar este dispositivo quando o servidor precisar iniciar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの起動が必要なときにこのデバイスに通知"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器需要启动时通知此设备"
          }
        }
      }
    },
    "Turning this on lets Flagship's service know this device helps with this server, so it can wake you. The notice itself names no server.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlo, el servicio de Flagship sabe que este dispositivo ayuda con este servidor, para poder avisarte. El aviso en sí no menciona ningún servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’activer permet au service de Flagship de savoir que cet appareil aide pour ce serveur, afin de pouvoir vous réveiller. L’avis lui-même ne nomme aucun serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das einschaltest, erfährt Flagships Dienst, dass dieses Gerät bei diesem Server hilft, damit er dich wecken kann. Die Benachrichtigung selbst nennt keinen Server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao ativar, o serviço do Flagship fica sabendo que este dispositivo ajuda com este servidor, para poder acordar você. O aviso em si não cita nenhum servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、このデバイスがこのサーバーを手伝っていることを Flagship のサービスが把握し、通知で知らせられるようになります。通知自体にはサーバー名は含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，Flagship 的服务会知道此设备协助管理这台服务器，以便唤醒你。通知本身不会指明任何服务器。"
          }
        }
      }
    },
    "Members only. As a co-manager you can open it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para miembros. Como cogestor, tú puedes abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réservé aux membres. En tant que cogestionnaire, vous pouvez l’ouvrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Mitglieder. Als Mitverwalter kannst du sie öffnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente para membros. Como coadministrador, você pode abri-lo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバー限定です。共同管理者のあなたは開けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限成员。作为共同管理者，你可以打开它。"
          }
        }
      }
    },
    "Update to %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar a %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à jour vers %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %@ aktualisieren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizar para %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に更新"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新到 %@"
          }
        }
      }
    },
    "%@ restarts on the new release. Only releases Flagship's maintainers endorsed will install.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se reinicia con la versión nueva. Solo se instalan versiones que hayan avalado los responsables de Flagship."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ redémarre sur la nouvelle version. Seules les versions approuvées par les mainteneurs de Flagship s’installent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ startet mit der neuen Version neu. Nur Versionen, die Flagships Maintainer freigegeben haben, werden installiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reinicia na nova versão. Somente versões endossadas pelos mantenedores do Flagship são instaladas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は新しいリリースで再起動します。Flagship のメンテナーが承認したリリースだけがインストールされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会重启进入新版本。只有 Flagship 维护者认可的版本才会安装。"
          }
        }
      }
    },
    "Updating %@. It restarts in a few minutes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizando %@. Se reinicia en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour de %@. Il redémarre dans quelques minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird aktualisiert. Er startet in ein paar Minuten neu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizando %@. Ele reinicia em alguns minutos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を更新しています。数分後に再起動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更新 %@。它会在几分钟后重启。"
          }
        }
      }
    },
    "%@ accepted. Does their phone show this code?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aceptó. ¿Su teléfono muestra este código?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a accepté. Son téléphone affiche-t-il ce code ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat angenommen. Zeigt sein Telefon diesen Code an?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aceitou. O celular dela mostra este código?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が承諾しました。相手のスマートフォンにこのコードが表示されていますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已接受。对方的手机上显示的是这个代码吗？"
          }
        }
      }
    },
    "Waiting for %@ to open the link": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que %@ abra el enlace"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente que %@ ouvre le lien"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte darauf, dass %@ den Link öffnet"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando %@ abrir o link"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がリンクを開くのを待っています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 %@ 打开链接"
          }
        }
      }
    },
    "This invitation's answer doesn't check out. Cancel it and share again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta a esta invitación no es válida. Cancélala y vuelve a compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse à cette invitation n’est pas valide. Annulez-la et partagez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort auf diese Einladung ist nicht gültig. Brich sie ab und teile erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta a este convite não é válida. Cancele-o e compartilhe de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この招待への回答は無効です。キャンセルして、もう一度共有してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此邀请的回复无效。请取消并重新共享。"
          }
        }
      }
    },
    "Start-up approval isn't set up for them yet.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aprobación de arranques aún no está configurada para esta persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’approbation des démarrages n’est pas encore configurée pour cette personne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Start-Genehmigung ist für diese Person noch nicht eingerichtet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação de inicializações ainda não está configurada para esta pessoa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この相手には、起動の承認がまだ設定されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未为对方设置启动批准。"
          }
        }
      }
    },
    "Show invitations waiting for an answer": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar invitaciones a la espera de respuesta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les invitations en attente de réponse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Antwort wartende Einladungen anzeigen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
