    "This isn't one of your servers. Open its invite link on this phone first, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este no es uno de tus servidores. Abre antes su enlace de invitación en este teléfono y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas l’un de vos serveurs. Ouvrez d’abord son lien d’invitation sur ce téléphone, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keiner deiner Server. Öffne zuerst seinen Einladungslink auf diesem Telefon und versuche es dann erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este não é um dos seus servidores. Abra primeiro o link de convite dele neste celular e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはあなたのサーバーではありません。先にこのスマートフォンでその招待リンクを開いてから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是你的服务器之一。请先在这部手机上打开它的邀请链接，然后再试。"
          }
        }
      }
    },
    "This device isn't set up on your account yet. Sign in to your account on it again, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo aún no está configurado en tu cuenta. Vuelve a iniciar sesión en tu cuenta en él y prueba de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’est pas encore configuré sur votre compte. Reconnectez-vous à votre compte dessus, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist in deinem Konto noch nicht eingerichtet. Melde dich darauf erneut bei deinem Konto an und versuche es dann noch einmal."
