    "Joining an account from this phone isn't available yet. Use the web app.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unirse a una cuenta desde este teléfono aún no está disponible. Usa la app web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre un compte depuis ce téléphone n’est pas encore disponible. Utilisez l’app web."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einem Konto von diesem Telefon aus beizutreten ist noch nicht möglich. Nutze die Web-App."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar em uma conta a partir deste celular ainda não está disponível. Use o app web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンからのアカウント参加はまだ利用できません。Web アプリをお使いください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持从这部手机加入账户。请使用网页版。"
          }
        }
      }
    },
    "Stopped; it goes on next time.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido; continúa la próxima vez."
