    "Turn on Quick approve from Apple Watch in Flagship on your iPhone first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero activa Aprobación rápida desde Apple Watch en Flagship, en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez d’abord Approbation rapide depuis l’Apple Watch dans Flagship, sur votre iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte zuerst „Schnell genehmigen per Apple Watch“ in Flagship auf deinem iPhone ein."
          }
        },
        "pt-BR": {
          "stringUnit": {
