    "If anything looks wrong, you can undo this re-anchoring until %@. After that the old identity stops being recoverable.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si algo parece incorrecto, puedes deshacer esta reasociación hasta el %@. Después, la identidad anterior deja de poder recuperarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quelque chose semble anormal, vous pouvez annuler ce rattachement jusqu’au %@. Passé ce délai, l’ancienne identité n’est plus récupérable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn etwas nicht stimmt, kannst du diese Neuverankerung bis %@ rückgängig machen. Danach ist die alte Identität nicht mehr wiederherstellbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se algo parecer errado, você pode desfazer esta reancoragem até %@. Depois disso, a identidade antiga deixa de ser recuperável."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題があれば、%@ までこの付け替えを元に戻せます。それ以降は、以前の ID を復旧できなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果发现异常，你可以在 %@ 之前撤销这次重新锚定。之后，旧身份将无法再恢复。"
          }
        }
      }
    },
    "Process URL": {
      "extractionState": "manual",
      "localizations": {
