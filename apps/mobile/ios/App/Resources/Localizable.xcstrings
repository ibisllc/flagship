    "This server runs an older peer backup. Update the server to see its new status here.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor ejecuta una copia entre pares antigua. Actualiza el servidor para ver aquí su nuevo estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur exécute une ancienne sauvegarde entre pairs. Mettez le serveur à jour pour voir ici son nouvel état."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server führt ein älteres Peer-Backup aus. Aktualisiere den Server, um hier seinen neuen Status zu sehen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor executa um backup entre pares mais antigo. Atualize o servidor para ver aqui o novo status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは古いピアバックアップを実行しています。サーバーを更新すると、新しい状態がここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器运行的是较旧的对等备份。请更新服务器，以便在此处查看其新状态。"
          }
        }
      }
    },
    "Servers holding your pieces": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores que guardan tus fragmentos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveurs qui conservent vos fragments"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server, die deine Teile aufbewahren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores que guardam seus pedaços"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断片を保管しているサーバー"
          }
