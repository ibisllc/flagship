    "The builder saved the recipe but didn't confirm receipt. Update or reopen the builder and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El creador guardó la receta pero no confirmó la recepción. Actualiza o reabre el creador e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le builder a enregistré la recette sans confirmer la réception. Mettez à jour ou rouvrez le builder, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Builder hat das Rezept gespeichert, den Empfang aber nicht bestätigt. Aktualisiere oder öffne den Builder erneut und versuche es noch einmal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O builder salvou a receita, mas não confirmou o recebimento. Atualize ou reabra o builder e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルダーはレシピを保存しましたが、受信を確認しませんでした。ビルダーを更新するか開き直して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建器已保存配方，但没有确认收到。请更新或重新打开构建器后重试。"
          }
        }
      }
    },
