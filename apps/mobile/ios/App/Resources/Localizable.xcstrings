    "The device may retain its own suggestion, but the managed name remains visible until an administrator removes it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo puede conservar su propia sugerencia, pero el nombre administrado sigue visible hasta que un administrador lo quite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil peut conserver sa propre suggestion, mais le nom géré reste visible jusqu’à ce qu’un administrateur le retire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät kann seinen eigenen Vorschlag behalten, aber der verwaltete Name bleibt sichtbar, bis ein Admin ihn entfernt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo pode manter sua própria sugestão, mas o nome gerenciado continua visível até que um administrador o remova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスは独自の提案を保持できますが、管理者が削除するまで管理名が表示され続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备可以保留自己的建议名称，但在管理员移除之前，托管名称仍然可见。"
          }
        }
      }
    },
    "Names are encrypted and apply only inside this Flagship account.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres se cifran y solo se aplican dentro de esta cuenta de Flagship."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms sont chiffrés et ne s’appliquent qu’au sein de ce compte Flagship."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen werden verschlüsselt und gelten nur innerhalb dieses Flagship-Kontos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes são criptografados e valem apenas dentro desta conta Flagship."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は暗号化され、この Flagship アカウント内でのみ使われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称会被加密，且仅在此 Flagship 账户内有效。"
          }
        }
      }
    },
    "Lock managed name": {
      "extractionState": "manual",
