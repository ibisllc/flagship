    "This invite needs the owner's approval. Send this reply back to them through the same channel they sent you the invite — they'll approve it and you'll be in.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta invitación necesita la aprobación del propietario. Envíale esta respuesta por el mismo canal por el que te mandó la invitación: la aprobará y ya estarás dentro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette invitation nécessite l’approbation du propriétaire. Renvoyez-lui cette réponse par le même canal que celui par lequel il vous a envoyé l’invitation — il l’approuvera et vous serez dedans."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einladung braucht die Genehmigung des Eigentümers. Sende ihm diese Antwort über denselben Kanal zurück, über den er dir die Einladung geschickt hat – er genehmigt sie, und du bist drin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este convite precisa da aprovação do proprietário. Envie esta resposta de volta pelo mesmo canal por onde ele enviou o convite — ele aprovará e pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この招待には所有者の承認が必要です。招待を受け取ったのと同じ手段で、この返信を所有者に送り返してください。承認されると参加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此邀请需要所有者批准。请通过对方发给你邀请的同一渠道把这份回复发回给 TA，TA 批准后你就加入了。"
          }
        }
      }
    },
    "Your approval reply": {
      "extractionState": "manual",
      "localizations": {
