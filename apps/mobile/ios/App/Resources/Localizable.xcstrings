        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu’est-ce qui ne va pas ? Cela aide à corriger l’adaptation partagée pour tout le monde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was geht schief? Das hilft, die geteilte Anpassung für alle zu korrigieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que dá errado? Isso ajuda a corrigir a adaptação compartilhada para todos."
