    "That recovery code or authenticator code wasn't accepted. Check it and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se aceptó ese código de recuperación o del autenticador. Compruébalo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code de récupération ou d’authentification n’a pas été accepté. Vérifiez-le et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
