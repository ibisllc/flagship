    "Your editor's agent builds against your server using your OWN AI subscription. No model key is stored on the server.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente de tu editor trabaja contra tu servidor con tu PROPIA suscripción de IA. No se guarda ninguna clave de modelo en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent de votre éditeur travaille sur votre serveur avec votre PROPRE abonnement d’IA. Aucune clé de modèle n’est stockée sur le serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent deines Editors arbeitet mit deinem EIGENEN KI-Abonnement gegen deinen Server. Auf dem Server wird kein Modellschlüssel gespeichert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente do seu editor trabalha no seu servidor usando a SUA PRÓPRIA assinatura de IA. Nenhuma chave de modelo é armazenada no servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディターのエージェントが、ご自身の AI サブスクリプションを使ってサーバーに対して作業します。サーバーにモデルキーは保存されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你编辑器中的智能体使用你自己的 AI 订阅在你的服务器上工作。服务器上不会保存任何模型密钥。"
          }
        }
      }
    },
    "Your editor's agent changes %@ on your server, starting from its current code, using your own AI subscription. Deploying from the IDE replaces the running version; its address and data stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente de tu editor cambia %@ en tu servidor, partiendo de su código actual y con tu propia suscripción de IA. Desplegar desde el IDE sustituye la versión en ejecución; su dirección y sus datos siguen igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent de votre éditeur modifie %@ sur votre serveur, à partir de son code actuel, avec votre propre abonnement d’IA. Déployer depuis l’IDE remplace la version en cours ; son adresse et ses données restent les mêmes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent deines Editors ändert %@ auf deinem Server, ausgehend vom aktuellen Code und mit deinem eigenen KI-Abonnement. Das Bereitstellen aus der IDE ersetzt die laufende Version; Adresse und Daten bleiben gleich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente do seu editor altera %@ no seu servidor, partindo do código atual e usando a sua própria assinatura de IA. Implantar pelo IDE substitui a versão em execução; o endereço e os dados continuam os mesmos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディターのエージェントが、現在のコードを出発点に、ご自身の AI サブスクリプションを使ってサーバー上の %@ を変更します。IDE からデプロイすると実行中のバージョンが置き換わり、アドレスとデータは変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你编辑器中的智能体会在你的服务器上修改 %@，从当前代码开始，使用你自己的 AI 订阅。从 IDE 部署会替换正在运行的版本；其地址和数据保持不变。"
          }
        }
      }
    },
    "Create a connection": {
      "extractionState": "manual",
      "localizations": {
