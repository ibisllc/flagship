    "Enter your recovery passphrase and verify your passkey to restore access on this device.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu frase de contraseña de recuperación y verifica tu llave de acceso para restaurar el acceso en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre phrase secrète de récupération et vérifiez votre clé d’accès pour rétablir l’accès sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deine Wiederherstellungs-Passphrase ein und bestätige deinen Passkey, um den Zugriff auf diesem Gerät wiederherzustellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite sua frase secreta de recuperação e verifique sua passkey para restaurar o acesso neste dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーパスフレーズを入力し、パスキーを確認して、このデバイスでのアクセスを復元します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入你的恢复密码短语并验证你的通行密钥，即可在此设备上恢复访问。"
          }
        }
      }
    },
    "Restore access": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar el acceso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir l’accès"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff wiederherstellen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar o acesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを復元"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复访问"
          }
        }
      }
    },
    "Enter your recovery passphrase, verify your passkey, and add your recovery code to restore access on this device. For your security it becomes active after a 24-hour hold, and your other devices are notified.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu frase de contraseña de recuperación, verifica tu llave de acceso y añade tu código de recuperación para restaurar el acceso en este dispositivo. Por tu seguridad, se activa tras una espera de 24 horas y se avisa a tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre phrase secrète de récupération, vérifiez votre clé d’accès et ajoutez votre code de récupération pour rétablir l’accès sur cet appareil. Pour votre sécurité, il devient actif après 24 heures d’attente, et vos autres appareils sont alertés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deine Wiederherstellungs-Passphrase ein, bestätige deinen Passkey und füge deinen Wiederherstellungscode hinzu, um den Zugriff auf diesem Gerät wiederherzustellen. Zu deiner Sicherheit wird er nach 24 Stunden Wartezeit aktiv, und deine anderen Geräte werden benachrichtigt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite sua frase secreta de recuperação, verifique sua passkey e adicione seu código de recuperação para restaurar o acesso neste dispositivo. Para sua segurança, ele fica ativo após uma espera de 24 horas, e seus outros dispositivos são avisados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーパスフレーズを入力し、パスキーを確認して、リカバリーコードを追加すると、このデバイスでのアクセスを復元できます。安全のため、24 時間の待機後に有効になり、他のデバイスにも通知されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入你的恢复密码短语，验证你的通行密钥，并添加你的恢复代码，即可在此设备上恢复访问。为了你的安全，它会在 24 小时等待后生效，并通知你的其他设备。"
          }
        }
      }
    },
    "Recovery code or authenticator code": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de recuperación o código del autenticador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code de récupération ou code d’authentification"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungscode oder Authenticator-Code"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de recuperação ou código do autenticador"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーコードまたは認証コード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复代码或验证器代码"
          }
        }
      }
    },
    "6-digit code from your authenticator app, or one of your recovery codes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de 6 dígitos de tu app de autenticación, o uno de tus códigos de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code à 6 chiffres de votre application d’authentification, ou l’un de vos codes de récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "6-stelliger Code aus deiner Authenticator-App oder einer deiner Wiederherstellungscodes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de 6 dígitos do seu app autenticador, ou um dos seus códigos de recuperação."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリの 6 桁コード、またはリカバリーコードのいずれか。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自验证器应用的 6 位代码，或你的某个恢复代码。"
          }
        }
      }
    },
    "Restore access (24-hour hold)": {
      "extractionState": "manual",
      "localizations": {
