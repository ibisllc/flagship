    "This uninstalls the service from %@ and deletes its data. This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto desinstala el servicio de %@ y borra sus datos. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela désinstalle le service de %@ et supprime ses données. Irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Dienst von %@ deinstalliert und seine Daten werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso desinstala o serviço de %@ e exclui os dados dele. Não pode ser desfeito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ からサービスをアンインストールし、そのデータを削除します。元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从 %@ 卸载该服务并删除其数据。此操作无法撤销。"
          }
        }
      }
    },
    "Removed %@ from %@.": {
      "extractionState": "manual",
