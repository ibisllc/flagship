    },
    "It's waiting for its disk key. Unlock it only if you expected it to restart.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está esperando la clave de su disco. Desbloquéalo solo si esperabas que se reiniciara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il attend la clé de son disque. Ne le déverrouillez que si vous vous attendiez à un redémarrage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wartet auf seinen Datenträgerschlüssel. Entsperre ihn nur, wenn du einen Neustart erwartet hast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele está aguardando a chave de disco dele. Desbloqueie somente se você esperava que ele reiniciasse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクキーを待っています。再起動を予期していた場合にのみ、ロックを解除してください。"
