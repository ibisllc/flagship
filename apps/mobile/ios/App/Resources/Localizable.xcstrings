    "Names appear here; values stay on this server. They're sealed at rest and never leave your server.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen los nombres; los valores se quedan en este servidor. Están sellados en reposo y nunca salen de tu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms apparaissent ici ; les valeurs restent sur ce serveur. Elles sont scellées au repos et ne quittent jamais votre serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheinen die Namen; die Werte bleiben auf diesem Server. Sie sind im Ruhezustand versiegelt und verlassen deinen Server nie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes aparecem aqui; os valores ficam neste servidor. Eles são selados em repouso e nunca saem do seu servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここには名前だけが表示され、値はこのサーバーに残ります。値は保存時に封印され、サーバーの外に出ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只显示名称；值保留在此服务器上。它们在静态存储时被密封，永远不会离开你的服务器。"
          }
        }
      }
    },
