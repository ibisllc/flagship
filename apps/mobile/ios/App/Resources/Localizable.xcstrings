    "Please don't include anything that identifies you, your server or your data: no names, addresses, emails or passwords.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, no incluyas nada que te identifique a ti, a tu servidor o a tus datos: ni nombres, ni direcciones, ni correos, ni contraseñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de n’inclure rien qui vous identifie, vous, votre serveur ou vos données : ni noms, ni adresses, ni e-mails, ni mots de passe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte nichts angeben, was dich, deinen Server oder deine Daten identifiziert: keine Namen, Adressen, E-Mails oder Passwörter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, não inclua nada que identifique você, seu servidor ou seus dados: sem nomes, endereços, e-mails ou senhas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた、サーバー、データを特定できる情報（名前、住所、メールアドレス、パスワードなど）は含めないでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请不要包含任何能识别你、你的服务器或你的数据的信息：不要有姓名、地址、电子邮件或密码。"
          }
        }
      }
    },
    "This app wants to reach the internet": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
