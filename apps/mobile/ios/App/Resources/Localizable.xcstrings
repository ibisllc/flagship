    "Your server finished provisioning and is coming online.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor terminó de aprovisionarse y se está conectando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
