          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein – bestätige, um entsperrt zu bleiben"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado — confirme para manter desbloqueado"
          }
        },
