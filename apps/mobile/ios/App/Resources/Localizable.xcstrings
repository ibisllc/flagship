          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela démonte le serveur et arrête l’installation. Vous pourrez recommencer depuis votre compte à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Server abgebaut und die Installation gestoppt. Du kannst jederzeit von deinem Konto aus neu beginnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso desmonta o servidor e interrompe a instalação. Você pode recomeçar a partir da sua conta a qualquer momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーを解体し、インストールを停止します。アカウントからいつでもやり直せます。"
