    "This server couldn't make it invite only, so anyone with the link can open it. You can restrict it from the service's Access settings.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no pudo dejarla solo con invitación, así que cualquiera con el enlace puede abrirla. Puedes restringirla desde los ajustes de Acceso del servicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n’a pas pu la réserver aux invités ; toute personne disposant du lien peut donc l’ouvrir. Vous pouvez la restreindre depuis les réglages d’accès du service."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server konnte sie nicht auf Einladung beschränken, daher kann jeder mit dem Link sie öffnen. Du kannst das in den Zugriffseinstellungen des Dienstes einschränken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não conseguiu torná-lo somente por convite, então qualquer pessoa com o link pode abri-lo. Você pode restringir nas configurações de Acesso do serviço."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは招待制にできなかったため、リンクを知っていれば誰でも開けます。サービスのアクセス設定で制限できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器无法将其设为仅限邀请，因此任何拿到链接的人都能打开。你可以在服务的“访问”设置中加以限制。"
          }
        }
      }
    },
