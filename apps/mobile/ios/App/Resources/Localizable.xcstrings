    "Have the new owner scan this": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide al nuevo propietario que escanee esto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites scanner ceci par le nouveau propriétaire"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass den neuen Eigentümer das hier scannen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça ao novo proprietário que escaneie isto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい所有者にこれをスキャンしてもらってください"
          }
        },
