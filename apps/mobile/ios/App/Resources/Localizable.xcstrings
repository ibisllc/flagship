    "Anyone with this key can read everything on this server while it's on.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera con esta clave puede leer todo lo que hay en este servidor mientras esté activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne disposant de cette clé peut lire tout ce qui se trouve sur ce serveur tant qu’elle est active."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder mit diesem Schlüssel kann alles auf diesem Server lesen, solange er eingeschaltet ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa com esta chave pode ler tudo neste servidor enquanto ela estiver ativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーを持つ人は、有効な間、このサーバー上のすべてを読み取れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何持有此密钥的人，在它开启期间都可以读取此服务器上的一切内容。"
          }
        }
      }
    },
    "Only an admin device can turn debug access on or off.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un dispositivo administrador puede activar o desactivar el acceso de depuración."
          }
        },
        "fr": {
