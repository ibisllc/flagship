            "state": "translated",
            "value": "Seul un appareil administrateur peut activer ou désactiver l’accès de débogage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Admin-Gerät kann den Debug-Zugriff ein- oder ausschalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente um dispositivo administrador pode ativar ou desativar o acesso de depuração."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバッグアクセスのオン／オフを切り替えられるのは管理者デバイスだけです。"
          }
        },
        "zh-Hans": {
