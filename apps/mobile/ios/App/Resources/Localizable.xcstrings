    "Only you can use this server. Share it to let another person see it or help run it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tú puedes usar este servidor. Compártelo para que otra persona lo vea o ayude a gestionarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous seul pouvez utiliser ce serveur. Partagez-le pour que quelqu’un d’autre puisse le voir ou aider à l’exploiter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur du kannst diesen Server nutzen. Teile ihn, damit eine andere Person ihn sehen oder beim Betrieb helfen kann."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só você pode usar este servidor. Compartilhe para que outra pessoa o veja ou ajude a administrá-lo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーを使えるのはあなただけです。共有すると、他の人が閲覧したり、運用を手伝ったりできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
