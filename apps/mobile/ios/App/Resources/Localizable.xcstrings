    "You lose access at once. The owner would have to share it with you again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierdes el acceso de inmediato. El propietario tendría que volver a compartirlo contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous perdez l’accès immédiatement. Le propriétaire devrait le partager à nouveau avec vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verlierst sofort den Zugriff. Der Eigentümer müsste ihn erneut mit dir teilen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você perde o acesso imediatamente. O proprietário teria que compartilhá-lo com você de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスはただちに失われます。再び利用するには、所有者がもう一度共有する必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会立即失去访问权限。所有者需要重新与你共享。"
          }
        }
      }
    },
