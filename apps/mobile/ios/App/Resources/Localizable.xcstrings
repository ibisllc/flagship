    "Names & photos stay encrypted to your account — flagshipserver.com stores only ciphertext. Send the link over a private channel.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres y las fotos permanecen cifrados para tu cuenta: flagshipserver.com solo guarda texto cifrado. Envía el enlace por un canal privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms et les photos restent chiffrés pour votre compte : flagshipserver.com ne stocke que du texte chiffré. Envoyez le lien par un canal privé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen und Fotos bleiben für dein Konto verschlüsselt – flagshipserver.com speichert nur Geheimtext. Sende den Link über einen privaten Kanal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes e fotos permanecem criptografados para a sua conta — o flagshipserver.com armazena apenas texto cifrado. Envie o link por um canal privado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と写真はアカウント向けに暗号化されたままで、flagshipserver.com には暗号文だけが保存されます。リンクは非公開の手段で送ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "姓名和照片会一直对你的账户保持加密，flagshipserver.com 只存储密文。请通过私密渠道发送链接。"
          }
        }
      }
    },
