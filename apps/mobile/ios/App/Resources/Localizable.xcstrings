          }
        }
      }
    },
    "Check the codes match": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que los códigos coinciden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que les codes correspondent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob die Codes übereinstimmen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira se os códigos são iguais"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが一致していることを確認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认代码一致"
          }
        }
      }
    },
    "Both screens should show the same six digits. If they don't, stop — someone may be in the middle.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas pantallas deben mostrar los mismos seis dígitos. Si no es así, detente: puede que alguien esté interceptando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux écrans doivent afficher les mêmes six chiffres. Sinon, arrêtez : quelqu’un est peut-être en train de s’interposer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Bildschirme sollten dieselben sechs Ziffern zeigen. Wenn nicht, brich ab – jemand könnte sich dazwischenschalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas telas devem mostrar os mesmos seis dígitos. Se não mostrarem, pare — alguém pode estar no meio do caminho."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の画面に同じ 6 桁が表示されるはずです。違う場合は中止してください。誰かが介在している可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个屏幕应显示相同的六位数字。如果不一致，请立即停止：可能有人在中途拦截。"
          }
        }
      }
    },
    "Confirm codes match": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar que los códigos coinciden"
