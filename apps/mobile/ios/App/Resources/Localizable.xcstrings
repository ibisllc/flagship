          "stringUnit": {
            "state": "translated",
            "value": "L’ancien serveur est gelé et écrit sa sauvegarde finale…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der alte Server ist eingefroren und schreibt sein letztes Backup …"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor antigo está congelado e gravando o backup final…"
          }
        },
        "ja": {
