    "This permanently deletes your account": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina tu cuenta de forma permanente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement votre compte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird dein Konto dauerhaft gelöscht"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui sua conta permanentemente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは完全に削除されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除你的账户"
          }
        }
      }
    },
    "There is no cloud recovery and no other device on this account, so the key on this phone is the only copy of your identity. Deleting it can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay recuperación en la nube ni otro dispositivo en esta cuenta, así que la clave de este teléfono es la única copia de tu identidad. Borrarla no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a ni récupération dans le cloud ni autre appareil sur ce compte ; la clé de ce téléphone est donc la seule copie de votre identité. La supprimer est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto hat keine Cloud-Wiederherstellung und kein anderes Gerät, daher ist der Schlüssel auf diesem Telefon die einzige Kopie deiner Identität. Ihn zu löschen lässt sich nicht rückgängig machen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta não tem recuperação na nuvem nem outro dispositivo, então a chave deste celular é a única cópia da sua identidade. Excluí-la não pode ser desfeito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントにはクラウドリカバリーも他のデバイスもないため、このスマートフォンのキーがあなたの ID の唯一のコピーです。削除すると元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户没有云恢复，也没有其他设备，因此这部手机上的密钥是你身份的唯一副本。删除它后无法撤销。"
          }
        }
      }
    },
    "Username “%@” is lost": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pierde el nombre de usuario «%@»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d’utilisateur « %@ » est perdu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzername „%@“ geht verloren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome de usuário “%@” é perdido"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー名「%@」は失われます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名“%@”将丢失"
          }
        }
      }
    },
    "It frees immediately and may be claimed by someone else.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda libre de inmediato y otra persona podría reclamarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est libéré immédiatement et peut être réclamé par quelqu’un d’autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird sofort frei und kann von jemand anderem beansprucht werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele é liberado imediatamente e pode ser reivindicado por outra pessoa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ただちに解放され、他の人が取得できるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会立即释放，可能被其他人占用。"
          }
        }
      }
    },
    "Your servers go dark": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus servidores se quedan a oscuras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos serveurs deviennent injoignables"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Server gehen dunkel"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus servidores ficam no escuro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが応答しなくなります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的服务器将失联"
          }
        }
      }
    },
    "They stop being reachable and manageable. If you want to keep one, transfer it first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejan de ser accesibles y gestionables. Si quieres conservar uno, transfiérelo antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ne sont plus joignables ni gérables. Si vous voulez en garder un, transférez-le d’abord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind nicht mehr erreichbar und verwaltbar. Wenn du einen behalten willst, übertrage ihn zuerst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles deixam de ficar acessíveis e gerenciáveis. Se quiser manter um, transfira-o antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続も管理もできなくなります。残したいサーバーがある場合は、先に移管してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们将无法访问，也无法管理。如果想保留某台服务器，请先转移它。"
          }
        }
      }
    },
    "No recovery": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin recuperación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune récupération"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Wiederherstellung"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem recuperação"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーなし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无恢复方式"
          }
        }
      }
    },
    "No passkey, no other device, no reset. This is final.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin llave de acceso, sin otro dispositivo, sin restablecimiento. Es definitivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de clé d’accès, pas d’autre appareil, pas de réinitialisation. C’est définitif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Passkey, kein anderes Gerät, kein Zurücksetzen. Das ist endgültig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem passkey, sem outro dispositivo, sem redefinição. Isto é definitivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキーも、別のデバイスも、リセットもありません。これは最終的な操作です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有通行密钥，没有其他设备，也无法重置。这是最终操作。"
          }
        }
      }
    },
    "Keep a server? Transfer it to another account first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres conservar un servidor? Transfiérelo antes a otra cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voulez garder un serveur ? Transférez-le d’abord vers un autre compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Server behalten? Übertrage ihn zuerst auf ein anderes Konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quer manter um servidor? Transfira-o antes para outra conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーを残したいですか？先に別のアカウントへ移管してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想保留某台服务器？请先把它转移到另一个账户。"
          }
        }
      }
    },
    "Ask all my servers to delete their content": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir a todos mis servidores que borren su contenido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander à tous mes serveurs de supprimer leur contenu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle meine Server bitten, ihre Inhalte zu löschen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir que todos os meus servidores apaguem o conteúdo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのサーバーにコンテンツの削除を依頼"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要求我的所有服务器删除其内容"
          }
        }
      }
    },
    "Off by default. Sends a wipe order to every server you own — bundled with the deletion, never on its own.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Envía una orden de borrado a cada servidor que posees, junto con la eliminación y nunca por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Envoie un ordre d’effacement à chaque serveur que vous possédez, joint à la suppression, jamais seul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Sendet einen Löschauftrag an jeden deiner Server – zusammen mit der Löschung, nie allein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Envia uma ordem de apagamento a cada servidor que você possui, junto com a exclusão, nunca isoladamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定ではオフです。所有しているすべてのサーバーに消去指示を送ります。アカウント削除と同時にのみ送信され、単独では送られません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。会向你拥有的每台服务器发送擦除指令，与账户删除一并发出，绝不单独发送。"
          }
        }
      }
    },
    "Delete your account": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar tu cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer votre compte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto löschen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir sua conta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除你的账户"
          }
        }
      }
    },
    "No active account on this device.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna cuenta activa en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte actif sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist kein Konto aktiv."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta ativa neste dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはアクティブなアカウントがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上没有活动账户。"
          }
        }
      }
    },
    "Couldn't access your account key: %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a la clave de tu cuenta: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’accéder à la clé de votre compte : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinen Kontoschlüssel konnte nicht zugegriffen werden: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar a chave da sua conta: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントキーにアクセスできませんでした：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问你的账户密钥：%@"
          }
        }
      }
    },
    "Couldn't sign: %@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo firmar: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de signer : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signieren nicht möglich: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível assinar: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名できませんでした：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法签名：%@"
          }
        }
      }
    },
    "Another device is still on this account. Remove it in Settings, Trusted devices, then delete the account.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro dispositivo sigue en esta cuenta. Quítalo en Ajustes, Dispositivos de confianza y luego elimina la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre appareil est toujours sur ce compte. Retirez-le dans Réglages, Appareils de confiance, puis supprimez le compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Gerät ist noch in diesem Konto. Entferne es unter Einstellungen, Vertrauenswürdige Geräte, und lösche dann das Konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro dispositivo ainda está nesta conta. Remova-o em Ajustes, Dispositivos confiáveis, e depois exclua a conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントには別のデバイスがまだあります。「設定」→「信頼済みデバイス」で削除してから、アカウントを削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备仍在此账户上。请先在“设置”→“受信任的设备”中移除它，然后再删除账户。"
          }
        }
      }
    },
    "The server rejected the request. Sign in again and retry.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó la solicitud. Vuelve a iniciar sesión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a rejeté la demande. Reconnectez-vous et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anfrage abgelehnt. Melde dich erneut an und versuche es noch einmal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor rejeitou a solicitação. Entre de novo e tente outra vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがリクエストを拒否しました。サインインし直してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了请求。请重新登录后重试。"
          }
        }
      }
    },
    "Couldn't reach the server. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servidor. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le serveur. Vérifiez votre connexion et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar o servidor. Verifique sua conexão e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接服务器。请检查网络连接后重试。"
          }
        }
      }
    },
    "That didn't work. Try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No funcionó. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela n’a pas fonctionné. Réessayez dans un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nicht funktioniert. Versuche es gleich noch einmal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não funcionou. Tente de novo em instantes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいきませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能成功。请稍后再试。"
          }
        }
      }
    },
