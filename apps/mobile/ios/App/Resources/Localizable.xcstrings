    "Your server is finishing setup. Confirm it's yours to release its boot secret. Only your phone can.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor está terminando la configuración. Confirma que es tuyo para liberar su secreto de arranque. Solo tu teléfono puede hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur termine sa configuration. Confirmez qu’il est bien à vous pour libérer son secret de démarrage. Seul votre téléphone peut le faire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server schließt die Einrichtung ab. Bestätige, dass er dir gehört, um sein Boot-Geheimnis freizugeben. Nur dein Telefon kann das."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor está terminando a configuração. Confirme que ele é seu para liberar o segredo de inicialização dele. Só o seu celular pode fazer isso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがセットアップを仕上げています。起動用シークレットを解放するため、自分のものであることを確認してください。これができるのはあなたのスマートフォンだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的服务器正在完成设置。请确认它属于你，以释放其启动密钥。只有你的手机能做到。"
          }
        }
      }
    },
