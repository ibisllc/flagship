    "You sent an invite to %@ and they accepted. Approving binds their access. (You won't see their username — only the label you gave them.)": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaste una invitación a %@ y la aceptó. Al aprobarla, vinculas su acceso. (No verás su nombre de usuario, solo la etiqueta que le pusiste.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez envoyé une invitation à %@ et elle a été acceptée. L’approuver lie son accès. (Vous ne verrez pas son nom d’utilisateur, seulement le libellé que vous lui avez donné.)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %@ eine Einladung geschickt, und sie wurde angenommen. Mit der Genehmigung bindest du den Zugriff. (Du siehst nicht den Benutzernamen, nur die Bezeichnung, die du vergeben hast.)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você enviou um convite para %@ e foi aceito. Aprovar vincula o acesso da pessoa. (Você não verá o nome de usuário dela, apenas o rótulo que você deu.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に招待を送り、承諾されました。承認すると、その人のアクセスが確定します。（ユーザー名は表示されず、あなたが付けたラベルだけが見えます。）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你向 %@ 发送了邀请，对方已接受。批准后即绑定其访问权限。（你看不到对方的用户名，只能看到你给 TA 起的标签。）"
          }
        }
      }
    },
    "They now have access to %@.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora tiene acceso a %@."
