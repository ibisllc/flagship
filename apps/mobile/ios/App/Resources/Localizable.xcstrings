    "To fix it on your server now, use Edit this service to change it with AI.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para corregirlo ahora en tu servidor, usa Editar este servicio y cámbialo con IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le corriger dès maintenant sur votre serveur, utilisez Modifier ce service pour le changer avec l’IA."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um es jetzt auf deinem Server zu beheben, nutze „Diesen Dienst bearbeiten“ und ändere es mit KI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para corrigir agora no seu servidor, use Editar este serviço e altere com IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまサーバー上で直すには、「このサービスを編集」で AI を使って変更してください。"
