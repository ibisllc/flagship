    "Open the recipe in Flagship Studio, write the boot USB, and boot the target machine. The new server will phone home and finish setup automatically.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta en Flagship Studio, graba la memoria USB de arranque y arranca el equipo de destino. El servidor nuevo avisará solo y terminará la configuración automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la recette dans Flagship Studio, écrivez la clé USB de démarrage et démarrez la machine cible. Le nouveau serveur se manifestera de lui-même et terminera la configuration automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne das Rezept in Flagship Studio, schreibe den Boot-USB-Stick und starte den Zielrechner. Der neue Server meldet sich von selbst und schließt die Einrichtung automatisch ab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a receita no Flagship Studio, grave o pen drive de inicialização e inicie a máquina de destino. O novo servidor dará sinal sozinho e concluirá a configuração automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship Studio でレシピを開き、起動用 USB を書き込んで、対象のマシンを起動してください。新しいサーバーが自動的に連絡してきて、セットアップを完了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Flagship Studio 中打开配方，写入启动 U 盘，然后启动目标机器。新服务器会自行回报并自动完成设置。"
          }
        }
      }
    },
