    "Is this your repo? Commit this file at its root and every Flagship server will run it this way.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Es tu repositorio? Sube este archivo a su raíz y todos los servidores Flagship lo ejecutarán así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est votre dépôt ? Validez ce fichier à sa racine et chaque serveur Flagship l’exécutera ainsi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das dein Repository? Committe diese Datei in sein Stammverzeichnis, und jeder Flagship-Server führt es so aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o seu repositório? Faça commit deste arquivo na raiz dele e todo servidor Flagship o executará assim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身のリポジトリですか？このファイルをルートにコミットすると、すべての Flagship サーバーがこの設定で実行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你的仓库吗？把此文件提交到它的根目录，所有 Flagship 服务器就会按此方式运行它。"
          }
        }
      }
    },
