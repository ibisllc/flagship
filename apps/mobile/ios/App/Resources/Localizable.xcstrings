    },
    "Your admin key changed. Enter your recovery passphrase to update your recovery backup — otherwise recovery would restore the OLD admin key.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave de administrador cambió. Introduce tu frase de contraseña de recuperación para actualizar tu copia de seguridad de recuperación; de lo contrario, la recuperación restauraría la clave de administrador ANTIGUA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé d’administrateur a changé. Saisissez votre phrase secrète de récupération pour mettre à jour votre sauvegarde de récupération ; sinon la récupération restaurerait l’ANCIENNE clé d’administrateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Admin-Schlüssel hat sich geändert. Gib deine Wiederherstellungs-Passphrase ein, um dein Wiederherstellungs-Backup zu aktualisieren – sonst würde die Wiederherstellung den ALTEN Admin-Schlüssel zurückspielen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave de administrador mudou. Digite sua frase secreta de recuperação para atualizar seu backup de recuperação — caso contrário, a recuperação restauraria a chave de administrador ANTIGA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者キーが変わりました。リカバリーバックアップを更新するため、リカバリーパスフレーズを入力してください。更新しないと、リカバリー時に古い管理者キーが復元されてしまいます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的管理员密钥已更改。请输入恢复密码短语来更新恢复备份，否则恢复时会还原旧的管理员密钥。"
          }
        }
      }
    },
