    "Add this to your IDE's own settings, not a file in your project (the address names your server). The key works only for this build.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade esto a los ajustes propios de tu IDE, no a un archivo de tu proyecto (la dirección nombra tu servidor). La clave solo sirve para esta compilación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez ceci aux réglages propres à votre IDE, pas à un fichier de votre projet (l’adresse désigne votre serveur). La clé ne fonctionne que pour cette création."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge das den eigenen Einstellungen deiner IDE hinzu, nicht einer Datei in deinem Projekt (die Adresse nennt deinen Server). Der Schlüssel gilt nur für diesen Build."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione isto às configurações do seu IDE, não a um arquivo do seu projeto (o endereço nomeia o seu servidor). A chave funciona apenas para este build."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはプロジェクト内のファイルではなく、IDE 自体の設定に追加してください（アドレスにサーバー名が含まれます）。このキーはこのビルドでのみ有効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请把它添加到你 IDE 自己的设置中，而不是项目里的文件（该地址包含你的服务器名称）。此密钥仅对本次构建有效。"
          }
        }
      }
    },
