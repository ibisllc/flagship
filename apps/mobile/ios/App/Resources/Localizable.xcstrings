    "Tap to affirm — otherwise it locks when the window lapses.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para confirmar; si no, se bloquea cuando venza el intervalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour confirmer — sinon, il se verrouille à l’expiration du délai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zum Bestätigen – sonst sperrt er, wenn das Zeitfenster abläuft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para confirmar — caso contrário, ele bloqueia quando a janela expirar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして確認してください。確認しないと、期間が切れたときにロックされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以确认，否则时间窗口到期时会锁定。"
          }
        }
      }
    },
    "The debug access grant doesn't name a server.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La concesión de acceso de depuración no indica ningún servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’accès de débogage ne désigne aucun serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Debug-Freigabe nennt keinen Server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A concessão de acesso de depuração não indica nenhum servidor."
          }
