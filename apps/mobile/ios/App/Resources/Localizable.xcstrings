    "%@ won't learn your account name. They see only the name they gave you.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no sabrá el nombre de tu cuenta. Solo ve el nombre que te puso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne connaîtra pas le nom de votre compte. Il ne voit que le nom qu’il vous a donné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erfährt deinen Kontonamen nicht. Die Person sieht nur den Namen, den sie dir gegeben hat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não saberá o nome da sua conta. Só vê o nome que deu a você."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にアカウント名は知られません。相手に見えるのは、相手が付けた名前だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不会得知你的账户名。TA 只能看到 TA 给你起的名字。"
          }
        }
      }
    },
    "You can approve its start-ups.": {
