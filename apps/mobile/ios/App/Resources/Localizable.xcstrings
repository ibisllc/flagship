    "A build session already uses \"%@\". To use the name for a new build, open Build sessions and discard that one first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión de compilación ya usa «%@». Para usar el nombre en una compilación nueva, abre Sesiones de compilación y descarta antes esa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session de création utilise déjà « %@ ». Pour utiliser ce nom pour une nouvelle création, ouvrez Sessions de création et abandonnez d’abord celle-ci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Build-Sitzung verwendet „%@“ bereits. Um den Namen für einen neuen Build zu nutzen, öffne „Build-Sitzungen“ und verwirf zuerst diese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão de build já usa “%@”. Para usar o nome em um novo build, abra Sessões de build e descarte essa primeiro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドセッションがすでに「%@」を使っています。この名前を新しいビルドで使うには、「ビルドセッション」を開いて、先にそのセッションを破棄してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
