          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces six chiffres doivent correspondre à l’écran de l’administrateur. Confirmez le nom chiffré que cet appareil utilisera uniquement dans ce compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese sechs Ziffern sollten mit dem Bildschirm des Admins übereinstimmen. Bestätige den verschlüsselten Namen, den dieses Gerät nur in diesem Konto verwendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes seis dígitos devem ser iguais aos da tela do administrador. Confirme o nome criptografado que este dispositivo usará somente nesta conta."
          }
