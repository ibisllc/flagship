    "Your authenticator was set up on this device on %@. Store your recovery codes somewhere safe — they're the only way back in if your authenticator app is lost.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu autenticador se configuró en este dispositivo el %@. Guarda tus códigos de recuperación en un lugar seguro: son la única forma de volver a entrar si pierdes tu app de autenticación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre authentificateur a été configuré sur cet appareil le %@. Conservez vos codes de récupération en lieu sûr : c’est le seul moyen de revenir si vous perdez votre application d’authentification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Authenticator wurde am %@ auf diesem Gerät eingerichtet. Bewahre deine Wiederherstellungscodes sicher auf – sie sind der einzige Weg zurück, falls deine Authenticator-App verloren geht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu autenticador foi configurado neste dispositivo em %@. Guarde seus códigos de recuperação em um lugar seguro — eles são a única forma de voltar se você perder seu app autenticador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリは %@ にこのデバイスで設定されました。リカバリーコードは安全な場所に保管してください。認証アプリを失った場合、再びサインインする唯一の手段です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的验证器于 %@ 在此设备上设置。请把恢复代码存放在安全的地方：如果验证器应用丢失，它们是你重新登录的唯一途径。"
          }
        }
      }
    },
    "Turn off code protection": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar la protección con código"
          }
