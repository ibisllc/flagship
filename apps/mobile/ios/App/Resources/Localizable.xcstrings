    "It's read where it is; nothing is copied onto this phone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lee donde está; no se copia nada en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est lu là où il se trouve ; rien n’est copié sur ce téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird dort gelesen, wo es liegt; nichts wird auf dieses Telefon kopiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É lido onde está; nada é copiado para este celular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存場所で直接読み取ります。このスマートフォンには何もコピーされません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它就地读取，不会复制任何内容到这部手机。"
          }
        }
      }
    },
    "%@ is waiting for its backup. Pick the backup's .flagship file and this screen sends it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está esperando su copia de seguridad. Elige el archivo .flagship de la copia y esta pantalla se lo envía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ attend sa sauvegarde. Choisissez le fichier .flagship de la sauvegarde et cet écran le lui envoie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wartet auf sein Backup. Wähle die .flagship-Datei des Backups, und dieser Bildschirm sendet sie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está aguardando o backup. Escolha o arquivo .flagship do backup e esta tela o envia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がバックアップを待っています。バックアップの .flagship ファイルを選ぶと、この画面が送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在等待其备份。选择该备份的 .flagship 文件，此界面会把它发送过去。"
          }
        }
      }
    },
