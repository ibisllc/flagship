    "We cancelled this for your security because a screenshot was taken. Scan the admin's code again to join.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo cancelamos por tu seguridad porque se hizo una captura de pantalla. Vuelve a escanear el código del administrador para unirte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous l’avons annulé pour votre sécurité car une capture d’écran a été prise. Scannez à nouveau le code de l’administrateur pour rejoindre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben das zu deiner Sicherheit abgebrochen, weil ein Screenshot gemacht wurde. Scanne den Code des Admins erneut, um beizutreten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelamos isto pela sua segurança porque uma captura de tela foi feita. Escaneie o código do administrador de novo para entrar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットが撮影されたため、安全のためキャンセルしました。参加するには、管理者のコードをもう一度スキャンしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于截了屏，为了你的安全我们已取消此操作。请重新扫描管理员的代码以加入。"
          }
        }
      }
    },
    "Point your camera at the pairing code on the admin's \"Add a device\" screen.": {
