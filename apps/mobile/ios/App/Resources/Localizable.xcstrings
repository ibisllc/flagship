    "This phone needs about %@ free to keep a copy.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono necesita unos %@ libres para guardar una copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone a besoin d’environ %@ libres pour conserver une copie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon braucht etwa %@ freien Speicher, um eine Kopie zu behalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este celular precisa de cerca de %@ livres para guardar uma cópia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーを保管するには、このスマートフォンに約 %@ の空き容量が必要です。"
