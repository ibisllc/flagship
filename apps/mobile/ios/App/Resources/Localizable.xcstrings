    "Another rotation completed first. Your account is fine — refresh and check Activity for the audit trail.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes se completó otra rotación. Tu cuenta está bien: actualiza y consulta Actividad para ver el rastro de auditoría."
          }
        },
        "fr": {
          "stringUnit": {
