    "This stops the AI and deletes what it has written on your server.%@": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto detiene la IA y elimina lo que ha escrito en tu servidor.%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela arrête l’IA et supprime ce qu’elle a écrit sur votre serveur.%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die KI gestoppt und gelöscht, was sie auf deinem Server geschrieben hat.%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso para a IA e exclui o que ela escreveu no seu servidor.%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI を停止し、サーバー上に書き込んだ内容を削除します。%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会停止 AI，并删除它在你的服务器上写入的内容。%@"
          }
        }
      }
    },
    "This deletes what was imported or written on your server. Its name, \"%@\", becomes free again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina lo que se importó o se escribió en tu servidor. Su nombre, «%@», vuelve a quedar libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime ce qui a été importé ou écrit sur votre serveur. Son nom, « %@ », redevient libre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird gelöscht, was auf deinem Server importiert oder geschrieben wurde. Sein Name „%@“ wird wieder frei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui o que foi importado ou escrito no seu servidor. O nome dele, “%@”, fica livre de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー上でインポートまたは作成された内容を削除します。名前「%@」は再び使えるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除在你的服务器上导入或编写的内容。其名称“%@”将再次可用。"
          }
        }
      }
    },
