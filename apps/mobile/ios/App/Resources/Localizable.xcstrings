    "Lowercase letters, digits, and hyphens. 1–40 characters. No leading or trailing hyphen.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras minúsculas, dígitos y guiones. De 1 a 40 caracteres. Sin guion al principio ni al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettres minuscules, chiffres et tirets. 1 à 40 caractères. Pas de tiret au début ni à la fin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinbuchstaben, Ziffern und Bindestriche. 1–40 Zeichen. Kein Bindestrich am Anfang oder Ende."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras minúsculas, dígitos e hifens. 1–40 caracteres. Sem hífen no início ou no fim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小文字、数字、ハイフン。1～40 文字。先頭と末尾にハイフンは使えません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小写字母、数字和连字符。1–40 个字符。开头和结尾不能是连字符。"
          }
        }
      }
    },
