          }
        }
      }
    },
    "Go back to the browser: it opens %@ on its own. You can refresh or stop this session anytime from Settings → Open secured sessions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve al navegador: abre %@ por sí solo. Puedes actualizar o detener esta sesión cuando quieras en Ajustes → Abrir sesiones protegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retournez au navigateur : il ouvre %@ tout seul. Vous pouvez actualiser ou arrêter cette session à tout moment dans Réglages → Ouvrir les sessions sécurisées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe zurück zum Browser: Er öffnet %@ von selbst. Du kannst diese Sitzung jederzeit unter Einstellungen → Gesicherte Sitzungen öffnen aktualisieren oder beenden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte ao navegador: ele abre %@ sozinho. Você pode atualizar ou parar esta sessão a qualquer momento em Ajustes → Abrir sessões protegidas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザーに戻ってください。%@ は自動的に開きます。このセッションは、「設定」→「保護されたセッションを開く」からいつでも更新または停止できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请回到浏览器：它会自动打开 %@。你可以随时在“设置”→“打开受保护的会话”中刷新或停止此会话。"
          }
        }
      }
    },
    "Signed in": {
      "extractionState": "manual",
