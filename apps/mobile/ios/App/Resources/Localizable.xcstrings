            "value": "Ce serveur réserve d’abord de l’espace pour les fragments d’autres serveurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server reserviert zuerst Platz für die Teile anderer Server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está reservando primeiro espaço para os pedaços de outros servidores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは、まず他のサーバーの断片用に容量を確保しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器正在先为其他服务器的分片预留空间。"
          }
        }
      }
    },
    "Your newest backup is being spread over other servers.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu copia de seguridad más reciente se está repartiendo entre otros servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre sauvegarde la plus récente est en cours de répartition sur d’autres serveurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein neuestes Backup wird auf andere Server verteilt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu backup mais recente está sendo espalhado por outros servidores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のバックアップを他のサーバーに分散しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最新的备份正在分散到其他服务器上。"
          }
        }
      }
    },
    "Enough of the servers holding your pieces answer to bring your backup back.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suficientes servidores que guardan tus fragmentos responden para recuperar tu copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assez de serveurs conservant vos fragments répondent pour restaurer votre sauvegarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genügend Server, die deine Teile aufbewahren, antworten, um dein Backup wiederherzustellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores suficientes que guardam seus pedaços respondem para trazer seu backup de volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断片を保管しているサーバーのうち、バックアップを復元できるだけの数が応答しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存你分片的服务器中，有足够多的在响应，可以恢复你的备份。"
          }
        }
      }
    },
    "Too few pieces are safe. Your server is moving them to other servers.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay muy pocos fragmentos a salvo. Tu servidor los está moviendo a otros servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop peu de fragments sont en sécurité. Votre serveur les déplace vers d’autres serveurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenige Teile sind sicher. Dein Server verschiebt sie auf andere Server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Poucos pedaços estão seguros. Seu servidor os está movendo para outros servidores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な断片が少なすぎます。サーバーが他のサーバーに移動しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全的分片太少。你的服务器正在把它们转移到其他服务器。"
          }
        }
      }
    },
    "This server stops taking new pieces and frees its space in two weeks.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor deja de aceptar fragmentos nuevos y libera su espacio en dos semanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur cesse d’accepter de nouveaux fragments et libère son espace dans deux semaines."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server nimmt keine neuen Teile mehr an und gibt seinen Platz in zwei Wochen frei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor para de aceitar novos pedaços e libera o espaço em duas semanas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは新しい断片の受け入れを停止し、2 週間後に容量を解放します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器将停止接收新分片，并在两周后释放其空间。"
          }
        }
      }
    },
    "Choose Peer-distributed backups in this server's Backups to turn it on.": {
      "extractionState": "manual",
