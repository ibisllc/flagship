    "The browser session will end immediately. It can reconnect any time with a fresh QR.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión del navegador terminará de inmediato. Puede volver a conectarse cuando quiera con un QR nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session du navigateur prendra fin immédiatement. Il peut se reconnecter à tout moment avec un nouveau QR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Browsersitzung endet sofort. Er kann sich jederzeit mit einem neuen QR-Code wieder verbinden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão do navegador será encerrada imediatamente. Ele pode se reconectar a qualquer momento com um QR novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザーのセッションはすぐに終了します。新しい QR コードで、いつでも再接続できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该浏览器会话将立即结束。它随时可以通过新的二维码重新连接。"
          }
        }
      }
    },
