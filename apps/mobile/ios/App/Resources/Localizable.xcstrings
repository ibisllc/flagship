    "Your server is waiting for authorization to serve": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor espera autorización para atender"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur attend l’autorisation de servir"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server wartet auf die Autorisierung zum Bereitstellen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor aguarda autorização para atender"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが提供の承認を待っています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的服务器正在等待提供服务的授权"
          }
        }
      }
    },
    "Your server is waiting for your approval to unlock": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor espera tu aprobación para desbloquearse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur attend votre approbation pour se déverrouiller"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server wartet auf deine Genehmigung zum Entsperren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor aguarda a sua aprovação para desbloquear"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがロック解除の承認を待っています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的服务器正在等待你批准解锁"
          }
        }
      }
    },
    "Authorize this server to serve your account so it can come online. Your phone will ask you to unlock once to approve.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriza a este servidor para que sirva a tu cuenta y pueda ponerse en línea. Tu teléfono te pedirá desbloquear una vez para aprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez ce serveur à servir votre compte pour qu’il puisse se mettre en ligne. Votre téléphone vous demandera de le déverrouiller une fois pour approuver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisiere diesen Server, dein Konto zu bedienen, damit er online gehen kann. Dein Telefon fordert dich einmal zum Entsperren auf, um zu genehmigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorize este servidor a atender sua conta para que ele possa ficar online. Seu celular vai pedir que você desbloqueie uma vez para aprovar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーにアカウントへの提供を承認すると、オンラインになれます。承認のため、スマートフォンのロック解除を一度求められます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权此服务器为你的账户提供服务，它才能上线。你的手机会要求你解锁一次以批准。"
          }
        }
      }
    },
    "If you just powered it on, release its disk key to bring it online. Your phone will ask you to unlock once to approve.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si acabas de encenderlo, libera la clave de su disco para ponerlo en línea. Tu teléfono te pedirá desbloquear una vez para aprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous venez de l’allumer, libérez la clé de son disque pour le mettre en ligne. Votre téléphone vous demandera de le déverrouiller une fois pour approuver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ihn gerade eingeschaltet hast, gib seinen Datenträgerschlüssel frei, um ihn online zu bringen. Dein Telefon fordert dich einmal zum Entsperren auf, um zu genehmigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você acabou de ligá-lo, libere a chave do disco dele para colocá-lo online. Seu celular vai pedir que você desbloqueie uma vez para aprovar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源を入れたばかりの場合は、ディスクキーを解放してオンラインにしてください。承認のため、スマートフォンのロック解除を一度求められます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你刚刚开机，请释放其磁盘密钥让它上线。你的手机会要求你解锁一次以批准。"
          }
        }
      }
    },
