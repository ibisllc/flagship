    "The demo server is online, but this device couldn't create a paired session. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de demostración está en línea, pero este dispositivo no pudo crear una sesión vinculada. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de démonstration est en ligne, mais cet appareil n’a pas pu créer de session associée. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Demo-Server ist online, aber dieses Gerät konnte keine gekoppelte Sitzung erstellen. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de demonstração está online, mas este dispositivo não conseguiu criar uma sessão pareada. Tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモサーバーはオンラインですが、このデバイスはペアリング済みセッションを作成できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示服务器已上线，但此设备无法创建配对会话。请重试。"
          }
        }
      }
    },
    "No Flagship account by that name": {
      "extractionState": "manual",
      "localizations": {
        "es": {
