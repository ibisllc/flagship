    "This change was signed for a different server. Reload the page and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cambio se firmó para otro servidor. Vuelve a cargar la página e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette modification a été signée pour un autre serveur. Rechargez la page et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Änderung wurde für einen anderen Server signiert. Lade die Seite neu und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alteração foi assinada para outro servidor. Recarregue a página e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変更は別のサーバー向けに署名されています。ページを再読み込みして、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此更改是为另一台服务器签署的。请重新加载页面后重试。"
          }
        }
      }
    },
    "Your phone's clock is too far off from the server's. Check the date and time, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj de tu teléfono está demasiado desajustado respecto al del servidor. Revisa la fecha y la hora e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’horloge de votre téléphone est trop décalée par rapport à celle du serveur. Vérifiez la date et l’heure, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr deines Telefons weicht zu stark von der des Servers ab. Prüfe Datum und Uhrzeit und versuche es dann erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio do seu celular está muito diferente do do servidor. Confira a data e a hora e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンの時計がサーバーの時計から大きくずれています。日付と時刻を確認してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你手机的时钟与服务器相差太大。请检查日期和时间后重试。"
          }
        }
      }
    },
    "The server didn't accept your signature. Only the account owner's phone can change this.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no aceptó tu firma. Solo el teléfono del titular de la cuenta puede cambiar esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas accepté votre signature. Seul le téléphone du titulaire du compte peut modifier ceci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat deine Signatur nicht akzeptiert. Nur das Telefon des Kontoinhabers kann das ändern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não aceitou sua assinatura. Somente o celular do dono da conta pode alterar isto."
