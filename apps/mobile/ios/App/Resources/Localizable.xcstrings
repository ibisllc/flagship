          }
        }
      }
    },
    "Your boot disk should have started downloading at flagshipserver.com. Flash it, boot any server, and progress will appear here as it phones home.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco de arranque debería haber empezado a descargarse desde flagshipserver.com. Grábalo, arranca cualquier servidor y el progreso aparecerá aquí cuando avise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre disque de démarrage devrait avoir commencé à se télécharger depuis flagshipserver.com. Écrivez-le, démarrez n’importe quel serveur, et la progression apparaîtra ici dès qu’il se manifestera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Boot-Datenträger sollte von flagshipserver.com heruntergeladen werden. Schreibe ihn, starte einen beliebigen Server, und der Fortschritt erscheint hier, sobald er sich meldet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco de inicialização deve ter começado a ser baixado de flagshipserver.com. Grave-o, inicie qualquer servidor e o progresso aparecerá aqui assim que ele der sinal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動ディスクが flagshipserver.com からダウンロードされ始めているはずです。書き込んで任意のサーバーを起動すると、連絡が来た時点で進行状況がここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的启动盘应该已开始从 flagshipserver.com 下载。写入它并启动任意服务器，服务器回报后进度会显示在这里。"
          }
        }
      }
    },
    "Your server is provisioning. This usually takes a few minutes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor se está aprovisionando. Suele tardar unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
