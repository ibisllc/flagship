          }
        }
      }
    },
    "Server committed but local install failed: %@. Open the app fresh to recover.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor confirmó el cambio, pero falló la instalación local: %@. Abre la app de nuevo para recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a validé, mais l’installation locale a échoué : %@. Rouvrez l’app pour récupérer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat bestätigt, aber die lokale Installation ist fehlgeschlagen: %@. Öffne die App neu, um sie wiederherzustellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor confirmou, mas a instalação local falhou: %@. Abra o app do zero para recuperar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーは確定しましたが、ローカルのインストールに失敗しました：%@。アプリを開き直して復旧してください。"
