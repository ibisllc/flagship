            "state": "translated",
            "value": "Su base de datos permanece cerrada hasta que vuelva a estar por debajo de su límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa base de données reste fermée jusqu’à ce qu’elle repasse sous sa limite."
          }
        },
        "de": {
