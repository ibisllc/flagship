      }
    },
    "If you don't affirm in time, this server locks itself — it powers off (or restarts) and needs your phone to come back.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no confirmas a tiempo, este servidor se bloquea solo: se apaga (o se reinicia) y necesita tu teléfono para volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous ne confirmez pas à temps, ce serveur se verrouille de lui-même : il s’éteint (ou redémarre) et a besoin de votre téléphone pour revenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du nicht rechtzeitig bestätigst, sperrt sich dieser Server selbst: Er schaltet sich aus (oder startet neu) und braucht dein Telefon, um zurückzukehren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você não confirmar a tempo, este servidor se bloqueia sozinho: desliga (ou reinicia) e precisa do seu celular para voltar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間内に確認しないと、このサーバーは自動的にロックされます。電源が切れ（または再起動し）、復帰にはスマートフォンが必要になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你没有及时确认，此服务器会自行锁定：它会关机（或重启），并需要你的手机才能恢复。"
          }
        }
      }
    },
    "Lock-down on. Affirm to keep %@ unlocked.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueo de seguridad activado. Confirma para mantener %@ desbloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillage de sécurité activé. Confirmez pour garder %@ déverrouillé."
          }
        },
        "de": {
