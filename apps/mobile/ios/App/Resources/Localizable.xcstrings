    },
    "Only an admin device of your account can accept a co-manage invitation.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un dispositivo administrador de tu cuenta puede aceptar una invitación de coadministración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un appareil administrateur de votre compte peut accepter une invitation de cogestion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Admin-Gerät deines Kontos kann eine Einladung zur gemeinsamen Verwaltung annehmen."
          }
        },
        "pt-BR": {
