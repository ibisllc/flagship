        }
      }
    },
    "Flagship • Patent Pending • BUSL-1.1 • Your stuff, on your hardware.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship • Patente en trámite • BUSL-1.1 • Tus cosas, en tu hardware."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship • Brevet en instance • BUSL-1.1 • Vos affaires, sur votre matériel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship • Patent angemeldet • BUSL-1.1 • Deine Sachen, auf deiner Hardware."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship • Patente pendente • BUSL-1.1 • Suas coisas, no seu hardware."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagship • 特許出願中 • BUSL-1.1 • あなたのデータを、あなたのハードウェアで。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
