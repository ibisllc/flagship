    "At least 12 characters with three kinds (lowercase, uppercase, digits, symbols), or 20 of anything.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos 12 caracteres con tres tipos (minúsculas, mayúsculas, dígitos, símbolos), o 20 de cualquier tipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins 12 caractères avec trois types (minuscules, majuscules, chiffres, symboles), ou 20 de n’importe quel type."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 12 Zeichen mit drei Arten (Kleinbuchstaben, Großbuchstaben, Ziffern, Sonderzeichen) oder 20 beliebige."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos 12 caracteres com três tipos (minúsculas, maiúsculas, dígitos, símbolos), ou 20 de qualquer tipo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12 文字以上で 3 種類（小文字・大文字・数字・記号）を含めるか、種類を問わず 20 文字以上にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 12 个字符且包含三种类型（小写字母、大写字母、数字、符号），或任意类型的 20 个字符。"
          }
        }
      }
    },
