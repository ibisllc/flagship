    "This signs the browser at %@ in as you. Only do this for a browser you opened yourself.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto inicia sesión como tú en el navegador de %@. Hazlo solo con un navegador que hayas abierto tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela connecte le navigateur sur %@ en tant que vous. Ne le faites que pour un navigateur que vous avez ouvert vous-même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Browser bei %@ als du angemeldet. Tu das nur für einen Browser, den du selbst geöffnet hast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso conecta o navegador em %@ como você. Faça isso apenas com um navegador que você mesmo abriu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のブラウザーをあなたとしてサインインさせます。ご自身で開いたブラウザーに対してのみ実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会让 %@ 上的浏览器以你的身份登录。只对你自己打开的浏览器这样做。"
          }
        }
      }
    },
    "Signing in…": {
      "extractionState": "manual",
      "localizations": {
        "es": {
