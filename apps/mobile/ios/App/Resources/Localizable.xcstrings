    "If you lose this device, install Flagship on a new one, choose \"Connect to an existing account,\" and recover with your passphrase.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si pierdes este dispositivo, instala Flagship en uno nuevo, elige «Conectar con una cuenta existente» y recupera con tu frase de contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous perdez cet appareil, installez Flagship sur un nouveau, choisissez « Se connecter à un compte existant » et récupérez avec votre phrase secrète."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du dieses Gerät verlierst, installiere Flagship auf einem neuen, wähle „Mit einem bestehenden Konto verbinden“ und stelle mit deiner Passphrase wieder her."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você perder este dispositivo, instale o Flagship em um novo, escolha “Conectar a uma conta existente” e recupere com sua frase secreta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを紛失した場合は、新しいデバイスに Flagship をインストールし、「既存のアカウントに接続」を選んで、パスフレーズで復旧してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你丢失了这台设备，请在新设备上安装 Flagship，选择“连接到现有账户”，然后用你的密码短语恢复。"
          }
        }
      }
    },
