    },
    "Pair it to manage this server here. Your phone will ask you to unlock once to approve.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincúlalo para gestionar este servidor desde aquí. Tu teléfono te pedirá desbloquear una vez para aprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez-le pour gérer ce serveur ici. Votre téléphone vous demandera de le déverrouiller une fois pour approuver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln, um diesen Server hier zu verwalten. Dein Telefon fordert dich einmal zum Entsperren auf, um zu genehmigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareie para gerenciar este servidor aqui. Seu celular vai pedir que você desbloqueie uma vez para aprovar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングすると、ここでこのサーバーを管理できます。承認のため、スマートフォンのロック解除を一度求められます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对后即可在此管理此服务器。你的手机会要求你解锁一次以批准。"
          }
        }
      }
    },
    "Connecting to your server…": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando con tu servidor…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à votre serveur…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zu deinem Server wird hergestellt …"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando ao seu servidor…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続しています…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接你的服务器…"
          }
        }
      }
    },
    "Your server is online. We're fetching its details — this can take a moment right after it comes up. Pull down to refresh.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor está en línea. Estamos obteniendo sus detalles, lo que puede tardar un momento justo después de arrancar. Desliza hacia abajo para actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur est en ligne. Nous récupérons ses détails, ce qui peut prendre un instant juste après son démarrage. Tirez vers le bas pour actualiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server ist online. Wir rufen seine Details ab, was direkt nach dem Hochfahren einen Moment dauern kann. Zum Aktualisieren nach unten ziehen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor está online. Estamos buscando os detalhes dele, o que pode levar um instante logo após ele iniciar. Puxe para baixo para atualizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはオンラインです。詳細を取得しています。起動直後は少し時間がかかることがあります。下に引いて更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的服务器已上线。我们正在获取它的详细信息，刚启动时可能需要片刻。下拉以刷新。"
          }
        }
      }
    },
    "This server never came online": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor nunca se conectó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne s’est jamais mis en ligne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server ist nie online gegangen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor nunca ficou online"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは一度もオンラインになっていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器从未上线"
          }
        }
      }
    },
    "The install reserved this name and registered the server, but its software never checked in. If the install failed, you can delete it below — that frees the name so you can try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación reservó este nombre y registró el servidor, pero su software nunca avisó. Si la instalación falló, puedes eliminarlo más abajo: eso libera el nombre para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installation a réservé ce nom et enregistré le serveur, mais son logiciel ne s’est jamais manifesté. Si l’installation a échoué, vous pouvez le supprimer ci-dessous — cela libère le nom pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation hat diesen Namen reserviert und den Server registriert, aber seine Software hat sich nie gemeldet. Ist die Installation fehlgeschlagen, kannst du ihn unten löschen – das gibt den Namen für einen neuen Versuch frei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação reservou este nome e registrou o servidor, mas o software dele nunca deu sinal. Se a instalação falhou, você pode excluí-lo abaixo — isso libera o nome para tentar de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールで名前が確保されサーバーが登録されましたが、ソフトウェアから一度も応答がありませんでした。インストールに失敗した場合は、下で削除できます。名前が解放され、やり直せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装已预留此名称并注册了服务器，但其软件从未签到。如果安装失败，你可以在下方删除它，这会释放该名称，供你重试。"
          }
        }
      }
    },
    "This server is revoked": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está revocado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur est révoqué"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server ist widerrufen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está revogado"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは取り消されています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器已被撤销"
          }
        }
      }
    },
    "It can't connect or unlock until you un-revoke it. Its name stays reserved. Un-revoke it below if you got the server back, or delete it to free the name.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede conectarse ni desbloquearse hasta que lo restaures. Su nombre sigue reservado. Restáuralo abajo si recuperaste el servidor, o elimínalo para liberar el nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne peut ni se connecter ni se déverrouiller tant que vous ne l’avez pas rétabli. Son nom reste réservé. Rétablissez-le ci-dessous si vous avez récupéré le serveur, ou supprimez-le pour libérer le nom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kann sich nicht verbinden oder entsperren, bis du den Widerruf aufhebst. Sein Name bleibt reserviert. Hebe den Widerruf unten auf, wenn du den Server zurückhast, oder lösche ihn, um den Namen freizugeben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele não pode se conectar nem desbloquear até que você desfaça a revogação. O nome dele continua reservado. Desfaça a revogação abaixo se você recuperou o servidor, ou exclua-o para liberar o nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消しを解除するまで、接続もロック解除もできません。名前は確保されたままです。サーバーが戻ってきた場合は下で取り消しを解除し、そうでなければ削除して名前を解放してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你恢复之前，它无法连接或解锁。它的名称仍保留。如果你找回了服务器，请在下方恢复；也可以删除它以释放该名称。"
          }
        }
      }
    },
    "This server has gone offline. Pull down to re-check": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor se ha desconectado. Desliza hacia abajo para volver a comprobar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur est hors ligne. Tirez vers le bas pour revérifier"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server ist offline gegangen. Zum erneuten Prüfen nach unten ziehen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor ficou offline. Puxe para baixo para verificar de novo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーはオフラインになりました。下に引いて再確認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器已离线。下拉以重新检查"
          }
        }
      }
    },
    "Still coming up…": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía arrancando…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrage en cours…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fährt noch hoch …"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda iniciando…"
          }
        },
        "ja": {
