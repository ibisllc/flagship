          "stringUnit": {
            "state": "translated",
            "value": "スクリプト、デバイス、他のサーバーからこのアプリを呼び出せるようにします。各キーは、取り消すまで有効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
