        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile des Backups eines verlorenen Servers, die andere Flagship-Server aufbewahren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
