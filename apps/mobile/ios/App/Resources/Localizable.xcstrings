    "I understand anyone with this file and passphrase controls my entire account.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que quien tenga este archivo y esta frase de contraseña controla toda mi cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que toute personne disposant de ce fichier et de cette phrase secrète contrôle l’ensemble de mon compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist klar, dass jeder mit dieser Datei und Passphrase mein gesamtes Konto kontrolliert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendo que qualquer pessoa com este arquivo e esta frase secreta controla toda a minha conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルとパスフレーズを持つ人がアカウント全体を掌握できることを理解しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我明白，任何拥有此文件和密码短语的人都能控制我的整个账户。"
          }
        }
      }
    },
    "Backup saved. Keep it somewhere safe and offline.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia guardada. Consérvala en un lugar seguro y sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde enregistrée. Conservez-la en lieu sûr, hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup gespeichert. Bewahre es an einem sicheren Ort offline auf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup salvo. Guarde-o em um lugar seguro e offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを保存しました。オフラインの安全な場所に保管してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份已保存。请把它妥善保存在离线的安全位置。"
          }
        }
      }
    },
