    "Paste a repo URL. If it's Flagship-ready we install it as-is, otherwise the AI adapts it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega la URL de un repositorio. Si ya está listo para Flagship, lo instalamos tal cual; si no, la IA lo adapta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez l’URL d’un dépôt. S’il est prêt pour Flagship, nous l’installons tel quel ; sinon, l’IA l’adapte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die URL eines Repositorys ein. Ist es Flagship-fähig, installieren wir es unverändert; andernfalls passt die KI es an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole a URL de um repositório. Se já estiver pronto para o Flagship, instalamos como está; se não, a IA o adapta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリの URL を貼り付けてください。Flagship 対応済みならそのままインストールし、そうでなければ AI が調整します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴仓库 URL。如果它已适配 Flagship，我们会原样安装；否则由 AI 来适配。"
          }
        }
      }
    },
    "Connect your IDE": {
