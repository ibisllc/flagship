          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas accepté votre signature. Seul le téléphone du titulaire du compte peut autoriser cela."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat deine Signatur nicht akzeptiert. Nur das Telefon des Kontoinhabers kann das erlauben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não aceitou sua assinatura. Somente o celular do dono da conta pode permitir isso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがあなたの署名を受け付けませんでした。これを許可できるのは、アカウント所有者のスマートフォンだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器不接受你的签名。只有账户所有者的手机才能允许此操作。"
