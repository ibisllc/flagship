    "Couldn't check for a migration in progress. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar si hay una migración en curso. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier s’il y a une migration en cours. Vérifiez votre connexion et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte nicht geprüft werden, ob eine Migration läuft. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar se há uma migração em andamento. Verifique sua conexão e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中の移行を確認できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查是否有进行中的迁移。请检查网络连接后重试。"
          }
        }
      }
    },
    "Couldn't read this server's current key from the directory — is it online? It must be reachable to migrate.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer del directorio la clave actual de este servidor. ¿Está en línea? Debe estar accesible para migrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la clé actuelle de ce serveur dans l’annuaire — est-il en ligne ? Il doit être joignable pour migrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Schlüssel dieses Servers konnte nicht aus dem Verzeichnis gelesen werden – ist er online? Er muss erreichbar sein, um zu migrieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler do diretório a chave atual deste servidor — ele está online? Precisa estar acessível para migrar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーの現在のキーをディレクトリから読み取れませんでした。オンラインですか？移行するには接続できる必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从目录中读取此服务器当前的密钥：它在线吗？迁移时必须能够访问它。"
          }
        }
      }
    },
