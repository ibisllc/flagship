    "Scan the builder's QR (or type its code) and the recipe is sent over a secure live link. Easiest if the builder is open in front of you.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el QR del creador (o escribe su código) y la receta se envía por un enlace seguro en vivo. Lo más fácil si tienes el creador abierto delante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le QR du créateur (ou saisissez son code) et la recette est envoyée via un lien sécurisé en direct. Le plus simple si le créateur est ouvert devant vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den QR-Code des Builders (oder tippe seinen Code ein), und das Rezept wird über eine sichere Live-Verbindung gesendet. Am einfachsten, wenn der Builder vor dir geöffnet ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o QR do criador (ou digite o código dele) e a receita é enviada por um link seguro ao vivo. Mais fácil se o criador estiver aberto na sua frente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルダーの QR をスキャンする（またはコードを入力する）と、レシピが安全なライブ接続で送信されます。ビルダーが目の前で開いている場合に最も簡単です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描构建器的二维码（或输入其代码），配方会通过安全的实时链接发送。如果构建器就开在你面前，这是最简单的方式。"
          }
        }
      }
    },
    "Save / share recipe file": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar o compartir el archivo de la receta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer / partager le fichier de recette"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezeptdatei speichern / teilen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar / compartilhar o arquivo da receita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピファイルを保存／共有"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存/分享配方文件"
          }
        }
      }
    },
    "Save the recipe as a file or send it (AirDrop, Messages, Mail). Whoever builds the server opens it in the builder. No secrets in the file.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la receta como archivo o envíala (AirDrop, Mensajes, Mail). Quien construya el servidor la abre en el creador. El archivo no contiene secretos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez la recette dans un fichier ou envoyez-la (AirDrop, Messages, Mail). La personne qui construit le serveur l’ouvre dans le créateur. Aucun secret dans le fichier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere das Rezept als Datei oder sende es (AirDrop, Nachrichten, Mail). Wer den Server baut, öffnet es im Builder. Die Datei enthält keine Geheimnisse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve a receita como arquivo ou envie-a (AirDrop, Mensagens, Mail). Quem construir o servidor a abre no criador. Nenhum segredo no arquivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピをファイルとして保存するか、送信してください（AirDrop、メッセージ、メール）。サーバーを構築する人がビルダーで開きます。ファイルにシークレットは含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把配方保存为文件或发送出去（AirDrop、信息、邮件）。构建服务器的人在构建器中打开它。文件中不含密钥。"
          }
        }
      }
    },
