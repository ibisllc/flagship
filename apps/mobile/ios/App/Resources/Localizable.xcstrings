    "Delete %@?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ löschen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %@？"
          }
        }
      }
    },
    "Deletes %@ for good. If the server is online it erases its data and powers off; if it's offline it can never come back online. The name becomes free to reuse.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina %@ para siempre. Si el servidor está en línea, borra sus datos y se apaga; si está sin conexión, no podrá volver a conectarse nunca. El nombre queda libre para reutilizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement %@. Si le serveur est en ligne, il efface ses données et s’éteint ; s’il est hors ligne, il ne pourra jamais revenir en ligne. Le nom redevient libre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht %@ endgültig. Ist der Server online, löscht er seine Daten und schaltet sich aus; ist er offline, kann er nie wieder online gehen. Der Name wird zur Wiederverwendung frei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui %@ de vez. Se o servidor estiver online, apaga os dados e desliga; se estiver offline, nunca mais poderá ficar online. O nome fica livre para reutilização."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を完全に削除します。サーバーがオンラインの場合はデータを消去して電源を切り、オフラインの場合は二度とオンラインに戻れません。名前は再利用できるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除 %@。如果服务器在线，它会擦除其数据并关机；如果离线，它将永远无法再上线。该名称随即可被重新使用。"
          }
        }
      }
    },
    "Type %@ to confirm": {
      "extractionState": "manual",
      "localizations": {
