          }
        }
      }
    },
    "If a device might be lost or stolen, rotate your admin key. It becomes the only admin key; every other device loses admin until it recovers.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un dispositivo puede haberse perdido o robado, rota tu clave de administrador. Pasa a ser la única clave de administrador; todos los demás dispositivos pierden el rol de administrador hasta que pasen por una recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un appareil a pu être perdu ou volé, renouvelez votre clé d’administrateur. Elle devient la seule clé d’administrateur ; tous les autres appareils perdent le rôle d’administrateur jusqu’à ce qu’ils passent par une récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Gerät verloren gegangen oder gestohlen sein könnte, rotiere deinen Admin-Schlüssel. Er wird zum einzigen Admin-Schlüssel; alle anderen Geräte verlieren die Admin-Rechte, bis sie eine Wiederherstellung durchlaufen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um dispositivo puder ter sido perdido ou roubado, gire sua chave de administrador. Ela passa a ser a única chave de administrador; todos os outros dispositivos perdem o papel de administrador até passarem por uma recuperação."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの紛失や盗難の可能性がある場合は、管理者キーをローテーションしてください。それが唯一の管理者キーになり、他のすべてのデバイスは復旧するまで管理者権限を失います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果设备可能丢失或被盗，请轮换你的管理员密钥。它将成为唯一的管理员密钥；其他所有设备在恢复前都会失去管理员权限。"
          }
        }
      }
    },
    "Admin key rotated. Other devices must recover to regain admin.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave de administrador rotada. Los demás dispositivos deben pasar por una recuperación para volver a ser administradores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé d’administrateur renouvelée. Les autres appareils doivent passer par une récupération pour retrouver le rôle d’administrateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Admin-Schlüssel rotiert. Andere Geräte brauchen eine Wiederherstellung, um wieder Admin zu sein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chave de administrador girada. Os outros dispositivos precisam passar por uma recuperação para voltar a ser administradores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者キーをローテーションしました。他のデバイスは、管理者権限を取り戻すには復旧する必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理员密钥已轮换。其他设备必须恢复才能重新获得管理员权限。"
          }
        }
      }
    },
    "Your recovery backup still holds your old admin key. Re-run recovery setup to fix this.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu copia de seguridad de recuperación aún contiene tu clave de administrador anterior. Vuelve a ejecutar la configuración de recuperación para corregirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre sauvegarde de récupération contient encore votre ancienne clé d’administrateur. Relancez la configuration de la récupération pour corriger cela."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wiederherstellungs-Backup enthält noch deinen alten Admin-Schlüssel. Führe die Wiederherstellungs-Einrichtung erneut aus, um das zu beheben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu backup de recuperação ainda contém sua chave de administrador antiga. Execute a configuração de recuperação de novo para corrigir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーバックアップには、まだ古い管理者キーが入っています。リカバリーの設定をやり直して修正してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的恢复备份仍保存着旧的管理员密钥。请重新运行恢复设置来修复。"
          }
        }
      }
    },
    "Rotating…": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotando…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvellement…"
          }
        },
        "de": {
