    "Enter your recovery code or the 6-digit code from your authenticator app.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu código de recuperación o el código de 6 dígitos de tu app de autenticación."
