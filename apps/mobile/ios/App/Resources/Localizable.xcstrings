    "Anyone with this key can read everything on this server while it's on. It turns off by itself 7 days from now.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera con esta clave puede leer todo lo que hay en este servidor mientras está encendida. Se apaga sola dentro de 7 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne disposant de cette clé peut lire tout ce qui se trouve sur ce serveur tant qu’elle est active. Elle s’éteint toute seule dans 7 jours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder mit diesem Schlüssel kann alles auf diesem Server lesen, solange er an ist. Er schaltet sich in 7 Tagen von selbst aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa com esta chave pode ler tudo neste servidor enquanto ela estiver ativa. Ela se desativa sozinha em 7 dias."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーを持つ人は、有効な間、このサーバー上のすべてを読み取れます。7 日後に自動的にオフになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拥有此密钥的人，在其开启期间都能读取此服务器上的所有内容。它会在 7 天后自动关闭。"
          }
        }
      }
    },
    "This server couldn't be prepared to receive the backup. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar este servidor para recibir la copia de seguridad. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n’a pas pu être préparé pour recevoir la sauvegarde. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server konnte nicht darauf vorbereitet werden, das Backup zu empfangen. Versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preparar este servidor para receber o backup. Tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーをバックアップを受け取れる状態にできませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法让此服务器准备好接收备份。请重试。"
          }
        }
      }
    },
