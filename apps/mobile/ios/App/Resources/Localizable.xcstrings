            "state": "translated",
            "value": "O que deve mudar?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を変更しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要改什么？"
          }
        }
      }
    },
    "For example: \"Add a due date to each item and sort by it.\"": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo: «Añade una fecha límite a cada elemento y ordénalos por ella»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple : « Ajoute une date d’échéance à chaque élément et trie par cette date. »"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel: „Füge jedem Eintrag ein Fälligkeitsdatum hinzu und sortiere danach.“"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por exemplo: “Adicione uma data de vencimento a cada item e ordene por ela.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：「各項目に期限日を追加し、その順に並べ替えて」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：“给每个条目加一个截止日期，并按它排序。”"
          }
        }
      }
    },
