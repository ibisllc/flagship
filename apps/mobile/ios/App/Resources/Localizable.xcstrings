    "One Face ID approves about a year of backups. The server can seal new backups with them, never open old ones.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo Face ID aprueba alrededor de un año de copias de seguridad. Con esa aprobación, el servidor puede sellar copias nuevas, pero nunca abrir las antiguas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul Face ID approuve environ un an de sauvegardes. Grâce à cette approbation, le serveur peut sceller de nouvelles sauvegardes, mais jamais ouvrir les anciennes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Face ID genehmigt etwa ein Jahr an Backups. Der Server kann damit neue Backups versiegeln, aber nie alte öffnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Face ID aprova cerca de um ano de backups. Com essa aprovação, o servidor pode selar backups novos, mas nunca abrir os antigos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID を 1 回使うと、約 1 年分のバックアップを承認できます。サーバーはそれで新しいバックアップを封印できますが、古いものを開くことはできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次 Face ID 即可批准约一年的备份。服务器可以用它们密封新备份，但永远无法打开旧备份。"
          }
        }
      }
    },
