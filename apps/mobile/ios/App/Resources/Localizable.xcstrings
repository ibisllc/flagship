      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado corta. Al menos 12 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop court. Au moins 12 caractères."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu kurz. Mindestens 12 Zeichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Curta demais. Pelo menos 12 caracteres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短すぎます。12 文字以上にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太短。至少 12 个字符。"
          }
        }
      }
    },
