            "state": "translated",
            "value": "Le serveur a refusé la dernière mise à jour : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat das letzte Update abgelehnt: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou a última atualização: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーは直近のアップデートを拒否しました：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了最近一次更新：%@"
          }
        }
      }
    },
