    "This backup was made by a newer version of Flagship. Update the app and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad la hizo una versión más reciente de Flagship. Actualiza la app e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été faite par une version plus récente de Flagship. Mettez l’app à jour et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup wurde von einer neueren Flagship-Version erstellt. Aktualisiere die App und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup foi feito por uma versão mais nova do Flagship. Atualize o app e tente de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは、より新しいバージョンの Flagship で作成されました。アプリを更新してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份由更新版本的 Flagship 创建。请更新应用后重试。"
          }
        }
      }
    },
