{
  "description": "Which relay addresses a phone keeps from GET /api/services/endpoints (docs/relay-addresses.md). Read by the Android and iOS tests; the rule is phone-only, so it lives outside the protocol vectors.",
  "endpoints": [
    {
      "name": "the prod answer",
      "body": {
        "version": 1,
        "passthroughIPv4": "149.248.216.86",
        "passthroughIPv6": "2a09:8280:1::110:d2b6:0"
      },
      "expect": [
        "149.248.216.86",
        "2a09:8280:1::110:d2b6:0"
      ]
    },
    {
      "name": "ipv4 only",
      "body": {
        "passthroughIPv4": "203.0.113.7",
        "passthroughIPv6": null
      },
      "expect": [
        "203.0.113.7"
      ]
    },
    {
      "name": "ipv6 only",
      "body": {
        "passthroughIPv6": "2001:db8::7"
      },
      "expect": [
        "2001:db8::7"
      ]
    },
    {
      "name": "nothing recommended",
      "body": {
        "passthroughIPv4": null,
        "passthroughIPv6": null
      },
      "expect": []
    },
    {
      "name": "a hostname is never looked up",
      "body": {
        "passthroughIPv4": "relay.example.com",
        "passthroughIPv6": "example.com"
      },
      "expect": []
    },
    {
      "name": "the local network is refused",
      "body": {
        "passthroughIPv4": "192.168.1.2",
        "passthroughIPv6": "fd00::1"
      },
      "expect": []
    },
    {
      "name": "loopback and link-local are refused",
      "body": {
        "passthroughIPv4": "127.0.0.1",
        "passthroughIPv6": "fe80::1"
      },
      "expect": []
    },
    {
      "name": "shared (CGNAT) space is refused",
      "body": {
        "passthroughIPv4": "100.64.0.1"
      },
      "expect": []
    },
    {
      "name": "the reserved top of the v4 space is refused",
      "body": {
        "passthroughIPv4": "240.0.0.1"
      },
      "expect": []
    },
    {
      "name": "multicast is refused",
      "body": {
        "passthroughIPv4": "224.0.0.1",
        "passthroughIPv6": "ff02::1"
      },
      "expect": []
    },
    {
      "name": "one good one bad",
      "body": {
        "passthroughIPv4": "10.0.0.7",
        "passthroughIPv6": "2001:db8::7"
      },
      "expect": [
        "2001:db8::7"
      ]
    },
    {
      "name": "not strings",
      "body": {
        "passthroughIPv4": 7,
        "passthroughIPv6": [
          "2001:db8::7"
        ]
      },
      "expect": []
    }
  ],
  "notJson": [
    "not json {",
    "[]",
    "\"x\"",
    ""
  ],
  "candidatesAbout": "The relay mesh (docs/architecture-v2/relay-mesh.md §2) adds `relays: [{relayId, tunnelHost, ipv4, ipv6}]` to the same answer. Candidates are the passthrough pair first (echo checked under flagship-services.fly.dev), then each relay's ipv4 then ipv6 in order (echo checked under its own tunnelHost, which must be exactly <relayId>.tunnel.<apex> with relayId ^[a-z][a-z0-9-]{1,30}$); the same public-unicast rule, the first time an address appears wins, at most 8 in all. Each candidate still has to pass the box's pinned handshake and the echo before it is used. Compare addresses as addresses, not as text.",
  "candidates": [
    {
      "name": "prod with two relays",
      "apex": "flagship.services",
      "body": {
        "passthroughIPv4": "149.248.216.86",
        "passthroughIPv6": "2a09:8280:1::110:d2b6:0",
        "relays": [
          {
            "relayId": "iad1",
            "tunnelHost": "iad1.tunnel.flagship.services",
            "ipv4": [
              "149.248.216.86"
            ],
            "ipv6": [
              "2a09:8280:1::110:d2b6:0"
            ]
          },
          {
            "relayId": "fra1",
            "tunnelHost": "fra1.tunnel.flagship.services",
            "ipv4": [
              "203.0.113.9"
            ],
            "ipv6": [
              "2001:db8::9"
            ]
          }
        ]
      },
      "expect": [
        {
          "address": "149.248.216.86",
          "echoHost": "flagship-services.fly.dev"
        },
        {
          "address": "2a09:8280:1::110:d2b6:0",
          "echoHost": "flagship-services.fly.dev"
        },
        {
          "address": "203.0.113.9",
          "echoHost": "fra1.tunnel.flagship.services"
        },
        {
          "address": "2001:db8::9",
          "echoHost": "fra1.tunnel.flagship.services"
        }
      ]
    },
    {
      "name": "relays only",
      "apex": "flagship.services",
      "body": {
        "passthroughIPv4": null,
        "passthroughIPv6": null,
        "relays": [
          {
            "relayId": "ord1",
            "tunnelHost": "ord1.tunnel.flagship.services",
            "ipv4": [
              "198.51.100.4"
            ],
            "ipv6": []
          }
        ]
      },
      "expect": [
        {
          "address": "198.51.100.4",
          "echoHost": "ord1.tunnel.flagship.services"
        }
      ]
    },
    {
      "name": "a relay whose tunnelHost is not its own name is skipped",
      "apex": "flagship.services",
      "body": {
        "relays": [
          {
            "relayId": "fra1",
            "tunnelHost": "relay.example.com",
            "ipv4": [
              "203.0.113.9"
            ],
            "ipv6": []
          },
          {
            "relayId": "fra2",
            "tunnelHost": "fra1.tunnel.flagship.services",
            "ipv4": [
              "203.0.113.10"
            ],
            "ipv6": []
          },
          {
            "relayId": "ams1",
            "tunnelHost": "ams1.tunnel.flagship.services",
            "ipv4": [
              "203.0.113.11"
            ],
            "ipv6": []
          }
        ]
      },
      "expect": [
        {
          "address": "203.0.113.11",
          "echoHost": "ams1.tunnel.flagship.services"
        }
      ]
    },
    {
      "name": "a bad relay id is skipped",
      "apex": "flagship.services",
      "body": {
        "relays": [
          {
            "relayId": "Fra_1",
            "tunnelHost": "Fra_1.tunnel.flagship.services",
            "ipv4": [
              "203.0.113.9"
            ],
            "ipv6": []
          },
          {
            "relayId": "1fra",
            "tunnelHost": "1fra.tunnel.flagship.services",
            "ipv4": [
              "203.0.113.10"
            ],
            "ipv6": []
          }
        ]
      },
      "expect": []
    },
    {
      "name": "another apex's relay is skipped",
      "apex": "gym.flagship.services",
      "body": {
        "relays": [
          {
            "relayId": "iad1",
            "tunnelHost": "iad1.tunnel.flagship.services",
            "ipv4": [
              "203.0.113.9"
            ],
            "ipv6": []
          },
          {
            "relayId": "gym1",
            "tunnelHost": "gym1.tunnel.gym.flagship.services",
            "ipv4": [
              "203.0.113.12"
            ],
            "ipv6": []
          }
        ]
      },
      "expect": [
        {
          "address": "203.0.113.12",
          "echoHost": "gym1.tunnel.gym.flagship.services"
        }
      ]
    },
    {
      "name": "local, shared and hostname entries in a relay are dropped",
      "apex": "flagship.services",
      "body": {
        "relays": [
          {
            "relayId": "fra1",
            "tunnelHost": "fra1.tunnel.flagship.services",
            "ipv4": [
              "10.0.0.1",
              "100.64.0.1",
              "relay.example.com",
              "198.51.100.4"
            ],
            "ipv6": [
              "fd00::1",
              "fe80::1",
              "2001:db8::4"
            ]
          }
        ]
      },
      "expect": [
        {
          "address": "198.51.100.4",
          "echoHost": "fra1.tunnel.flagship.services"
        },
        {
          "address": "2001:db8::4",
          "echoHost": "fra1.tunnel.flagship.services"
        }
      ]
    },
    {
      "name": "at most 8 in all",
      "apex": "flagship.services",
      "body": {
        "passthroughIPv4": "149.248.216.86",
        "passthroughIPv6": "2a09:8280:1::110:d2b6:0",
        "relays": [
          {
            "relayId": "fra1",
            "tunnelHost": "fra1.tunnel.flagship.services",
            "ipv4": [
              "203.0.113.1",
              "203.0.113.2",
              "203.0.113.3",
              "203.0.113.4",
              "203.0.113.5",
              "203.0.113.6",
              "203.0.113.7",
              "203.0.113.8",
              "203.0.113.9",
              "203.0.113.10"
            ],
            "ipv6": []
          }
        ]
      },
      "expect": [
        {
          "address": "149.248.216.86",
          "echoHost": "flagship-services.fly.dev"
        },
        {
          "address": "2a09:8280:1::110:d2b6:0",
          "echoHost": "flagship-services.fly.dev"
        },
        {
          "address": "203.0.113.1",
          "echoHost": "fra1.tunnel.flagship.services"
        },
        {
          "address": "203.0.113.2",
          "echoHost": "fra1.tunnel.flagship.services"
        },
        {
          "address": "203.0.113.3",
          "echoHost": "fra1.tunnel.flagship.services"
        },
        {
          "address": "203.0.113.4",
          "echoHost": "fra1.tunnel.flagship.services"
        },
        {
          "address": "203.0.113.5",
          "echoHost": "fra1.tunnel.flagship.services"
        },
        {
          "address": "203.0.113.6",
          "echoHost": "fra1.tunnel.flagship.services"
        }
      ]
    },
    {
      "name": "malformed relays are ignored",
      "apex": "flagship.services",
      "body": {
        "passthroughIPv4": "149.248.216.86",
        "relays": "iad1"
      },
      "expect": [
        {
          "address": "149.248.216.86",
          "echoHost": "flagship-services.fly.dev"
        }
      ]
    },
    {
      "name": "malformed entries are ignored",
      "apex": "flagship.services",
      "body": {
        "relays": [
          7,
          null,
          {
            "relayId": "fra1",
            "tunnelHost": "fra1.tunnel.flagship.services",
            "ipv4": "203.0.113.9",
            "ipv6": [
              7
            ]
          },
          {
            "relayId": "ams1",
            "tunnelHost": "ams1.tunnel.flagship.services",
            "ipv4": [
              "203.0.113.11",
              5
            ]
          }
        ]
      },
      "expect": [
        {
          "address": "203.0.113.11",
          "echoHost": "ams1.tunnel.flagship.services"
        }
      ]
    }
  ]
}
