{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Flagship",
  "description": "__MSG_extDescription__",
  "version": "0.4.0",
  "default_locale": "en",
  "homepage_url": "https://flagshipserver.com/",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-extension@flagshipserver.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["webRequest", "webRequestBlocking", "storage"],
  "host_permissions": ["*://*.flagship.services/*", "*://*.fshp.app/*"],
  "background": { "scripts": ["src/background.js"], "type": "module" },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/flagship.svg",
    "default_title": "__MSG_extName__"
  },
  "icons": { "48": "icons/flagship.svg", "96": "icons/flagship.svg" },
  "content_scripts": [
    {
      "matches": ["https://*.flagship.services/*", "https://*.fshp.app/*"],
      "js": ["src/lib/knockDetect.js", "src/content/knock.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://*.flagship.services https://*.fshp.app wss://flagshipserver.com"
  }
}
