<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Tests target plain net8.0 (no WPF) so they can be exercised on
         macOS/Linux CI runners that don't have the Windows desktop
         workload. The non-test project (FlagshipBurner.csproj) is
         net8.0-windows + WPF; the test project explicitly references
         the source files we want to cover without dragging in the WPF
         dependency tree. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Flagship.Burner.Tests</RootNamespace>
    <AssemblyName>FlagshipBurner.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- DiskWrite.cs (compiled in below for its pure parsers) uses byte* -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pull in the platform-agnostic source files we want to test.
         Skip Wizard.cs / MainWindow.* / App.* because they depend on
         WPF. The disk enumerator + verify-result parser + CLI locator
         + CLI args + the recipe verify (recipe/ed25519) are all WPF-free.
         DiskWrite.cs is [SupportedOSPlatform("windows")] but its parsers
         + pre-open guards run on any host. -->
    <Compile Include="..\src\DiskEnumerator.cs"/>
    <Compile Include="..\src\VerifyResult.cs"/>
    <Compile Include="..\src\CliLocator.cs"/>
    <Compile Include="..\src\CliRunner.cs"/>
    <Compile Include="..\src\Recipe.cs"/>
    <Compile Include="..\src\Ed25519Verify.cs"/>
    <Compile Include="..\src\DiskWrite.cs"/>
    <!-- Manifest client + manifest-driven base-ISO cache are WPF-free. -->
    <Compile Include="..\src\IsoManifestClient.cs"/>
    <Compile Include="..\src\IsoBaseCache.cs"/>
    <!-- The pure VM core (mirrors apps/burner-mac FlagshipBurnerCore/VM) is
         WPF-free by design; pinned against the shared golden vectors. -->
    <Compile Include="..\src\VM\HostResources.cs"/>
    <Compile Include="..\src\VM\VMResourcePlan.cs"/>
    <Compile Include="..\src\VM\ServerTier.cs"/>
    <Compile Include="..\src\VM\RecipeSiblings.cs"/>
    <Compile Include="..\src\VM\VMConfig.cs"/>
    <Compile Include="..\src\VM\VMLifecycle.cs"/>
    <Compile Include="..\src\VM\VMInventoryStore.cs"/>
    <!-- CliArgs lives in Wizard.cs alongside the view-model; we extract
         it into a tiny shim for the test target to keep WPF out. -->
    <Compile Include="CliArgsShim.cs"/>
    <Compile Include="DiskEnumeratorTests.cs"/>
    <Compile Include="VerifyResultTests.cs"/>
    <Compile Include="CliLocatorTests.cs"/>
    <Compile Include="CliArgsTests.cs"/>
    <Compile Include="WizardStateMachineTests.cs"/>
    <Compile Include="Ed25519VerifyTests.cs"/>
    <Compile Include="RecipeTests.cs"/>
    <Compile Include="DiskWriteTests.cs"/>
    <Compile Include="IsoManifestClientTests.cs"/>
    <Compile Include="IsoBaseCacheTests.cs"/>
    <Compile Include="VMLifecycleTests.cs"/>
    <Compile Include="VMResourcePlanTests.cs"/>
    <Compile Include="VMConfigTests.cs"/>
    <Compile Include="VMInventoryStoreTests.cs"/>
    <Compile Include="RecipeSiblingsTests.cs"/>
    <Compile Include="VMCoreVectorTests.cs"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The shared VM-core contract (apps/desktop-shared/golden) — the Mac
         suite must consume the SAME file so the two cores cannot drift. -->
    <Content Include="..\..\desktop-shared\golden\vm-core-vectors.json"
             Link="Resources\vm-core-vectors.json"
             CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0"/>
    <PackageReference Include="xunit" Version="2.9.0"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"/>
  </ItemGroup>

</Project>
