<Window x:Class="Flagship.Burner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Flagship.Burner"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Flagship Burner"
        Width="540" Height="640"
        MinWidth="500" MinHeight="560"
        MaxWidth="780"
        Background="{StaticResource FB.Bg}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FB.Font.Body}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Inline converters live here in stable callable form rather than
             requiring a separate file. -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:NullToVisibilityConverter x:Key="NullToCollapsed"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisible"/>
        <local:StreamToBrushConverter x:Key="StreamToBrush"/>
        <local:ModeToggleLabelConverter x:Key="ModeToggleLabel"/>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- content -->
            <RowDefinition Height="Auto"/>   <!-- log drawer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="22,18,22,8">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Style="{StaticResource IconCircle}"
                        Background="{StaticResource FB.PrimaryFaded}">
                    <TextBlock Text="&#x1F525;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"/>
                </Border>
                <TextBlock Text="Flagship Burner"
                           FontFamily="{StaticResource FB.Font.Title}"
                           FontSize="18"
                           Foreground="{StaticResource FB.Text}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </StackPanel>
            <!-- Mode switch: names the mode a click switches TO (Simple⇄Advanced). -->
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource LinkButton}"
                    Content="{Binding Mode, Converter={StaticResource ModeToggleLabel}}"
                    Click="ModeToggle_Click"/>
        </Grid>

        <!-- Three drop-rows + bake button -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0">
            <StackPanel Margin="22,4,22,12">

                <!-- Row 1: Recipe -->
                <Border x:Name="RecipeRow"
                        Style="{StaticResource DropRowBorder}"
                        Tag="{Binding RecipeRowTag}"
                        DragEnter="RecipeRow_DragEnter"
                        DragOver="RecipeRow_DragOver"
                        DragLeave="RecipeRow_DragLeave"
                        Drop="RecipeRow_Drop"
                        MouseLeftButtonUp="RecipeRow_Click"
                        Cursor="Hand"
                        Margin="0,4,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource IconCircle}"
                                Background="{Binding RecipeIconBg}">
                            <TextBlock Text="&#x1F4C4;" FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Recipe"/>
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="{Binding RecipeHint}"
                                       Visibility="{Binding HasRecipePrimary,
                                           Converter={StaticResource BoolToVisibility},
                                           ConverterParameter=invert}"/>
                            <TextBlock Style="{StaticResource RowValue}"
                                       Text="{Binding RecipePrimary}"
                                       Visibility="{Binding HasRecipePrimary,
                                           Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding RecipeSecondary}"
                                       Visibility="{Binding RecipeSecondary,
                                           Converter={StaticResource NotNullToVisible}}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RecipeStatusGlyph}"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RecipeStatusBrush}"/>
                    </Grid>
                </Border>

                <!-- Row 2: ISO — the user supplies a stock Debian/Ubuntu ISO,
                     which the burner remasters with the recipe preseed. -->
                <Border x:Name="IsoRow"
                        Style="{StaticResource DropRowBorder}"
                        Tag="{Binding IsoRowTag}"
                        DragEnter="IsoRow_DragEnter"
                        DragOver="IsoRow_DragOver"
                        DragLeave="IsoRow_DragLeave"
                        Drop="IsoRow_Drop"
                        MouseLeftButtonUp="IsoRow_Click"
                        Cursor="Hand"
                        Margin="0,4,0,8"
                        Visibility="{Binding ShowIsoRow,
                            Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource IconCircle}"
                                Background="{Binding IsoIconBg}">
                            <TextBlock Text="&#x1F4BF;" FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}"
                                       Text="Ubuntu Server ISO"/>
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="Drop ubuntu-22.04.5-live-server-amd64.iso"
                                       Visibility="{Binding HasIso,
                                           Converter={StaticResource BoolToVisibility},
                                           ConverterParameter=invert}"/>
                            <TextBlock Style="{StaticResource RowValue}"
                                       Text="{Binding IsoFileName}"
                                       Visibility="{Binding HasIso,
                                           Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding IsoStatusGlyph}"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding IsoStatusBrush}"/>
                    </Grid>
                </Border>

                <!-- Row 3: USB Drive -->
                <Border x:Name="DiskRow"
                        Style="{StaticResource DropRowBorder}"
                        Tag="{Binding DiskRowTag}"
                        AllowDrop="False"
                        Margin="0,4,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource IconCircle}"
                                Background="{Binding DiskIconBg}">
                            <TextBlock Text="&#x1F4BE;" FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="USB Drive"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          x:Name="DiskCombo"
                                          ItemsSource="{Binding Disks}"
                                          SelectedItem="{Binding SelectedDisk, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding HasDisks}"
                                          Margin="0,2,0,0"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource LinkButton}"
                                        Content="Refresh"
                                        Margin="8,0,0,0"
                                        Click="RefreshDisks_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="No removable drives detected. Plug one in and click Refresh."
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasDisks,
                                           Converter={StaticResource BoolToVisibility},
                                           ConverterParameter=invert}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DiskStatusGlyph}"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding DiskStatusBrush}"/>
                    </Grid>
                </Border>

                <!-- Bake button -->
                <StackPanel Margin="0,18,0,12" HorizontalAlignment="Center">
                    <Button x:Name="BakeButton"
                            Style="{StaticResource BakeButton}"
                            Content="{Binding BakeButtonLabel}"
                            IsEnabled="{Binding CanBake}"
                            Click="Bake_Click"
                            Visibility="{Binding ShowProgress,
                                Converter={StaticResource BoolToVisibility},
                                ConverterParameter=invert}"/>
                    <TextBlock Style="{StaticResource Caption}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Text="{Binding ReadinessSummary}"
                               TextWrapping="Wrap"
                               MaxWidth="380"
                               TextAlignment="Center"
                               Visibility="{Binding ShowReadiness,
                                   Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Progress block — the remaster runs indeterminate, then
                         the write fills in. ProgressTint sets the Foreground. -->
                    <StackPanel HorizontalAlignment="Center"
                                Visibility="{Binding ShowProgress,
                                    Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar x:Name="PhaseProgress"
                                     Width="260" Height="6"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding ProgressIndeterminate}"
                                     Foreground="{Binding ProgressTint}"
                                     Background="{StaticResource FB.SurfaceElevated}"
                                     BorderThickness="0"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   Text="{Binding ProgressCaption}"/>
                        <!-- The base-image URL being fetched, surfaced directly
                             under the bar during the download phase only. -->
                        <TextBlock Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"
                                   MaxWidth="380"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontFamily="{StaticResource FB.Font.Mono}"
                                   Text="{Binding DownloadUrlCaption}"
                                   Visibility="{Binding ShowDownloadRow,
                                       Converter={StaticResource BoolToVisibility}}"/>
                        <Button Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0"
                                Content="Cancel"
                                Click="Bake_Click"/>
                    </StackPanel>

                    <!-- Done card -->
                    <Border BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,12,0,0"
                            BorderBrush="{StaticResource FB.Success}"
                            Background="{StaticResource FB.SuccessFaded}"
                            Visibility="{Binding IsFinished,
                                Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2713;"
                                           FontSize="15"
                                           Foreground="{StaticResource FB.Success}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Ready to boot"
                                           Style="{StaticResource RowTitle}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DoneServerDomain}"
                                       FontFamily="{StaticResource FB.Font.Mono}"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding DoneServerDomain,
                                           Converter={StaticResource NotNullToVisible}}"/>
                            <TextBlock Text="{Binding DoneOutputPath}"
                                       FontFamily="{StaticResource FB.Font.Mono}"
                                       Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding DoneOutputPath,
                                           Converter={StaticResource NotNullToVisible}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Log drawer -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource FB.Border}"
                Background="{StaticResource FB.Bg}">
            <StackPanel>
                <Grid Margin="22,8,22,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0"
                                  x:Name="LogToggle"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  Padding="0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                    <TextBlock x:Name="Arrow" Text="&#x25B7;"
                                               Foreground="{StaticResource FB.TextMuted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Arrow" Property="Text" Value="&#x25BD;"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <TextBlock>
                            <Run Text="Log"
                                 Foreground="{DynamicResource FB.TextMuted}"
                                 FontSize="11.5"/>
                            <Run Text="{Binding LogCountLabel, Mode=OneWay}"
                                 Foreground="{DynamicResource FB.TextMuted}"
                                 FontFamily="{DynamicResource FB.Font.Mono}"
                                 FontSize="11.5"/>
                        </TextBlock>
                    </ToggleButton>
                    <Button Grid.Column="2"
                            Style="{StaticResource LinkButton}"
                            Content="Clear"
                            Click="ClearLog_Click"
                            Visibility="{Binding HasLogLines,
                                Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <Border Margin="22,0,22,12"
                        BorderThickness="1"
                        BorderBrush="{StaticResource FB.Border}"
                        CornerRadius="6"
                        Background="{StaticResource FB.SurfaceElevated}"
                        Visibility="{Binding ElementName=LogToggle,
                                             Path=IsChecked,
                                             Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer x:Name="LogScroller"
                                  Height="180"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               FontFamily="{StaticResource FB.Font.Mono}"
                                               FontSize="11.5"
                                               Foreground="{Binding Stream,
                                                   Converter={StaticResource StreamToBrush}}"
                                               TextWrapping="Wrap"
                                               Margin="10,1,10,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
