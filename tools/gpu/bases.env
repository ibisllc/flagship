# The base images of the GPU check workloads, pinned by digest (verified against the registries 2026-10-30).
# Sourced by tools/arch-drills/m7/gpu-real.sh; an exported variable of the same name wins.
#
# CUDA 12.4, not 13: the box runs Debian 13's own `nvidia-driver`, which is 550.163.01 (trixie and trixie-backports),
# and that driver serves CUDA up to 12.4. A CUDA 13 image fails there with "driver version is insufficient". Move these
# together with the driver (NVIDIA's own 580+ driver, or a newer Debian one), and record both in the receipt.
#
# Each digest is the multi-architecture index; podman picks the host's architecture from it.
: "${CUDA_DEVEL_BASE:=docker.io/nvidia/cuda@sha256:da6791294b0b04d7e65d87b7451d6f2390b4d36225ab0701ee7dfec5769829f5}"   # 12.4.1-devel-ubuntu22.04
: "${CUDA_RUNTIME_BASE:=docker.io/nvidia/cuda@sha256:517da2300c184c9999ec203c2665244bdebd3578d12fcc7065e83667932643d9}"  # 12.4.1-runtime-ubuntu22.04
: "${TORCH_BASE:=docker.io/pytorch/pytorch@sha256:77f17f843507062875ce8be2a6f76aa6aa3df7f9ef1e31d9d7432f4b0f563dee}"     # 2.6.0-cuda12.4-cudnn9-runtime
: "${RENDER_BASE:=docker.io/debian@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4}"            # trixie-slim
: "${FFMPEG_NVIDIA_BASE:=docker.io/jrottenberg/ffmpeg@sha256:8e0a39c3dda9f32f0bae589fb2d762b66656a290063d890e4360c0e1ded86fc9}"  # 7.1-nvidia2204
export CUDA_DEVEL_BASE CUDA_RUNTIME_BASE TORCH_BASE RENDER_BASE FFMPEG_NVIDIA_BASE
