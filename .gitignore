node_modules/
dist/
build/
!apps/web/public/build/
.next/
coverage/
*.log
.DS_Store
.env
.env.local
.env.*.local
.turbo/
.cache/
*.tsbuildinfo

# tsc -b emits .js next to .ts when no outDir is set; we never check those in
apps/com/src/**/*.js
apps/com/test/**/*.js

# mobile
apps/mobile/ios/.build/
apps/mobile/ios/.swiftpm/
apps/mobile/ios/DerivedData/
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/local.properties
apps/mobile/android/app/build/

# bootkey artifacts (large, regenerable)
build-artifacts/
build-out/
*.img
*.iso

# fixtures contain SECRETS — never commit
test-vectors/fixture.json

# Playwright e2e artifacts
apps/web/e2e/test-results/
apps/web/e2e/playwright-report/
test-results/

# Wrangler local-dev state (D1, R2, KV emulation)
**/.wrangler/

# Local IDE / agent settings — personal to each contributor
.claude/

# /maintainers/ is NOT vendored — it's pulled at build time from
# github.com/ibisllc/maintainers at the SHA pinned in
# scripts/maintainers.pinned-sha. The pull is wired through
# scripts/pull-maintainers.sh (npm preinstall + Dockerfile + CI).
# See docs/maintainers-deployment.md for the rationale. The leading
# slash anchors this to the repo root so other directories named
# `maintainers/` (notably apps/web/public/maintainers/ for the
# hosted UI) are NOT affected.
/maintainers/

# The maintainers web-ui bundle is emitted by pull-maintainers.sh into
# apps/web/public/maintainers/lib/ alongside the host HTML (which IS
# checked in). The bundle is regenerated on every build — tracking it
# would just churn the diff.
apps/web/public/maintainers/lib/
