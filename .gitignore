# vps-e2e local SSH key (generated by `tools/vps-e2e/src/cli.ts` on first run;
# uploaded to Hetzner as a named SSH key). Never commit the private half.
.demo-ssh-key
.demo-ssh-key.pub
.next/
coverage/
*.log
.DS_Store
.env
.env.local
.env.*.local
.turbo/
.cache/
*.tsbuildinfo

# tsc -b emits .js next to .ts when no outDir is set; we never check those in
apps/com/src/**/*.js
apps/com/test/**/*.js

# mobile
apps/mobile/ios/.build/
apps/mobile/ios/.swiftpm/
apps/mobile/ios/DerivedData/
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/local.properties
apps/mobile/android/app/build/

# bootkey artifacts (large, regenerable)
build-artifacts/
build-out/
*.img
*.iso

# fixtures contain SECRETS — never commit
test-vectors/fixture.json

# Playwright e2e artifacts
apps/web/e2e/test-results/
apps/web/e2e/playwright-report/
test-results/

# Wrangler local-dev state (D1, R2, KV emulation)
**/.wrangler/

# Local IDE / agent settings — personal to each contributor
.claude/

# The maintainers protocol is consumed as the published npm package
# `@ibisllc/maintainers` (see packages/server-daemon/package.json — exact
# pin). It is NOT vendored. A standalone clone may still exist at the repo
# root from older workflows or for local protocol-repo work; keep it
# untracked (the leading slash anchors this to the repo root). The former
# hosted `flagshipserver.com/maintainers/` web-ui surface was removed —
# adopters expose `.maintainers/` via their own git host's GET, public
# transparency is the checkpoints repo, and operators use the CLI.
/maintainers/
out/
apps/burner-mac/.build/
__pycache__/
